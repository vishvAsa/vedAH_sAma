    <item>
      <title>०१</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/5_aindrapAThaH/03_R-8_sA-10/01/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/5_aindrapAThaH/03_R-8_sA-10/01/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - वसुश्रुत अत्रेयः अग्निः पङ्क्त्तिः&lt;/summary&gt;&#xA;&lt;p&gt;आ॒तेअग्नेइधीमही॒ । घूमन्तं॑देवाआज॒रं॑ । यद्धस्या॒तेपानी॑यसी । सामी॒द्दीदया॑तिद्याविईळंस्तोतृ॒भ्यआ॒भारा ॥ १ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - इन्द्रस्यसञ्चयेद्वे सेनुदेवा वामदेव्येवा ॥ द्वयोरिन्द्रः पंक्तिरग्निः ॥&lt;/summary&gt;&#xA;&lt;p&gt;आ+++(प)+++तेअग्नइधीमा+++(प्लू)+++हा+++(ङ)+++इ+++(श)+++। द्यूमन्तन्दे+++(तीच्)+++वा+++(क)+++आ+++(ट)+++ज+++(च)+++रामा+++(ता)+++। यद्ध्यास्या+++(भि)+++ता+++(त)+++इ+++(श)+++पानी+++(का)+++या+++(ख)+++सी+++(ण)+++। सामीद्दिद+++(की)+++यता+++(टा)+++इद्या+++(चा)+++विया+++(ता)+++। ईषंस्तो+++(टि)+++तृ+++(त)+++। भ्या+++(प)+++या+++(श)+++भा+++(ख)+++रो+++(प्ल)+++। हाइ+++(शा)+++ ॥ १ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - इन्द्रस्यसञ्चयेद्वे सेनुदेवा वामदेव्येवा ॥ द्वयोरिन्द्रः पंक्तिरग्निः ॥&lt;/summary&gt;&#xA;&lt;p&gt;आतेअग्नइधी+++(फू)+++माहा+++(खा)+++इद्युमन्ता+++(प्ली)+++न्दे+++(ख)+++वाआजर+++(प्ली)+++म्। यद्धस्यातेपनीयसी+++(षृ)+++समिद्दिदयता+++(तू)+++इ+++(श)+++। हिं+++(ट)+++हिन्द्या+++(खा)+++वी+++(ण)+++। इषंस्तो+++(टि)+++तृ+++(श)+++भ्या+++(प)+++या+++(श)+++। हिं+++(प)+++हिं+++(श)+++भा+++(ख)+++रो+++(प्ल)+++। हाइ+++(शा)+++ ॥ २ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०२</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/5_aindrapAThaH/03_R-8_sA-10/02/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/5_aindrapAThaH/03_R-8_sA-10/02/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - विमद ऐन्द्रः (प्राजापत्यो वा, वसुकृद्वा वासुकः) अग्निः पङ्क्त्तिः&lt;/summary&gt;&#xA;&lt;p&gt;अग्निन्नस्वा॒वृ॑क्तीभिः । हो॒ता॑रन्त्वावृणीमहे । शीरं॓पा॑वाका॑शोची॒षंवीवोमादे । यज्ञे॓षु॑स्तीर्णाब॑ऋहीषंवीवाक्षसे ॥ २ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - अङ्गिरसान्निवेष्टौद्वौ ॥ अंगिरसः पंक्तिरग्निः ॥&lt;/summary&gt;&#xA;&lt;p&gt;आबुऔ+++(फि)+++हो+++(त)+++वा+++(त)+++। अग्निन्नस्व+++(षी)+++वृक्तिभीः+++(किख्)+++। आबुऔ+++(फि)+++हो+++(त)+++वा+++(त)+++। होतारन्त्वा+++(षी)+++वृणीमहे+++(कीख्)+++। आबुऔ+++(फि)+++हो+++(त)+++वा+++(त)+++। शी+++(क)+++रम्पा+++(थाच्)+++वा+++(क)+++काशोचिषं+++(की)+++विवोमा+++(खि)+++दा+++(ण)+++इ+++(श)+++। आबुऔ+++(फि)+++हो+++(त)+++वा+++(त)+++। यज्ञाइषुस्ती+++(कु)+++र्णाबर्हिषां+++(कीख्)+++। आबुऔ+++(फि)+++हो+++(त)+++वा+++(त)+++। वि+++(च)+++वक्षसे+++(खि)+++ ॥ ३ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - अङ्गिरसान्निवेष्टौद्वौ ॥ अंगिरसः पंक्तिरग्निः ॥&lt;/summary&gt;&#xA;&lt;p&gt;अग्नि+++(का)+++न्नस्ववृक्तिभिः+++(कु)+++इहइहा+++(ती)+++हा+++(त)+++इ+++(श)+++। होतारन्त्वा+++(षी)+++वृणी+++(का)+++महे+++(का)+++इहइहा+++(ती)+++हा+++(त)+++इ+++(श)+++। शी+++(क)+++रम्पा+++(थाच्)+++वा+++(क)+++काशोचिषं+++(की)+++इहइहा+++(ती)+++हा+++(त)+++इ+++(श)+++। विवोमा+++(खि)+++दा+++(ण)+++इ+++(श)+++। इहइहा+++(ती)+++हा+++(त)+++इ+++(श)+++। यज्ञाइषुस्ती+++(षु)+++र्णाबर्हिषं+++(की)+++इहइहा+++(ती)+++हा+++(त)+++इ+++(श)+++। वा+++(ट)+++इवा+++(खा)+++औहोवा+++(शि)+++। क्षा+++(ख)+++से+++(श)+++ ॥ ४ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०३</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/5_aindrapAThaH/03_R-8_sA-10/03/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/5_aindrapAThaH/03_R-8_sA-10/03/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - सत्वश्रवा आत्रेयः उषाः पङ्क्त्तिः&lt;/summary&gt;&#xA;&lt;p&gt;माहे॓नो॑अद्याबो॑धय । ऊ॓षो॑राये॒दिवी॒द्माती । या॒थाचि॒न्नोआ॒बो॑धयः । सत्या॒श्रावसीवाय्ये॒ । सू॓जा॑तेअश्वा॑सूनृते ॥ ३ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - सत्यश्रवसोवार्यश्चसाम ॥ सत्यश्रवाः पंक्तिरुषा ॥&lt;/summary&gt;&#xA;&lt;p&gt;महा+++(खा)+++इमहोनो+++(षी)+++अद्यबो+++(प्लि)+++धा+++(ङ)+++या+++(श)+++। ऊषोराये+++(कीच्)+++दि+++(क)+++वित्मा+++(टा)+++ती+++(त)+++। यथाची+++(भि)+++न्नो+++(त)+++आबो+++(का)+++धा+++(ख)+++याः+++(ण)+++। सत्याश्रा+++(भि)+++वा+++(त)+++सिवा+++(टा)+++य्या+++(खण्)+++इ+++(श)+++। सुजाते+++(भि)+++आ+++(त)+++। श्वा+++(प)+++सु+++(श)+++ना+++(ख)+++र्क्तो+++(प्ल)+++। हाइ+++(शा)+++ ॥ ५ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०४</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/5_aindrapAThaH/03_R-8_sA-10/04/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/5_aindrapAThaH/03_R-8_sA-10/04/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - विमद ऐन्द्रः (प्राजापत्यो वा, वसुकृद्वा वासुकः) सोमः पङ्क्त्तिः&lt;/summary&gt;&#xA;&lt;p&gt;भद्र॒न्नो॒आपी॑वातय । मानोद॓क्षा॑मूत॒क्रातुं॑ । अथा॒तेसख्ये॓अ॑न्धासावी॒वोमादे । रा॒णागा॒वोनया॓वा॑सेवीवा॑क्षसे ॥ ४ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - उषसश्चसाम ॥ पूषा पंक्ति सोमः ॥&lt;/summary&gt;&#xA;&lt;p&gt;भद्रन्नो+++(पि)+++अपिवातया+++(शु)+++। मानो+++(टा)+++दक्षामूता+++(की)+++क्रा+++(ख)+++तू+++(ण)+++म्। आ+++(च)+++थाते+++(था)+++सख्ये+++(का)+++अन्धासा+++(टि)+++वीवोमा+++(खि)+++दा+++(ण)+++इ+++(श)+++। रणा+++(टा)+++गावो+++(टाच्)+++ना+++(क)+++यवसाइवा+++(टुट्)+++इवा+++(खा)+++औहोवा+++(शि)+++। क्षा+++(ख)+++से+++(श)+++ ॥ ६ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०५</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/5_aindrapAThaH/03_R-8_sA-10/05/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/5_aindrapAThaH/03_R-8_sA-10/05/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - गोतमो राहूगणः इन्द्रः पङ्क्त्तिः&lt;/summary&gt;&#xA;&lt;p&gt;कृ॓त्वामाहं॒आनूष्वाधः॒ । भीम॒आ॒वा॑वृतेशा॒वाः॑ । श्रीय्या॓रिष्वा॓उपाका॒योः । नी॒शीप्रीहा॒रीवान्दधे । ह॓स्ता॒योर्वज्रा॑मायासम् ॥ ५ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - लौशञ्च ॥ उषा पंक्तिरिन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;कृत्वामहं+++(षी)+++अनुष्वाधा+++(ती)+++ए+++(त)+++। भीमा+++(चा)+++आवा+++(थाच्)+++वृता+++(का)+++इशा+++(या)+++वाः+++(ट)+++। श्रीया+++(ता)+++ऋष्वा+++(ता)+++ऊपा+++(का)+++का+++(ख)+++योः+++(ण)+++। नीशिप्रीहा+++(ची)+++रीवा+++(का)+++न्दा+++(य)+++धा+++(ट)+++इ+++(श)+++। हस्तायो+++(भि)+++र्वा+++(तच्)+++। ज्रा+++(क)+++मो+++(प)+++बा+++(प्ल)+++यासां+++(प्ला)+++। हाइ+++(शा)+++ ॥ ७ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०६</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/5_aindrapAThaH/03_R-8_sA-10/06/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/5_aindrapAThaH/03_R-8_sA-10/06/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - गोतमो राहूगणः इन्द्रः पङ्क्त्तिः&lt;/summary&gt;&#xA;&lt;p&gt;साघातँ॓वृ॑षाणंरा॒थं॑ । आधीतिष्ठाती॑गोवी॑दं । यःपात्रं॑हार्यो॒जान॑म् । पूर्णा॓मि॑न्द्राचि॒के॑ततिः । यो॒जान्विन्द्रातेहा॒री ॥ ६ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - यामञ्च ॥ लुशः पंक्तिरिन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;सघा+++(फा)+++तंवृषणं+++(फी)+++रथा+++(खा)+++औ+++(ण)+++हो+++(फ)+++वा+++(श)+++। आ+++(क)+++धीतिष्ठा+++(चि)+++तीगो+++(का)+++वा+++(य)+++इदा+++(टा)+++म्। यःपात्रं+++(कि)+++हारियो+++(टि)+++जा+++(ख)+++न+++(ण)+++म्। पू+++(क)+++र्णामिन्द्राचिके+++(कु)+++ता+++(ख)+++ती+++(ण)+++। योजानू+++(भि)+++वा+++(त)+++इन्द्रा+++(टाट्)+++ता+++(ख)+++औहोवा+++(शि)+++। हा+++(ख)+++रि+++(श)+++ ॥ ८ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०७</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/5_aindrapAThaH/03_R-8_sA-10/07/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/5_aindrapAThaH/03_R-8_sA-10/07/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - वसुश्रुत अत्रेयः अग्निः पङ्क्त्तिः&lt;/summary&gt;&#xA;&lt;p&gt;अ॒ग्निन्त॓म्मन्ये॒योवासूः॑ । अस्तंयय्य॓न्ती॑धेना॒वाः । अ॒स्ता॑म॒र्वतोआशा॒वाः॑ । अस्तन्नित्या॑सोवाजी॒नाः । ई॓षं॑स्तोतृभ्यआ॒भा॑रा ॥ ७ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - अङ्गिरसाञ्चैवनिवेष्टः ॥ अंगिरसः पंक्तिरिन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;अग्निन्तम्मा+++(खी)+++न्येयोवासूः+++(प्ली)+++। अस्तंयय्या+++(टी)+++न्तीधे+++(टा)+++ना+++(ख)+++वाः+++(ण)+++। अस्तामर्वा+++(टी)+++न्ताया+++(टा)+++शा+++(ख)+++वाः+++(ण)+++। अस्तान्नित्या+++(टी)+++सोवा+++(टा)+++जा+++(ख)+++इनाः+++(णा)+++। इषंस्तोतृ+++(टी)+++हाहो+++(खा)+++हा+++(ण)+++इ+++(श)+++। भ्या+++(प)+++या+++(श)+++भा+++(ख)+++रो+++(प्ल)+++। हाइ+++(शा)+++ ॥ ९ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०८</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/5_aindrapAThaH/03_R-8_sA-10/08/</link>
