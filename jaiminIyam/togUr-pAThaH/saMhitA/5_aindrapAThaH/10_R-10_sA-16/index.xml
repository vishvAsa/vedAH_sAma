    <item>
      <title>०१</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/5_aindrapAThaH/10_R-10_sA-16/01/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/5_aindrapAThaH/10_R-10_sA-16/01/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - गृत्समद शौनकः इन्द्रः अष्टिः&lt;/summary&gt;&#xA;&lt;p&gt;त्रीका॒दूकेषुमा॒हीषो॒या॒वा॑शीर॑न्तूवी॒शूष्मः । त्रम्पत्सो॒मामपीबद्वीष्णू॑ना॒सूतंय्या॑थावाशं । साईं॑ममादमाहीकर्मा॑का॒र्तावेमाहा॒मूरुं॒ । सै॒नं॑सश्चाद्देवो॒देवंसत्य॓इ ॓न्दूः॑सत्या॒मिन्द्राः ॥ १ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - प्रजापतेर्वाजसनी ॥ प्रजापतिरष्टिविष्णुः ॥&lt;/summary&gt;&#xA;&lt;p&gt;ओई+++(चा)+++त्री+++(क)+++का+++(फ)+++द्रूकाइषू+++(टी)+++माहिषो+++(चि)+++याव+++(का)+++शी+++(क)+++र+++(फ)+++न्तूवीशू+++(क)+++ष्माः+++(फ)+++ओइत्रं+++(खि)+++पा+++(ण)+++त्। सोमामपीबद्वी+++(कू)+++ष्णूना+++(चा)+++सू+++(क)+++तं+++(फ)+++याथा+++(चा)+++वा+++(क)+++शं+++(फ)+++ओइसा+++(खि)+++ई+++(ण)+++म्। ममाद+++(चि)+++माहिक+++(कि)+++र्म्माका+++(चा)+++र्क्ता+++(क)+++वे+++(फ)+++माहामू+++(कि)+++रूं+++(फ)+++ओइसा+++(खि)+++इन+++(णा)+++म्। सश्चाद्दे+++(टि)+++वोदे+++(का)+++वां+++(च)+++सत्यइन्दूस्सत्या+++(टू)+++मि+++(क)+++न्द्रा+++(थ)+++बु+++(श)+++। बा+++(ख)+++ ॥ १ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०२</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/5_aindrapAThaH/10_R-10_sA-16/02/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/5_aindrapAThaH/10_R-10_sA-16/02/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - गौराङ्गिरसः सूर्यः अतिजगती (अष्टिर्वा)&lt;/summary&gt;&#xA;&lt;p&gt;आ॒यं॒सा॑हस्रामान॑वः । दृशाः॓कावीना॒म्मातिज्योतिर्वीध॑र्म । बुध्नस्सामीचीरूषा॒सस्सा॒मी॑रयात् । आरेपा॒सस्साचे॑तसः । स्व॒सा॑रेम॓न्यूमन्ता॑श्चि॒तागोः॑ ॥ २ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - गौराङ्गीरसस्यसामनीद्वे ॥ द्वयोर्गौरतिजगतीन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;अयंसहो+++(ती)+++हा+++(त)+++इ+++(श)+++। स्रमाना+++(खि)+++वाः+++(ण)+++। दृशाःकवी+++(की)+++नाम्मतिर्जो+++(की)+++तिर्वीधा+++(खि)+++र्मा+++(श)+++। ब्रध्नस्समाइची+++(टू)+++रूषा+++(का)+++सस्सामा+++(चि)+++इरा+++(या)+++या+++(ट)+++त्। अरा+++(ता)+++ओवा+++(का)+++। पा+++(ख)+++सस्सचे+++(प्लि)+++तसाः+++(ता)+++। स्वासरे+++(कि)+++मन्यूमा+++(टि)+++न्ताः+++(त)+++। चिताया+++(खि)+++औहोवा+++(शि)+++। गोः+++(ख)+++ ॥ २ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - गौराङ्गीरसस्यसामनीद्वे ॥ द्वयोर्गौरतिजगतीन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;अयंसहस्र+++(षु)+++माना+++(ता)+++वाः+++(त)+++। दृशाःकवी+++(षी)+++नाम्मतिर्जो+++(की)+++तिर्विधा+++(टि)+++र्मा+++(त)+++। ब्रध्नस्समाइची+++(टू)+++रूषा+++(चा)+++सस्सामा+++(चि)+++इरा+++(या)+++या+++(ट)+++त्। ओवा+++(का)+++अरे+++(टा)+++पा+++(क)+++सस्सचे+++(कि)+++तसस्वासरे+++(कु)+++मन्युमा+++(टि)+++न्ताः+++(त)+++। ओवा+++(का)+++चिता+++(का)+++गो+++(टट्)+++रा+++(ख)+++औहोवा+++(शि)+++। वो+++(ख)+++ ॥ ३ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०३</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/5_aindrapAThaH/10_R-10_sA-16/03/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/5_aindrapAThaH/10_R-10_sA-16/03/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - परुच्छेपो दैवोदासिः इन्द्रः अत्यष्टिः&lt;/summary&gt;&#xA;&lt;p&gt;ए॓न्द्रा॑याह्यू॒पा॑नःपारावा॒ताः॑ । ना॓यमा॓च्छा॑वीद॒धा॑नीवासात्पा॑तिः । अस्तारा॓जे॑वासात्पा॑तिः । हावा॑महेत्वाप्राया॑स्वन्तस्सू॒तेष्वा॑ । पु॒त्रासो॑ना॒पीता॒रंवा॒ज॑सातये । मंहीष्ठंवाजसातये ॥ ३ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - प्रयस्वच्चप्राजापत्यम् ॥ प्रजापति (रष्टि) रत्यष्टिरिन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;एन्द्रयाह्युपनाः+++(तू)+++। परा+++(टा)+++वा+++(ख)+++ताः+++(ण)+++। नायमच्छा+++(की)+++वीदथानाइवा+++(कू)+++सत्पा+++(खा)+++ता+++(ण)+++इः+++(श)+++। अस्तारा+++(भि)+++जे+++(त)+++वा+++(क)+++सत्पा+++(खा)+++ता+++(ण)+++इः+++(श)+++। हावामहेत्वा+++(षु)+++प्रयस्वन्ताः+++(ती)+++। सूताइषू+++(टी)+++आ+++(कथ्)+++पुत्रासोना+++(की)+++पीतरंवाजासा+++(कू)+++ता+++(ख)+++या+++(ण)+++इ+++(श)+++। मंहाइष्ठां+++(भि)+++वा+++(त)+++। जा+++(प)+++सा+++(श)+++ता+++(ख)+++यो+++(प्ल)+++। हाइ+++(शा)+++ ॥ ४ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०४</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/5_aindrapAThaH/10_R-10_sA-16/04/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/5_aindrapAThaH/10_R-10_sA-16/04/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - रेभः काश्यपः इन्द्रः अतिजगती (अष्टिर्वा)&lt;/summary&gt;&#xA;&lt;p&gt;त॒मि॒न्द्रं॑ज्योहवीमिमाघा॒वा॑नामुग्रं । सत्रा॓दधा॑नामा॒प्रातिष्कृतं । श्रा॓वां॑सिभू॒रिं । मंही॑ष्ठोगीर्भि॒राचायाज्ञीयो॑वा॒वा॒र्क्ता॑ । रा॒येनो॓विश्वासूपाथाकृ॑णो॒तूवज्री॒ ॥ ४ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - अक्षय्यञ्चरेवत् ॥ रेवत्प्रजापतिरतिजगतीन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;तमिन्द्रन्जोहवी+++(षू)+++मीमाघवाना+++(तु)+++म्। ऊ+++(ख)+++ग्र+++(श)+++म्। सत्राहोइदधा+++(षू)+++नामप्राता+++(टी)+++ईष्कृ+++(खा)+++त+++(ण)+++म्। श्रवां+++(टा)+++सा+++(ट)+++इभू+++(खा)+++रि+++(श)+++म्। मंहिष्ठोगीर्भि+++(षु)+++राचाया+++(टि)+++ज्ञा+++(ख)+++याः+++(ण)+++। वावर्क्ता+++(कि)+++रा+++(ट)+++। येहोइनो+++(की)+++विश्वासुपा+++(खी)+++था+++(श)+++। कृणो+++(ता)+++तू+++(ट)+++वा+++(ख)+++औहोवा+++(शि)+++। ऊ+++(ख)+++पा+++(श)+++ ॥ ५ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०५</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/5_aindrapAThaH/10_R-10_sA-16/05/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/5_aindrapAThaH/10_R-10_sA-16/05/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - नकुलः सविता अत्यष्टिः&lt;/summary&gt;&#xA;&lt;p&gt;आ॒भित्य॒न्देवंसा॑वीता॓रा ॓मोण्योः॒का॒विक्रा॑तुं । अर्चा॑मीसत्या॒सावंरात्नाधा॒मा॒भीप्रीयम्मातिम् । ऊर्ध्वा॒य॒स्याआमा॑ती॒र्भाआतिद्युत॒त्सावि॑मनी । हिर॑ण्यपाणीरमीमीता॒सू॓क्रा॓तू॑कृपा॒स्वाः॑ ॥ ५ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - सवितुश्चसाम ॥ सवितात्यष्टिः सविता ॥&lt;/summary&gt;&#xA;&lt;p&gt;अभित्यन्देवंसविता+++(षृ)+++रमौहोऔहोवा+++(तू)+++हा+++(त)+++इ+++(श)+++। ओणा+++(पा)+++योः+++(ण)+++काविक्रा+++(पि)+++तू+++(ण)+++म्। औ+++(क)+++होऔ+++(का)+++होवा+++(पा)+++हाइ+++(शा)+++अर्चामी+++(खि)+++सा+++(श)+++त्यासावां+++(खि)+++रा+++(ण)+++। त्नाधामा+++(पि)+++भी+++(ण)+++प्रीयम्मा+++(पि)+++ती+++(ण)+++म्। औ+++(क)+++होऔ+++(का)+++होवा+++(पा)+++हाबु+++(शा)+++ऊर्ध्वाया+++(खि)+++स्या+++(ण)+++आमाती+++(खि)+++र्भाः+++(ण)+++। आदीद्यू+++(पि)+++ता+++(ण)+++त्सावीमा+++(पि)+++नी+++(ण)+++। औ+++(क)+++होऔ+++(का)+++होवा+++(पा)+++हाइ+++(शा)+++हीराण्या+++(खि)+++पा+++(श)+++णीरामी+++(खि)+++मी+++(ण)+++। तासुक्रा+++(चि)+++तूः+++(ण)+++। औहो+++(का)+++औहो+++(पा)+++हाउवा+++(शि)+++। ए+++(तच्)+++कृ+++(क)+++पा+++(ट)+++स्वाः+++(ख)+++ ॥ ६ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०६</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/5_aindrapAThaH/10_R-10_sA-16/06/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/5_aindrapAThaH/10_R-10_sA-16/06/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - गृत्समद शौनकः इन्द्रः अष्टिः (अतिशक्करी वा)&lt;/summary&gt;&#xA;&lt;p&gt;ता॒वत्य॓न्न ॓री॑यनृतो॒पा॑इन्द्रा । प्राथामंपूर्व्य॒न्ती॑विप्रावा॓च्यंकृत॒म् । यो॒देव॒स्याशा॒वासप्रारी॑णाया॓सुं॑रीणन्नापाः॒ । भु॒वोविश्वा॑माभ्या॓दे॑वामो॒ज॑सा । वीर्द॓दू ॓र्जंशा॒ता॑क्रातूर्वीदे॒दीषम् ॥ ६ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - वाक्त्रतुरञ्च ॥ इषोऽष्टिरिन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;ता+++(प)+++व+++(श)+++त्यन्ना+++(प्ला)+++र्यन्नृता+++(ङि)+++बु+++(श)+++। आपाआइन्द्रा+++(टुच्)+++प्रा+++(क)+++थमम्पू+++(पि)+++र्वीयं+++(चा)+++दी+++(क)+++वी+++(फ)+++प्रवाच्य+++(चि)+++कृ+++(क)+++त+++(फ)+++म्। योदेवास्या+++(टीच्)+++स्याशा+++(क)+++वसाप्रा+++(पि)+++रीणा+++(चा)+++या+++(क)+++सूं+++(फ)+++रीणा+++(चा)+++न्ना+++(क)+++पाः+++(फ)+++। भूवोविश्वामा+++(टु)+++भ्यदा+++(पा)+++इवमो+++(चि)+++ज+++(क)+++सा+++(फ)+++वीदे+++(चा)+++दू+++(क)+++र्जं+++(फ)+++शताक्रा+++(खि)+++ता+++(ण)+++बु+++(श)+++। विदाइदिषा+++(प्लु)+++बु+++(श)+++। बा+++(श)+++ ॥ ७ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०७</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/5_aindrapAThaH/10_R-10_sA-16/07/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/5_aindrapAThaH/10_R-10_sA-16/07/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - परुच्छेपो दैवोदासिः विश्वेदेवाः अत्यष्टिः&lt;/summary&gt;&#xA;&lt;p&gt;अस्तुश्रौ॒षा॑ट्पूरो॒आ॑ग्नीन्धीया॒दधे । आ॓नूत्य॓च्छर्धोदिव्यं॒वृणीमहे । इन्द्रं॑वायू॒वृ॑णीमहे । य॓द्धा॑क्राणा॒वी॒वा॒स्वा॑ते । ना॓भा॑सन्दायाना॒व्या॓सेआ॒धःप्रा॒नूना॒मूपा॑यन्तीधीता॒याः॑ । दे॒वं॒अ॒च्छाना॒धीता॒याः । ॥ ७ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - ऐषञ्च ॥ यज्ञतुरोऽत्यष्टिरिन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;अस्तुश्रौ+++(ति)+++षा+++(त)+++ट्। पूरोअग्नि+++(षी)+++न्धीयादधे+++(की)+++होऔ+++(का)+++हो+++(त)+++वा+++(त)+++। अनुत्यच्छर्धो+++(कुच्)+++दि+++(क)+++व्यंवृणा+++(टि)+++हाइमा+++(खि)+++हा+++(ण)+++इ+++(श)+++। इन्द्रांवा+++(भि)+++यू+++(त)+++वृणी+++(टा)+++मा+++(ख)+++हा+++(ण)+++इ+++(श)+++। यद्धाक्राणाविवा+++(टू)+++स्वा+++(ख)+++ता+++(ण)+++इ+++(श)+++। ना+++(क)+++भासन्दायाना+++(टु)+++व्या+++(ख)+++सा+++(ण)+++इ+++(श)+++। अधप्रनू+++(षी)+++नमुपयन्तीधी+++(कू)+++तायो+++(टा)+++होऔ+++(का)+++हो+++(त)+++वा+++(त)+++। दाइवं+++(टि)+++अच्छा+++(टा)+++होऔ+++(का)+++हो+++(त)+++वा+++(त)+++। ना+++(क)+++धो+++(प)+++बा+++(प्ल)+++तायो+++(प्ला)+++। हाइ+++(शा)+++ ॥ ८ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
