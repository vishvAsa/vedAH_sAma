      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/5_aindrapAThaH/01_R-11_sA-24/03/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - वामदेवो गौतमः इन्द्रः जगती&lt;/summary&gt;&#xA;&lt;p&gt;सामेताविश्वा॓ओज॑सापा॓तिन्दीवः॒ । य॒ए॒का॓इ॓त्भू॑रा॒तीथिर्जना॑नाम् । सा॒पूर्व्यो॒नूता॑नामाजी॒गीष॑न्तंवार्क्तानीरानूवावृताएकाईत् ॥ ३ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - इन्द्रस्येन्द्रियाणीत्रिणि ॥ त्रयाणां इन्द्रो जगतीन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;समा+++(ता)+++हा+++(त)+++इ+++(श)+++। आइतविश्वा+++(षु)+++ओजासा+++(कि)+++पतिमो+++(कि)+++इदिवा+++(पि)+++हा+++(प्ल)+++हा+++(ङ)+++इ+++(श)+++। यआ+++(चा)+++इका+++(या)+++ई+++(ट)+++त्भू+++(च)+++राति+++(चा)+++थिर्जना+++(टि)+++नां+++(ख)+++हा+++(प्ल)+++हा+++(ङ)+++इ+++(श)+++। सापूर्वीयो+++(टी)+++नूता+++(का)+++नमा+++(चा)+++जिगा+++(टा)+++इषा+++(खा)+++न्हा+++(प्ल)+++हा+++(ङ)+++इ+++(श)+++। तं+++(क)+++वार्क्ता+++(या)+++नी+++(टच्)+++रा+++(क)+++नुवा+++(टा)+++वृतआ+++(चि)+++ए+++(ट)+++कया+++(का)+++उवा+++(ता)+++। वृधे+++(ताच्)+++ ॥ १० ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - इन्द्रस्येन्द्रियाणीत्रिणि ॥ त्रयाणां इन्द्रो जगतीन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;समेतविश्वाओजसा+++(षृ)+++पतिमेपाती+++(तू)+++म्। दिवया+++(कि)+++हौ+++(ट)+++हौ+++(ट)+++हो+++(त)+++वाई+++(टा)+++या+++(त)+++। यआ+++(त)+++ईका+++(या)+++ई+++(ट)+++त्भू+++(ट)+++राती+++(था)+++थिर्जना+++(टि)+++नां+++(क)+++हौ+++(ट)+++हौ+++(ट)+++हो+++(त)+++वाई+++(टा)+++या+++(त)+++। सापूर्व्यो+++(टि)+++नूता+++(का)+++नमा+++(चा)+++जिगा+++(चा)+++इषा+++(का)+++न्हौ+++(ट)+++हौ+++(ट)+++हौ+++(ट)+++हो+++(त)+++वाई+++(टा)+++या+++(त)+++। तं+++(क)+++वार्क्ता+++(या)+++नी+++(टच्)+++रा+++(क)+++नुवा+++(टा)+++वृता+++(चा)+++आ+++(च)+++ये+++(ट)+++कया+++(का)+++उवा+++(ता)+++। महे+++(ताच्)+++ ॥ ११ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - इन्द्रस्येन्द्रियाणीत्रिणि ॥ त्रयाणां इन्द्रो जगतीन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;समेतविश्वाओजसा+++(षृ)+++पतिमेपाती+++(तु)+++म्। दाइवा+++(यि)+++या+++(ट)+++औ+++(ट)+++हौ+++(ट)+++हो+++(त)+++वाओमो+++(चि)+++वा+++(श)+++। यआ+++(चा)+++इका+++(या)+++ई+++(ट)+++त्भू+++(च)+++राती+++(चा)+++थिर्जना+++(टि)+++नाऔ+++(टा)+++हौ+++(ट)+++हो+++(त)+++वाओमो+++(चि)+++वा+++(श)+++। सापू+++(चा)+++र्वा+++(य)+++यो+++(ट)+++नूता+++(का)+++नमा+++(चा)+++जिगा+++(टा)+++इषान्हौ+++(टि)+++हौ+++(ट)+++हो+++(त)+++वाओमो+++(चि)+++वा+++(श)+++। तंवा+++(का)+++र्क्ता+++(य)+++नी+++(टच्)+++रा+++(क)+++नुवा+++(टा)+++वृतआ+++(चि)+++ए+++(ट)+++कया+++(का)+++उवा+++(ता)+++। धर्मा+++(टा)+++णे+++(ख)+++ ॥ १२ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
