    <item>
      <title>०१</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/4_asAvipAThaH/5_R-8_sA-11/01/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/4_asAvipAThaH/5_R-8_sA-11/01/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - भरद्वाजो बार्हस्पत्यः इन्द्रः अनुष्टुप्&lt;/summary&gt;&#xA;&lt;p&gt;प्र॓त्य॑स्मैपी॒पी॑षते । वि॒श्वा॑नीविदू॒षे॑भरा । अ॓रं॑गमा॒याज॒ग्मा॑ये । आ॒पा॑श्चाद्दाघ्वाने॒नाराः ॥ १ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - कौल्मलबर्हिषेद्वे ॥ द्वयोः कुल्मबर्हिरनुष्टुबिन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;प्रत्यस्मैपीबा+++(तु)+++हा+++(त)+++बु+++(श)+++। ओइषा+++(ति)+++ता+++(त)+++इ+++(श)+++इ। वाइश्वा+++(कि)+++नी+++(चक्)+++वाइदूषे+++(टी)+++हा+++(त)+++इभा+++(ता)+++रा+++(त)+++आरा+++(टाच्)+++ङ्गमा+++(का)+++याजा+++(टा)+++हा+++(त)+++ग्माया+++(था)+++यपाश्चा+++(टिट्)+++द्दा+++(ख)+++औहोवा+++(शि)+++। घ्वने+++(टा)+++नराः+++(खा)+++ ॥ १ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - कौल्मलबर्हिषेद्वे ॥ द्वयोः कुल्मबर्हिरनुष्टुबिन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;प्रत्यस्मैपी+++(ती)+++पीषता+++(ति)+++इ+++(श)+++। वाइश्वा+++(किच्)+++नी+++(क)+++वाइदूषे+++(टि)+++भारा+++(टा)+++आरा+++(टाच्)+++ङ्गा+++(क)+++मायजग्माया+++(षू)+++यपश्चाद्दघ्वना+++(टू)+++हो+++(च)+++इ+++(श)+++। नाराऔ+++(टि)+++हो+++(ख)+++बा+++(प्ल)+++। हो+++(प्ल)+++इळा+++(शा)+++ ॥ २ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - नानदन्तृतीयम् ॥ इन्द्रोऽनुष्टुबिन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;प्रत्यस्मैपीपी+++(फु)+++षता+++(ता)+++इवा+++(पा)+++इश्वानिविदुषे+++(प्लू)+++भा+++(ङ)+++रा+++(श)+++। अरङ्गमायाज+++(फू)+++ग्मयो+++(खा)+++हायापाश्चाद्दाः+++(टु)+++। घ्वा+++(क)+++नो+++(प)+++बा+++(प्ल)+++नारो+++(प्ला)+++। हाइ+++(शा)+++ ॥ ३ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०२</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/4_asAvipAThaH/5_R-8_sA-11/02/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/4_asAvipAThaH/5_R-8_sA-11/02/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - वामदेवो गौतमः, शाकपतूो वा इन्द्रः अनुष्टुप्&lt;/summary&gt;&#xA;&lt;p&gt;आ॒नोवयोवयाश्शायं॒ । माहा॑न्तंगंभारेष्ठाम् । माहा॒न्तं॑पूर्वी॑नेष्टां॒ । उग्रं॒वाचोआ॒पा॑वधीः ॥ २ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - शाकपूतञ्च ॥ शाकपूतिरनुष्टुबिन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;आनोवयो+++(षी)+++वयश्शा+++(ति)+++या+++(त)+++म्। माहान्तङ्गह्वरा+++(खू)+++इष्ठा+++(शा)+++म्। माहान्तंपूर्वीना+++(खू)+++इष्ठा+++(णा)+++म्। उग्रंवा+++(टि)+++चोअपावा+++(खी)+++। धीः+++(त्र)+++ ॥ ४ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०३</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/4_asAvipAThaH/5_R-8_sA-11/03/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/4_asAvipAThaH/5_R-8_sA-11/03/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - प्रियमेध आंगिरसः इन्द्रः अनुष्टुप्&lt;/summary&gt;&#xA;&lt;p&gt;आ॒त्वाराथं॑याथोता॒ये । सुम्नाया॑वर्क्तया॑मसि । तु॒विकूर्मि॑मृतीषाहं । इ॒न्द्रं॑शवीष्ठासा॒त्पा॑तिम् ॥ ३ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - कौल्मलबर्हिषेद्वे ॥ द्वयोः कुल्मलबर्हिरनुष्टुबिन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;आत्वारथं+++(षी)+++यथौहो+++(ति)+++वा+++(त)+++। ताया+++(का)+++इसू+++(खा)+++म्ना+++(ण)+++। यावर्क्तयामसी+++(षू)+++तुविकू+++(टु)+++र्मी+++(टच्)+++मा+++(ख)+++र्क्ती+++(ण)+++। षहां+++(का)+++माइन्द्रं+++(कि)+++शा+++(ख)+++वी+++(ण)+++। ष्ठासात्पा+++(टि)+++तीं+++(खण्)+++। ओ+++(प)+++इळा+++(शा)+++ ॥ ५ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - कौल्मलबर्हिषेद्वे ॥ द्वयोः कुल्मलबर्हिरनुष्टुबिन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;आत्वारथंयथो+++(फू)+++ताया+++(खा)+++आत्वारथा+++(शी)+++म्। याथोताया+++(टी)+++औहो+++(खा)+++वा+++(श)+++। ई+++(ख)+++हा+++(श)+++। सुम्नाया+++(चि)+++वा+++(क)+++र्क्तायामसीयौ+++(कुच्)+++हो+++(य)+++यौ+++(ट)+++हो+++(ख)+++वा+++(श)+++। ई+++(ख)+++हा+++(श)+++। तुविकुर्मी+++(ची)+++मृ+++(क)+++ताइषहमौ+++(कुच्)+++हो+++(य)+++यौ+++(ट)+++हो+++(ख)+++वा+++(श)+++। ई+++(ख)+++हा+++(श)+++। इन्द्रंशवी+++(ची)+++ष्ठासात्पतिमौ+++(कुच्)+++हो+++(य)+++यौ+++(ट)+++हो+++(ख)+++वा+++(श)+++। ई+++(ख)+++हा+++(श)+++ ॥ ६ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०४</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/4_asAvipAThaH/5_R-8_sA-11/04/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/4_asAvipAThaH/5_R-8_sA-11/04/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - प्रगाथः काण्वः इन्द्रः अनुष्टुप्&lt;/summary&gt;&#xA;&lt;p&gt;सा॒पूर्व्यो॒माहो॒नां । वेनःक्रा॒तूभिरानजे । यस्या॒द्वारामा॓नूः॑पीता॒ । देवे॒षूधी॒याआनाजे ॥ ४ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - मधुश्चुन्निधनञ्च प्राजापत्यम् ॥ प्रजापतिरनुष्टुबिन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;सपूर्व्योमहोना+++(तू)+++मे+++(त)+++। वेनाःक्रा+++(चि)+++तू+++(क)+++भाइरानाजे+++(टु)+++हा+++(त)+++हाऔ+++(टा)+++हो+++(त)+++वाआ+++(टा)+++इही+++(ता)+++। यस्या+++(का)+++द्वारा+++(था)+++मानूःपीता+++(टी)+++हा+++(त)+++हाऔ+++(टा)+++हो+++(त)+++वाआ+++(टा)+++इही+++(ता)+++। दाइवाइषू+++(टु)+++हा+++(त)+++हाऔ+++(टा)+++हो+++(त)+++वाआ+++(टा)+++इही+++(ता)+++। धीया+++(का)+++आना+++(टाट्)+++जा+++(ख)+++औहोवा+++(शि)+++। मधू+++(ता)+++श्च्यूताः+++(टाख्)+++ ॥ ७ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०५</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/4_asAvipAThaH/5_R-8_sA-11/05/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/4_asAvipAThaH/5_R-8_sA-11/05/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - श्यावाश्व आत्रयेः मरुतः अनुष्टुप्&lt;/summary&gt;&#xA;&lt;p&gt;या॒दीवा॓ह॑न्त्याशा॒वाः । भ्राज॑मानाराथेष्वा॒ । पीब॑न्तोमादीरम्माधू॑ । तत्रश्रा॒वां॑सिकृण्वते ॥ ५ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - उषसश्चसाम ॥ उषानुष्टुबिन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;यदीवहन्त्याश+++(षू)+++वोयद्येयादी+++(तु)+++। ओइवहन्ताया+++(यू)+++शावाः+++(टा)+++। ओइभ्राजमाना+++(षू)+++रथाइषू+++(ये)+++वा+++(ट)+++। ओइपिबन्तो+++(षु)+++मदीराम्मा+++(यी)+++धू+++(ट)+++। ओइतत्रश्रावां+++(षू)+++सिक्राउवा+++(की)+++ओ+++(प)+++बा+++(प्ल)+++ण्वातो+++(प्ला)+++। हाइ+++(शा)+++ ॥ ८ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०६</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/4_asAvipAThaH/5_R-8_sA-11/06/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/4_asAvipAThaH/5_R-8_sA-11/06/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - शय्युबार्हस्पत्यः इन्द्रः अनुष्टुप्&lt;/summary&gt;&#xA;&lt;p&gt;त्या॓मू॑वोअप्रा॑हणं । गृणीषे॓शा ॓वासस्पा॒तिम् । इन्द्रं॑विश्वासाहन्नारं । शाची॑ष्ठंविश्वा॑वे॑दसम् ॥ ६ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - गौतमम् ॥ भरद्वाजो ॥&lt;/summary&gt;&#xA;&lt;p&gt;त्यमुवो+++(षि)+++अप्राहा+++(खी)+++ण+++(ण)+++म्। गृणी+++(का)+++षेशवा+++(कि)+++सस्पाताइमिन्द्रा+++(टू)+++वा+++(ख)+++इश्वा+++(णा)+++। साहं+++(का)+++होये+++(पा)+++नारमो+++(ति)+++इ+++(श)+++। शचाइष्ठां+++(पी)+++वी+++(ण)+++। श्वावा+++(टा)+++हो+++(ख)+++बा+++(प्ल)+++दासां+++(प्ला)+++। हाइ+++(शा)+++ ॥ ९ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०७</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/4_asAvipAThaH/5_R-8_sA-11/07/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/4_asAvipAThaH/5_R-8_sA-11/07/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - वामदेवो गौतमः दधिक्रा वा अनुष्टुप्&lt;/summary&gt;&#xA;&lt;p&gt;दधिक्रा॒विण्णो॑अकार्षं । जिष्णोरश्वा॑स्यावाजीनाः॑ । सूराभी॒नोमू॒खा॑करात् । प्राणआयूंषितारिषात् ॥ ७ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - अग्नेश्चदधिक्रम् ॥ अग्निरनुष्टुबिनन्द्रः ॥ दधिक्रा वा ॥&lt;/summary&gt;&#xA;&lt;p&gt;ओ+++(त)+++हाइदधिक्रा+++(षू)+++विण्णोअकार्षामो+++(तू)+++हा+++(त)+++इ+++(श)+++। ओ+++(त)+++हाइजिष्णो+++(षी)+++रश्वस्यवाजिना+++(टू)+++ओहा+++(चा)+++इ+++(श)+++। सुरा+++(का)+++भीनो+++(का)+++मुखाका+++(टि)+++रा+++(त)+++त्। प्रणा+++(टाच्)+++हो+++(य)+++आयूं+++(टा)+++हो+++(य)+++षीतारा+++(टि)+++इषा+++(खाण्)+++त्। ओ+++(प)+++इळा+++(शा)+++ ॥ १० ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०८</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/4_asAvipAThaH/5_R-8_sA-11/08/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/4_asAvipAThaH/5_R-8_sA-11/08/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - जेता माधुच्छन्दसः इन्द्रः अनुष्टुप्&lt;/summary&gt;&#xA;&lt;p&gt;पूरांभिन्दू॒रियूवाः॒कविः । आमी॑तौजाअजायत । इ॒न्द्रो॓विश्वास्याक॒र्मा॑णः । धर्ता॑वज्रीपू॑रूष्ट्रतः ॥ ८ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - मारूतंवैश्वामित्रंवा आङ्गीरसानांवा साम मैधातिथंवा ॥ मरुतोऽनुष्टुबिन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;पूरां+++(फा)+++भिन्दुर्युवा+++(खी)+++कविः+++(शा)+++। आमीतौजा+++(की)+++आजाया+++(टि)+++ता+++(त)+++। आइन्द्रोविश्वा+++(टु)+++स्याक+++(का)+++र्मा+++(ख)+++णाः+++(ण)+++। धर्क्तावाज्रौ+++(की)+++वाउवो+++(खि)+++वा+++(श)+++। पुरूष्टु+++(प्लि)+++ताः+++(श)+++। हो+++(प्ल)+++इळा+++(शा)+++ ॥ ११ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
  </channel>
