    <item>
      <title>०३</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/4_asAvipAThaH/6_R-10_sA-13/03/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/4_asAvipAThaH/6_R-10_sA-13/03/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - प्रियमेध आंगिरसः इन्द्रः अनुष्टुप्&lt;/summary&gt;&#xA;&lt;p&gt;विश्वा॒नरा॑स्यवास्पातिं । आनानतास्याशा॒वासः । एवै॑श्वचर्षा॑णीनां॒ । ऊतीहू॑वेराथानाम् ॥ ३ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - अग्नेर्वैश्वानरस्यसामनीद्वे ॥ द्वयोरग्निरनुष्टुबग्निरिन्द्रो वैश्वानरो वा ॥&lt;/summary&gt;&#xA;&lt;p&gt;विश्वानरा+++(ती)+++। स्यवा+++(टा)+++स्पाती+++(टा)+++म्। आनानतस्या+++(कु)+++शा+++(च)+++वा+++(य)+++साः+++(ट)+++। ए+++(क)+++वै+++(च)+++श्चचर्षणा+++(टीच्)+++ईना+++(चा)+++म्। ऊती+++(का)+++हूवा+++(का)+++इरथा+++(पि)+++ना+++(प्ल)+++म्। हाइ+++(शा)+++ ॥ ३ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - अग्नेर्वैश्वानरस्यसामनीद्वे ॥ द्वयोरग्निरनुष्टुबग्निरिन्द्रो वैश्वानरो वा ॥&lt;/summary&gt;&#xA;&lt;p&gt;विश्वा+++(खा)+++नरस्यवौहो+++(प्लू)+++स्पा+++(ङ)+++ति+++(श)+++म्। आनानता+++(टी)+++हा+++(त)+++स्याशा+++(का)+++वा+++(ख)+++साः+++(ण)+++। ए+++(क)+++वै+++(च)+++श्चचर्षणा+++(पी)+++इना+++(त्रा)+++म्। ऊती+++(का)+++हूवा+++(का)+++इरथा+++(पि)+++ना+++(प्ल)+++म्। हाइ+++(शा)+++ ॥ ४ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०४</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/4_asAvipAThaH/6_R-10_sA-13/04/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/4_asAvipAThaH/6_R-10_sA-13/04/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - मधुच्छन्दा विश्वामित्रः इन्द्रः अनुष्टुप्&lt;/summary&gt;&#xA;&lt;p&gt;सा॒खाय॓स्ते॑दीवोना॑राः । धीया॓मर्तास्याश॒र्मा॑तः । ऊ॒तीसा॓बृ ॓हातो॒दीवः । द्वीषो॒अंहोना॒ता॑रती ॥ ४ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - शाकपूतेद्वे ॥ द्वयोः शाकपूतिरनुष्टुबिन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;साघायास्ता+++(टी)+++ए+++(त)+++। दिवोनारा+++(टी)+++ए+++(त)+++। धियामार्क्ता+++(टी)+++ए+++(त)+++। स्याशार्म्माता+++(टी)+++ए+++(त)+++। ऊताइसाबृ+++(टु)+++ए+++(त)+++। हातोदीवा+++(टी)+++ए+++(त)+++। द्विषोआंहा+++(टी)+++ए+++(त)+++। नातारा+++(चि)+++तिइळा+++(टि)+++भा+++(खण्)+++। ओ+++(प)+++इळा+++(प्ला)+++ ॥ ५ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - शाकपूतेद्वे ॥ द्वयोः शाकपूतिरनुष्टुबिन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;सघायस्ता+++(ती)+++इ+++(श)+++। दीवो+++(का)+++नरोधियो+++(की)+++मार्क्ता+++(टा)+++स्याश+++(का)+++र्म्माताः+++(चा)+++। ऊती+++(था)+++साबृ+++(टा)+++हातो+++(का)+++दिवाः+++(चा)+++। द्विषो+++(का)+++आंहो+++(टा)+++। नातारा+++(चि)+++तिइळा+++(टि)+++भा+++(खण्)+++। ओ+++(प)+++इळा+++(प्ला)+++ ॥ ६ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०५</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/4_asAvipAThaH/6_R-10_sA-13/05/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/4_asAvipAThaH/6_R-10_sA-13/05/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - प्रियमेध आंगिरसः इन्द्रः अनुष्टुप्&lt;/summary&gt;&#xA;&lt;p&gt;अ॒र्चातप्रा॒र्चातानरः । प्री॒यामे॑धासोअ॒र्चातः । अर्चन्तूपूत्राका॒ऊता । पू॒रामिधृष्णुं१वार्चत ॥ ५ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - प्रैय्यमेधञ्च ॥ प्रियमेधानुष्टुबिन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;अर्चतप्रार्चता+++(षू)+++ना+++(ख)+++राः+++(प्ल)+++। प्रियमेधा+++(खी)+++सोआ+++(चा)+++र्चाता+++(फा)+++। अर्चन्तुपू+++(खी)+++त्राका+++(चा)+++ऊ+++(क)+++ता+++(फ)+++। पू+++(क)+++रमिद्धा+++(टि)+++ष्णुवार्चा+++(खि)+++। ता+++(त्र)+++ ॥ ७ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०६</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/4_asAvipAThaH/6_R-10_sA-13/06/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/4_asAvipAThaH/6_R-10_sA-13/06/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - भरद्वाजो बार्हस्पथः इन्द्रः (अग्निः) अनुष्टुप्&lt;/summary&gt;&#xA;&lt;p&gt;उक्थ॓मिन्द्रा॑याशं॒स्यं॑ । व॒र्धानंपूरूनिष्षिधे । शक्रो॓या ॓था॑सूते॑षू॑णः । रारा॓णात्सख्ये॒षु॑च ॥ ६ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - बार्हदुक्थञ्च ॥ बृहदुक्थोऽनुष्टुबिन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;उक्थमिन्द्रा+++(ती)+++। याशंसा+++(टि)+++या+++(त)+++म्। वार्धानं+++(कि)+++पुरूनिष्षा+++(टी)+++इधा+++(ता)+++इ+++(श)+++। शक्रोया+++(भि)+++था+++(त)+++सूते+++(का)+++षू+++(ख)+++नाः+++(ण)+++। रा+++(क)+++रणा+++(टा)+++त्सा+++(त)+++। खीया+++(का)+++इषू+++(टा)+++चा+++(खण्)+++। ओ+++(प)+++इळा+++(शा)+++ ॥ ८ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०७</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/4_asAvipAThaH/6_R-10_sA-13/07/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/4_asAvipAThaH/6_R-10_sA-13/07/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - अत्रिभूमः इन्द्रः अनुष्टुप्&lt;/summary&gt;&#xA;&lt;p&gt;विभोष्टइन्द्ररा॒धा॑सः । विभ्वीरातीश्शातक्रतो । अ॒था॑नोविश्वचर्ष॑णे । द्युम्नं॒सूदत्रमंहया ॥ ७ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - वरूणान्याश्चसाम ॥ वरुणान्यनुष्टुबिन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;विभोष्टइ+++(षि)+++न्द्रराधा+++(ति)+++साः+++(त)+++। विभवीरा+++(टी)+++तिश्शतोकृतो+++(कु)+++शता+++(टा)+++क्रता+++(चा)+++बु+++(श)+++। आथा+++(का)+++नोविश्वचर्षणे+++(चू)+++श्वचा+++(टा)+++र्षाणा+++(चा)+++इ+++(श)+++। द्युम्नंसूदत्रमं+++(कू)+++हयत्रमांहा+++(खु)+++। या+++(त्र)+++ ॥ ९ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०८</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/4_asAvipAThaH/6_R-10_sA-13/08/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/4_asAvipAThaH/6_R-10_sA-13/08/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - प्रस्कण्वः काण्वः उषाः अनुष्टुप्&lt;/summary&gt;&#xA;&lt;p&gt;वा॒या॑श्चीक्तेपा॒तत्रीणाः॑ । द्वीपाश्चा॒तू॑ष्पदर्जूनी । ऊषप्रा॓र॑न्मृतूंरा॒नू॑ । दीवो॓अ॑न्तभ्यस्पारी॑ ॥ ८ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - उषसश्चसाम ॥ उषानुष्टुबिन्द्रः ॥ उषा वा ॥&lt;/summary&gt;&#xA;&lt;p&gt;वयश्चा+++(खि)+++इक्तेपतत्रिणाः+++(शू)+++। द्बिपाश्चतू+++(षी)+++ष्पदर्जू+++(कि)+++नाये+++(पा)+++उषःप्रारा+++(शी)+++न्। ॠतूं+++(का)+++रनूदिवो+++(की)+++आन्ते+++(टा)+++। भा+++(प)+++या+++(श)+++स्पा+++(ख)+++रो+++(प्ल)+++। हाइ+++(शा)+++ ॥ १० ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०९</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/4_asAvipAThaH/6_R-10_sA-13/09/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/4_asAvipAThaH/6_R-10_sA-13/09/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - त्रित आत्यः (कुत्स आंगिरसो वा) विश्वेदेवाः अनुष्टुप्&lt;/summary&gt;&#xA;&lt;p&gt;आ॒मीये॒देवा॒स्था॒ना॑ । मध्येये॓रो ॓चा॑नेदीवः । कद्व॓ऋ॑तंकादमृ॒तं । का॒प्रत्ना॒आहू॑तिः ॥ ९ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - देवानाञ्चरुचिरोचनंवा ॥ रोचनम् वा । रुचिरनुष्टुबिन्द्रः ॥ विश्वेदेवा वा ॥&lt;/summary&gt;&#xA;&lt;p&gt;आमिये+++(षि)+++देवास्थना+++(ती)+++। मध्येयेरो+++(षी)+++चनेदिवाःका+++(चु)+++द्वाऋताङ्का+++(की)+++दमार्क्ता+++(टि)+++म्। काप्रत्ना+++(कि)+++वाआहू+++(टि)+++तीः+++(खण्)+++। ओ+++(प)+++इळा+++(शा)+++ ॥ ११ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
