    <item>
      <title>०१</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/4_asAvipAThaH/3_R-10_sA-18/01/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/4_asAvipAThaH/3_R-10_sA-18/01/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - अरिष्टनेमिस्ताक्ष्र्यः इन्द्रः (ताक्ष्र्यः) त्रिष्टुप्&lt;/summary&gt;&#xA;&lt;p&gt;त्या॒मूषुवाजी॒नन्देवा॒जू॑तं । स॒होवा॒नं॑ता॒रूता॒रंराथा॑नाम् । आ॒री॑ष्टनेमिंपृतना॓ज॑माशू॒म् । स्व॒स्ताये॒ता॓क्ष्यामीहाहू॑वेम ॥ १ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - आदित्याः सामनीद्वे तार्क्ष्यसामनिवा ॥ तार्थ्यस्त्रिष्टुबिन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;त्यमूषू+++(खि)+++वाजिना+++(खि)+++न्दे+++(ख)+++वजू+++(खा)+++त+++(श)+++म्। सहो+++(का)+++वान+++(था)+++न्तारूता+++(कि)+++रंरथा+++(खि)+++ना+++(श)+++म्। अरिष्टना+++(खी)+++इमीं+++(शा)+++पृतना+++(खि)+++जमा+++(खा)+++शू+++(श)+++म्। स्वस्तयाइता+++(कु)+++र्क्षमिहा+++(खि)+++हूवा+++(खा)+++इ+++(श)+++। मा+++(त्र)+++म् ॥ १ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - आदित्याः सामनीद्वे तार्क्ष्यसामनिवा ॥ (तार्थ्यो वा) ॥&lt;/summary&gt;&#xA;&lt;p&gt;इयइया+++(ती)+++हाइत्यमुषु+++(षु)+++वाजिना+++(खि)+++न्दे+++(ख)+++वजू+++(खा)+++त+++(श)+++म्। ईया+++(फा)+++ईया+++(फा)+++आ+++(प्ल)+++हा+++(त)+++इ+++(श)+++। सहो+++(का)+++वान+++(था)+++न्तारूता+++(कि)+++रंरथा+++(खि)+++ना+++(श)+++म्। इयइया+++(ती)+++आ+++(क)+++रिष्टनाइमिं+++(टु)+++पार्ताना+++(कि)+++जमा+++(खा)+++शू+++(श)+++म्। ईया+++(फा)+++ईया+++(फा)+++आ+++(प्ल)+++हा+++(त)+++इ+++(श)+++। स्वस्तयाइता+++(कु)+++र्क्षमिहा+++(खि)+++हूवा+++(खा)+++इ+++(श)+++। मा+++(त्र)+++ ॥ २ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०२</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/4_asAvipAThaH/3_R-10_sA-18/02/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/4_asAvipAThaH/3_R-10_sA-18/02/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - भरद्वाजः (गर्गो भारद्वाजः) इन्द्रः त्रिष्टुप्&lt;/summary&gt;&#xA;&lt;p&gt;त्रा॒ता॒रमि॒न्द्रामा॒वीता॒रामि॒न्द्रं॑ । हा॒वे॑हवेसूहावंशू॒रामि॑न्द्रम् । हूवे॒नूशक्रं॒पू॑रुहूतामिन्द्रं । ई॒दंहा॒वि॒र्मा॑घा॓वावे॑त्विन्द्राः॑ ॥ २ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - इन्द्रस्यचत्रातम् ॥ इन्द्रस्त्रिष्टुबिन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;त्रा+++(क)+++तारमिन्द्र+++(षी)+++मविता+++(कि)+++रामी+++(टा)+++न्द्रा+++(त)+++म्। हावेहवेसू+++(षु)+++हावंशु+++(कि)+++रामी+++(टा)+++न्द्रा+++(त)+++म्। हूवाइनुशक्रं+++(षू)+++पुरूहू+++(कि)+++तामी+++(टा)+++न्द्रा+++(त)+++म्। ईदं+++(था)+++हावा+++(चा)+++इ+++(श)+++माघवावा+++(पी)+++इतूवा+++(खि)+++इ+++(श)+++। न्द्राः+++(त्र)+++ ॥ ३ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०३</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/4_asAvipAThaH/3_R-10_sA-18/03/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/4_asAvipAThaH/3_R-10_sA-18/03/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - विमद ऐन्द्र वसुकृद्वा वासुकः (प्रजापत्यो वा) इन्द्रः त्रिष्टुप्&lt;/summary&gt;&#xA;&lt;p&gt;या॒जा॒माहाइ॒न्द्रंव॒ज्रा॑दक्षिणं । हा॒री॑णांरथ्यां३वि॒व्रा॑तानाम् । प्र॓श्म॓श्रू॑भिर्दोधुवदू॒र्ध्वाधा॑भुवात् । वी॓से॓ना॑भिर्भा॒या॑मानोवीरा॒धा॑सा ॥ ३ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - वाक्तत्रतुरम् ॥ वृत्रतुरस्त्रिष्टुबिन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;यजामहो+++(ती)+++वा+++(त)+++। आइन्द्रंवा+++(की)+++ज्रादक्षा+++(टि)+++इणा+++(ता)+++म्। हारीणां+++(किच्)+++रथ्या+++(चा)+++विव्रता+++(टि)+++ना+++(त)+++म्। प्राश्मा+++(का)+++श्रूभिर्दोधूवा+++(टु)+++दूर्ध्वाधा+++(कि)+++भू+++(ख)+++वा+++(ण)+++त्। वीसा+++(चा)+++इनाभि+++(कि)+++र्भयमानो+++(भी)+++वा+++(प)+++इरा+++(शा)+++धा+++(ख)+++सो+++(प्ल)+++। हाइ+++(शा)+++ ॥ ४ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०४</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/4_asAvipAThaH/3_R-10_sA-18/04/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/4_asAvipAThaH/3_R-10_sA-18/04/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - वामदेवो गौतमः इन्द्रः त्रिष्टुप्&lt;/summary&gt;&#xA;&lt;p&gt;सत्रा॒हा॑णंदाधृ॑षिन्तूम्रामिन्द्रं॑ । मा॒हामा॑पारं॓वृ॑षाभं॒सूवा॒ज्र॑म् । हन्तायो॒वृत्रं॓सानीतोता॓वा॒जं॑ । दातामाघा॓नीमाघा॓वा॑सूरा॒धाः॑ ॥ ४ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - द्युतानस्य मारूतस्य सामनीद्वे ॥ द्वयोः धृषत्त्रिष्टुबिन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;सात्रा+++(फा)+++हणा+++(खा)+++औ+++(ण)+++हो+++(फ)+++वा+++(प्ल)+++। दाधृषीं+++(टि)+++तूम्रमीन्द्रा+++(टी)+++उवो+++(खा)+++वा+++(श)+++। मा+++(क)+++हामपा+++(कि)+++रंवृषाभं+++(की)+++सूवज्रा+++(टि)+++हन्ता+++(टा)+++यो+++(ख)+++वृ+++(ण)+++। त्रंसनितो+++(पी)+++तावा+++(खा)+++जा+++(त्र)+++म्। दाता+++(थाच्)+++मा+++(क)+++घानिमा+++(कि)+++घवा+++(टाच्)+++सूरा+++(का)+++धाः+++(टख्)+++ ॥ ५ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - द्युतानस्य मारूतस्य सामनीद्वे ॥ द्वयोः धृषत्त्रिष्टुबिन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;सात्रा+++(फा)+++हणन्दा+++(फि)+++धृषी+++(फा)+++इन्तूमृमी+++(खी)+++न्द्र+++(श)+++म्। मा+++(क)+++हामपा+++(कि)+++रं+++(क)+++वृषाभं+++(चि)+++सूवज्रा+++(टि)+++हन्तायो+++(खि)+++वृ+++(ण)+++। त्रंसनितो+++(पी)+++तावा+++(खा)+++जा+++(त्र)+++म्। दाता+++(थाच्)+++मा+++(क)+++घानिमा+++(कि)+++घवा+++(टाच्)+++सूरा+++(का)+++धाः+++(टख्)+++ ॥ ६ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०५</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/4_asAvipAThaH/3_R-10_sA-18/05/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/4_asAvipAThaH/3_R-10_sA-18/05/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - वामदेवो गौतमः इन्द्रः त्रिष्टुप्&lt;/summary&gt;&#xA;&lt;p&gt;यो॒नो॑वनूष्य॓न्ना॒भीदा॒तीमा॒र्क्त्याः॑ । ऊगणावा॓म॒न्यामानास्तुरो॒वा । क्षी॒धीयूधा॒शावा॑सावा॓ता॑मिन्द्राः॒ । आ॒भि॒ष्या॑मवृषामाणस्त्वोताः ॥ ५ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - आत्रम् ॥ अत्रिस्त्रिष्टुबिन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;योनोवनुष्य+++(षु)+++न्नभिदातिमा+++(खु)+++र्क्ताः+++(प्ल)+++। ऊगणावा+++(षी)+++मन्यमानास्तुरो+++(टू)+++वा+++(त)+++। क्षीधीयूधा+++(षी)+++शवसावा+++(की)+++तामा+++(टा)+++इन्द्रा+++(ता)+++म्। आभाइष्या+++(भी)+++मा+++(त)+++वृषमा+++(भि)+++णा+++(त)+++स्तुवो+++(टा)+++ताः+++(खण्)+++। ओ+++(प)+++इळा+++(प्ला)+++ ॥ ७ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०६</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/4_asAvipAThaH/3_R-10_sA-18/06/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/4_asAvipAThaH/3_R-10_sA-18/06/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - वामदेवो गौतमः इन्द्रः त्रिष्टुप्&lt;/summary&gt;&#xA;&lt;p&gt;यं॒वृत्रे॓षु॑क्षीता॒यास्प॒र्धा॒मानः । यं॒युक्तेषु॑तूरा॓य॑॑न्तोहा॒व॑न्ते । यं॒शू॒रा॑सातौयामापा॑मूपा॑ज्मन् । यंवि॒प्रा॑सो॑वाज॓यन्तेसइन्द्राः॑ ॥ ६ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - गृत्समदस्यसमिधौदौ ॥ द्वयोः गृत्समदस्त्रिष्टुबिन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;हाबुयंवृत्रेषू+++(तू)+++। क्षितयस्पर्धमा+++(खू)+++नाः+++(प्ल)+++। धामाना+++(कि)+++ई+++(ट)+++याइ+++(टा)+++या+++(ख)+++हाबुयंयुक्तेषु+++(शू)+++। तुरयन्तोहवा+++(खू)+++न्ताइ+++(शा)+++। हावान्ता+++(कि)+++ई+++(ट)+++याई+++(टा)+++या+++(ख)+++हाबुयंशूरसाः+++(शु)+++। तौयमपामुपा+++(खू)+++ज्मा+++(श)+++न्। ऊपाज्मा+++(की)+++नी+++(ट)+++याई+++(टा)+++या+++(ख)+++हाबुयंविप्रासाः+++(शू)+++। वाजयन्ताई+++(कु)+++सई+++(खा)+++न्द्राः+++(प्ल)+++। साइन्द्रो+++(कि)+++ई+++(ट)+++याई+++(टा)+++या+++(ख)+++हा+++(प्ल)+++उवा+++(शा)+++। ई+++(ख)+++ ॥ ८ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - गृत्समदस्यसमिधौदौ ॥ द्वयोः गृत्समदस्त्रिष्टुबिन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;यय्यया+++(ति)+++हाबुयंवृत्रेषू+++(तू)+++। क्षितयस्पर्धमा+++(खू)+++नाः+++(प्ल)+++। धामानायै+++(की)+++यय्यै+++(टा)+++यय्यया+++(चि)+++। यय्यया+++(ति)+++हाबुयंयुक्तेषू+++(तू)+++। तुरयन्तोहवा+++(खू)+++न्ताइ+++(शा)+++। हावन्तायै+++(की)+++यय्यै+++(टा)+++यय्यया+++(चि)+++। यय्यया+++(ति)+++हाबुयंशूरसाः+++(तू)+++। तौयमपामुपा+++(खू)+++ज्मा+++(श)+++न्। उपाज्मान्यै+++(की)+++यय्यै+++(टा)+++यय्यया+++(चि)+++। यय्यया+++(ति)+++हाबुयंविप्रासाः+++(तू)+++। वाजयन्ताई+++(कु)+++सई+++(खा)+++न्द्राः+++(प्ल)+++। साइन्द्रोयै+++(की)+++यय्यै+++(टा)+++यय्यया+++(ति)+++हाउवा+++(ति)+++। ई+++(ख)+++ ॥ ९ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०७</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/4_asAvipAThaH/3_R-10_sA-18/07/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/4_asAvipAThaH/3_R-10_sA-18/07/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - विश्वामित्रो गाथिनः इन्द्रः (पर्वतान्द्रौ) त्रिष्टुप्&lt;/summary&gt;&#xA;&lt;p&gt;इन्द्रा॑पर्वताबृहा॒तारा॒थेना । वा॒मी॒रीळआ॒वाहतंसूवी॒राः । वी॒तं॒हाव्या॓न्याध्वारेषुदेवाः॒ । वर्धेथांगीर्भि॓रिळा॑यामाद॑न्ताः ॥ ७ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - वैश्वामित्रम् ॥ विश्वामित्रस्त्रिष्टुबिन्द्रः ॥ (इन्द्रापर्वतौ वा) ॥&lt;/summary&gt;&#xA;&lt;p&gt;इन्द्रा+++(ता)+++हा+++(त)+++बु+++(श)+++। हा+++(क)+++होइपर्वता+++(षु)+++बृहतारथा+++(टू)+++इना+++(का)+++उवा+++(ता)+++। ऊ+++(ख)+++पा+++(श)+++। वामी+++(ता)+++र्हा+++(त)+++बु+++(श)+++। हा+++(क)+++होइष+++(षि)+++आवहतंसुवा+++(टू)+++इरा+++(का)+++उवा+++(ता)+++। ऊ+++(ख)+++पा+++(श)+++। वीतां+++(ता)+++हा+++(त)+++बु+++(श)+++। हा+++(क)+++होइहव्या+++(षी)+++न्यध्वारेषुदा+++(टु)+++इवा+++(का)+++उवा+++(ता)+++। ऊ+++(ख)+++पा+++(श)+++। वर्धे+++(ता)+++हा+++(त)+++बु+++(श)+++। हा+++(क)+++होथांगीर्भि+++(षी)+++रिळायामदा+++(टु)+++न्ताहाउवा+++(ती)+++। ऊऊ+++(खा)+++पा+++(श)+++ ॥ १० ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
