    <item>
      <title>०१</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/6_pavamAnapAThaH/04_R-14_sA-20/01/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/6_pavamAnapAThaH/04_R-14_sA-20/01/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - मेधातिथिः काण्वः पवमानः सोमः गायत्री&lt;/summary&gt;&#xA;&lt;p&gt;आ॒चिक्रादत्वृषाहा॒रीः॑ । माहा॒न्मित्रो॓ना ॓द॑र्शातः । संसू॒र्येणदिद्युते ॥ १ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - वार्षाहरम् ॥ वृषाहरिर्गायत्री सूर्यः ॥&lt;/summary&gt;&#xA;&lt;p&gt;अचिक्रदा+++(ती)+++दाची+++(काच्)+++क्रा+++(क)+++दा+++(ख)+++दचिक्रदादे+++(प्लु)+++। वृषाहरा+++(ती)+++इ+++(श)+++वार्षा+++(काच्)+++हा+++(क)+++रा+++(ख)+++इवृषाहराए+++(प्लू)+++। महान्मित्रो+++(ती)+++माहा+++(का)+++न्मि+++(क)+++त्रो+++(खा)+++महान्मित्राए+++(प्लु)+++। नदर्शता+++(ती)+++नाद+++(का)+++र्शा+++(क)+++ता+++(ख)+++नदर्शताए+++(प्लु)+++। संसूर्या+++(ति)+++इ+++(श)+++संसू+++(काच्)+++री+++(क)+++या+++(ख)+++इसंसूर्याए+++(प्ल)+++। णदिद्युता+++(ती)+++इ+++(श)+++णादी+++(काच्)+++द्यू+++(क)+++ता+++(ख)+++इणादा+++(शि)+++इद्युताबू+++(प्ली)+++। बा+++(श)+++ ॥ १ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०२</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/6_pavamAnapAThaH/04_R-14_sA-20/02/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/6_pavamAnapAThaH/04_R-14_sA-20/02/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - भृगुर्वारुणिर्जमदग्निर्भार्गवो वा पवमानः सोमः गायत्री&lt;/summary&gt;&#xA;&lt;p&gt;आ॒तेदक्षं॑मायोभू॒व॑म् । व॒न्ही॒मद्या॒वृ॑णीमहे॒ । पा॒न्तामा॓पू॑रूस्पृह॑म् ॥ २ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - वार्शानित्रीणि ॥ त्रयाणां वृशोगायत्री सोमः ॥&lt;/summary&gt;&#xA;&lt;p&gt;आतेदक्षा+++(ती)+++म्। मयोभू+++(भि)+++वा+++(त)+++म्। वन्हिमद्यावृणी+++(टू)+++मा+++(ख)+++हा+++(ण)+++इ+++(श)+++। पान्ता+++(का)+++माई+++(टा)+++या+++(त)+++। पूरूस्पृ+++(टिट्)+++हा+++(ख)+++औहोवा+++(शि)+++। उऊ+++(खा)+++पा+++(श)+++ ॥ २ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - वार्शानित्रीणि ॥ त्रयाणां वृशोगायत्री सोमः ॥&lt;/summary&gt;&#xA;&lt;p&gt;आतेदा+++(खि)+++क्षां+++(श)+++मायोभू+++(खि)+++व+++(ण)+++म्। वन्हिमद्यावृणि+++(फू)+++महो+++(खा)+++हाइ+++(शा)+++। पान्ता+++(टा)+++मा+++(त)+++ई+++(ट)+++या+++(त)+++पू+++(टट्)+++रू+++(ख)+++औहोवा+++(शि)+++। स्पृ+++(ख)+++ह+++(श)+++म् ॥ ३ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - वार्शानित्रीणि ॥ त्रयाणां वृशोगायत्री सोमः ॥&lt;/summary&gt;&#xA;&lt;p&gt;आतेदक्षम्मयो+++(फू)+++भुवां+++(खा)+++हाइ+++(शा)+++। वन्हिमद्यावृणी+++(फू)+++महो+++(खा)+++हाइ+++(शा)+++। पान्ता+++(या)+++मा+++(ट)+++पूरू+++(का)+++स्पृहामीळा+++(टी)+++भा+++(खण्)+++। ओ+++(प)+++इळा+++(शा)+++ ॥ ४ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०३</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/6_pavamAnapAThaH/04_R-14_sA-20/03/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/6_pavamAnapAThaH/04_R-14_sA-20/03/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - उचथ्य आङ्गिरसः पवमानः सोमः गायत्री&lt;/summary&gt;&#xA;&lt;p&gt;अ॓ध्व॑र्योआ॒द्री॑भीस्सूतं । सो॓मं॑पावी॒त्रा॒आ॒नाया । पुनाही॓न्द्रा॑यापा॒ता॑वे ॥ ३ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - वैरूपेचदेवानांवाञ्जसायिनी ॥ द्वयोरिन्द्रो गायत्री सोमः ॥&lt;/summary&gt;&#xA;&lt;p&gt;अध्वर्यो+++(पि)+++आ+++(ण)+++। द्रिभाइस्सू+++(भी)+++तां+++(त)+++सोमं+++(का)+++पा+++(ख)+++वी+++(ण)+++। त्राआ+++(या)+++नाया+++(टा)+++। पुना+++(टा)+++हीन्द्रा+++(खा)+++औहोवा+++(शि)+++। यापाता+++(टि)+++वे+++(ख)+++ ॥ ५ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - वैरूपेचदेवानांवाञ्जसायिनी ॥ द्वयोरिन्द्रो गायत्री सोमः ॥&lt;/summary&gt;&#xA;&lt;p&gt;अध्वर्यो+++(षि)+++औहोअद्रीभीः+++(तु)+++। सू+++(च)+++तमौ+++(टा)+++हो+++(त)+++वा+++(त)+++इ+++(श)+++सोमं+++(का)+++पा+++(ख)+++वी+++(ण)+++। ओइत्राया+++(यी)+++नाया+++(टा)+++। पुनाहा+++(टिट्)+++इन्द्रा+++(खा)+++औहोवा+++(शि)+++। ए+++(तच्)+++या+++(क)+++पाता+++(टा)+++वे+++(ख)+++ ॥ ६ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०४</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/6_pavamAnapAThaH/04_R-14_sA-20/04/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/6_pavamAnapAThaH/04_R-14_sA-20/04/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - अवत्सारः काश्यपः पवमानः सोमः गायत्री&lt;/summary&gt;&#xA;&lt;p&gt;ता॒रत्सा॒मन्दीधा॑वती । धा॓रासूतस्या॒न्धा॑सः । ता॒रत्सा॒मन्दीधावती ॥ ४ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - तरन्तस्यचवैददश्वेस्साम ॥ तरन्तो गायत्री सोमः ॥&lt;/summary&gt;&#xA;&lt;p&gt;तरत्समा+++(ती)+++न्दी+++(त)+++धावा+++(या)+++ता+++(ट)+++इ+++(श)+++। धारा+++(टा)+++सू+++(ख)+++ता+++(ण)+++। स्यान्धा+++(टाट्)+++सा+++(ख)+++औहोवा+++(शि)+++। तारत्समन्दीधा+++(कु)+++वती+++(खी)+++ ॥ ७ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०५</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/6_pavamAnapAThaH/04_R-14_sA-20/05/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/6_pavamAnapAThaH/04_R-14_sA-20/05/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - निध्रुविः काश्यपः पवमानः सोमः गायत्री&lt;/summary&gt;&#xA;&lt;p&gt;आ॒पा॑वस्वा॒साहास्री॒णं । रा॒यिंसो॑मासूवी॒र्यम् । अस्मेश्रा॒वां॓सिधारया ॥ ५ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - सोमसामच ॥ सोमा गायत्री सोमः ॥&lt;/summary&gt;&#xA;&lt;p&gt;आपवस्वा+++(ती)+++। सा+++(च)+++हस्रिणां+++(टि)+++हुवा+++(टा)+++इहुवा+++(टि)+++हो+++(च)+++इ+++(श)+++। रयिं+++(का)+++सोमा+++(का)+++सुवीर्यां+++(टि)+++हुवा+++(टा)+++इहुवा+++(टि)+++हो+++(च)+++इ+++(श)+++। अस्मै+++(था)+++श्रवांसिधा+++(की)+++राया+++(टा)+++हुवा+++(टा)+++इहुवा+++(टि)+++हो+++(टट्)+++या+++(ख)+++औहोवा+++(शि)+++। ऊ+++(ख)+++पा+++(श)+++ ॥ ८ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०६</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/6_pavamAnapAThaH/04_R-14_sA-20/06/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/6_pavamAnapAThaH/04_R-14_sA-20/06/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - असितः काश्यपो देवलो वा पवमानः सोमः गायत्री&lt;/summary&gt;&#xA;&lt;p&gt;आनूप्रत्ना॓सा॑आया॒वाः॑ । पादन्ना॒वी॑योअक्रमुः । रुचे॒ज॑नान्तासूर्य॑म् ॥ ६ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - सूर्यसामच ॥ सूर्यो गायत्री सोमः ॥&lt;/summary&gt;&#xA;&lt;p&gt;आनुप्रत्ना+++(षी)+++सआया+++(ति)+++वाः+++(त)+++। पादन्नवी+++(षी)+++योअक्रमूः+++(ची)+++। रूचेजनान्ता+++(पु)+++सू+++(श)+++हिम्माए+++(भि)+++। री+++(ख)+++य+++(श)+++म् ॥ ९ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०७</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/6_pavamAnapAThaH/04_R-14_sA-20/07/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/6_pavamAnapAThaH/04_R-14_sA-20/07/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - भृगुर्वारुणिर्जमदग्निर्भार्गवो वा पवमानः सोमः गायत्री&lt;/summary&gt;&#xA;&lt;p&gt;अ॑र्षासोमा॒धूमात्ता॑मः । आभीद्रो॓णा॑नीरो॒रूवात् । सी॒दन्यो॒नौवा॒नेष्वा ॥ ७ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - दार्ढ्यच्युतानित्रीणि ॥ त्रयाणां दृढच्युतिर्गायत्री सोमः ॥&lt;/summary&gt;&#xA;&lt;p&gt;आर्षा+++(चा)+++इहा+++(शा)+++। सोमाद्युमा+++(टी)+++क्तामा+++(चा)+++इहा+++(शा)+++। आभा+++(चा)+++इ+++(श)+++इहा+++(चा)+++। द्रोणानिरो+++(टीच्)+++रू+++(क)+++वा+++(च)+++दिहा+++(शा)+++। सी+++(क)+++दा+++(च)+++निहा+++(शा)+++। योनौवना+++(टीच्)+++इ+++(श)+++षूवा+++(चा)+++इहा+++(शा)+++ ॥ १० ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - दार्ढ्यच्युतानित्रीणि ॥ त्रयाणां दृढच्युतिर्गायत्री सोमः ॥&lt;/summary&gt;&#xA;&lt;p&gt;आर्षा+++(का)+++हा+++(त)+++बु+++(श)+++। सोमद्युमक्तमो+++(षू)+++अभिद्रो+++(टि)+++णा+++(त)+++निरोऔ+++(भि)+++हो+++(त)+++रूवा+++(टा)+++त्सीदाउवा+++(ती)+++। योनौवा+++(पि)+++ने+++(श)+++हिम्माए+++(भि)+++। षू+++(ख)+++वा+++(श)+++ ॥ ११ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - दार्ढ्यच्युतानित्रीणि ॥ त्रयाणां दृढच्युतिर्गायत्री सोमः ॥&lt;/summary&gt;&#xA;&lt;p&gt;अर्षासोमाद्युमा+++(फू)+++क्तमो+++(खा)+++अर्षासोमा+++(शी)+++। द्युमक्तमो+++(की)+++अभिद्रो+++(कि)+++णा+++(ट)+++हा+++(त)+++हा+++(त)+++इ+++(श)+++। नीरो+++(चा)+++रूवत्सा+++(कि)+++इदन्योनौ+++(टी)+++हा+++(त)+++हा+++(त)+++इ+++(श)+++। वानाइषु+++(टी)+++वा+++(खण्)+++। ओ+++(प)+++इळा+++(शा)+++ ॥ १२ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०८</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/6_pavamAnapAThaH/04_R-14_sA-20/08/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/6_pavamAnapAThaH/04_R-14_sA-20/08/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - कश्यपो मारीचः पवमानः सोमः गायत्री&lt;/summary&gt;&#xA;&lt;p&gt;वृ॒षा॑सोमाधूमंआ॑सी । वृषा॒देवावृ॒षाव्रा॑तः । वृषाध॒र्मा॑णिदध्री॒षे॒ ॥ ८ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - इन्द्रस्यचवृषकम् ॥ इन्द्रो गायत्री सोमः ॥&lt;/summary&gt;&#xA;&lt;p&gt;वृषासोमा+++(ती)+++। द्यूमं+++(चा)+++आ+++(य)+++सा+++(ट)+++इ+++(श)+++। वृषादाइवो+++(टु)+++हा+++(त)+++इ+++(श)+++वार्षा+++(का)+++व्रा+++(ख)+++ताः+++(ण)+++। वृषाधर्मा+++(की)+++इ+++(ट)+++या+++(त)+++। णाइद+++(कि)+++द्रिषाइळा+++(टी)+++भा+++(खण्)+++। ओ+++(प)+++इळा+++(शा)+++ ॥ १३ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०९</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/6_pavamAnapAThaH/04_R-14_sA-20/09/</link>
