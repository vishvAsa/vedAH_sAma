    <item>
      <title>०१</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/6_pavamAnapAThaH/07_R-12_sA-21/01/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/6_pavamAnapAThaH/07_R-12_sA-21/01/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - प्रतर्दनो दैवोदासिः पवमानः सोमः त्रिष्टुप्&lt;/summary&gt;&#xA;&lt;p&gt;प्रा॓से॑नानी॒श्शू॒रोअ॒ग्रे॒राथा॑नाम् । गव्य॓न्ने॑तीह॒र्षातेअस्या॒से॒ना॑भद्रान्कृण्वान्निन्द्राहावान्सा॒खी॑भ्यः । आसोमोवा॒स्त्रा॑राभासा॒नी॑दक्ते ॥ १ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - कूत्सस्याधिरथ्यानित्रीणि ॥ त्रयाणां कुत्सस्त्रिष्टुप्सोमः ॥&lt;/summary&gt;&#xA;&lt;p&gt;हो+++(ख)+++वा+++(श)+++उहुवाहो+++(खि)+++वा+++(ण)+++। प्रासेना+++(कि)+++नाइश्शूरो+++(टि)+++अग्राइरथा+++(खु)+++ना+++(श)+++म्। गव्यन्ने+++(कि)+++ताइहर्षाते+++(टु)+++आस्यसे+++(खि)+++ना+++(श)+++। भाद्रान्कृ+++(कि)+++ण्वन्निन्द्राहा+++(की)+++वान्साखी+++(खि)+++भ्याः+++(प्ल)+++। आसोमो+++(कि)+++वास्त्रा+++(टा)+++रभसा+++(कि)+++निदा+++(खा)+++क्ता+++(त्र)+++इ+++(श)+++। हो+++(ख)+++वा+++(श)+++उहुवाहो+++(खी)+++वाहा+++(प्ला)+++बु+++(श)+++। बा+++(श)+++ ॥ १ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - कूत्सस्याधिरथ्यानित्रीणि ॥ त्रयाणां कुत्सस्त्रिष्टुप्सोमः ॥&lt;/summary&gt;&#xA;&lt;p&gt;औहो+++(फा)+++ओ+++(त)+++वा+++(त)+++। प्रासेना+++(कि)+++नाइश्शूरो+++(टी)+++अग्राइरथा+++(खु)+++ना+++(श)+++म। गव्यन्ने+++(कि)+++ताइहर्षाते+++(टु)+++आस्यसे+++(खि)+++ना+++(श)+++। भाद्रान्कृ+++(कि)+++ण्वन्निन्दराहा+++(की)+++वान्साखी+++(खि)+++भ्याः+++(प्ल)+++। औहो+++(फा)+++ओ+++(त)+++वा+++(त)+++। आसोमो+++(कि)+++वास्त्रा+++(टा)+++रभसा+++(पि)+++निदा+++(खा)+++। क्ता+++(त्र)+++इ+++(श)+++ ॥ २ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - कूत्सस्याधिरथ्यानित्रीणि ॥ त्रयाणां कुत्सस्त्रिष्टुप्सोमः ॥&lt;/summary&gt;&#xA;&lt;p&gt;ओहो+++(फा)+++ओ+++(त)+++वा+++(त)+++। प्रा+++(क)+++सेना+++(था)+++नाइश्शूरो+++(टी)+++अग्राइराथा+++(खु)+++ना+++(श)+++म। ग+++(क)+++व्यन्ने+++(था)+++ताइहर्षाते+++(टु)+++आस्यसे+++(खि)+++ना+++(श)+++। भा+++(क)+++द्रान्कृ+++(था)+++ण्वन्निन्द्राहा+++(टी)+++वान्साखी+++(खि)+++भ्याः+++(प्ल)+++। ओहो+++(फा)+++ओ+++(त)+++वा+++(त)+++। आ+++(क)+++सोमो+++(था)+++वास्त्रा+++(टा)+++रभसा+++(पि)+++निदा+++(खाणफप्ल)+++। क्ता+++(ख)+++इ+++(श)+++ ॥ ३ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०२</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/6_pavamAnapAThaH/07_R-12_sA-21/02/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/6_pavamAnapAThaH/07_R-12_sA-21/02/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - पराशरः शाक्त्यः पवमानः सोमः त्रिष्टुप्&lt;/summary&gt;&#xA;&lt;p&gt;प्रातेधा॒रामा॒धू॑मतिरसृगृन् । वा॒रंय॒त्पूतोअत्ये॒ष॒व्यम् । पा॒वा॑मानापा॓वा॑सेधा॒मागोना॑म् । ज॒ना॒यन्सू॒र्या॑मपिन्वोअर्कैः॒ ॥ २ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - वैश्वज्योतिषाणित्रीणि ॥ त्रयाणां विश्वज्योतिस्त्रिष्टुप्सूर्यः ॥&lt;/summary&gt;&#xA;&lt;p&gt;हाबुहो+++(ति)+++हाइ+++(शा)+++प्रतेधारामा+++(भु)+++धू+++(च)+++मा+++(क)+++ताइरसृग्रा+++(टु)+++न्। हाबुहो+++(ति)+++हाइवारं+++(षी)+++यत्पूतोआती+++(चु)+++याइषीयाव्या+++(टु)+++म। हाबुहो+++(ति)+++हाइ+++(शा)+++पवमानपा+++(चु)+++वसे+++(का)+++धामगोना+++(टी)+++म्। हाबुहो+++(ति)+++हाइ+++(शा)+++जनयन्सूर्या+++(चु)+++मा+++(क)+++पाइन्वोअर्काइः+++(टू)+++। हाबुहो+++(खि)+++हा+++(प्ल)+++बु+++(श)+++। बा+++(श)+++ ॥ ४ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०३</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/6_pavamAnapAThaH/07_R-12_sA-21/03/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/6_pavamAnapAThaH/07_R-12_sA-21/03/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - इन्द्रप्रमतिर्वासिष्ठः पवमानः सोमः त्रिष्टुप्&lt;/summary&gt;&#xA;&lt;p&gt;प्रा॒गा॑यताभ्या॑र्चामादेवा॒न् । सो॒मं॑हिनोतामाहातेधाना॑॑या । स्वादुः॒पा॑वातामा॒तीवा॒रामा॒व्यम् । आ॒सी॑दतुकालाश॑न्देव॒इ॒न्दूः॑ ॥ ३ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - वैश्वज्योतिषाणित्रीणि ॥ त्रयाणां विश्वज्योतिस्त्रिष्टुप्सूर्यः ॥&lt;/summary&gt;&#xA;&lt;p&gt;प्रागायता+++(टी)+++भ्यार्च्चा+++(का)+++मदे+++(खा)+++वा+++(श)+++न्। सो+++(क)+++मंहिनोता+++(टी)+++माहाते+++(कि)+++धना+++(खा)+++या+++(श)+++। स्वा+++(क)+++दुःपवाता+++(टी)+++मातीवा+++(कि)+++रमा+++(खा)+++व्य+++(श)+++म्। आ+++(क)+++सीदतू+++(कि)+++कालशान्दा+++(पी)+++इवाया+++(खि)+++इ+++(श)+++। न्दूः+++(त्र)+++ ॥ ५ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०४</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/6_pavamAnapAThaH/07_R-12_sA-21/04/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/6_pavamAnapAThaH/07_R-12_sA-21/04/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - वसिष्ठो मैत्रावरुणिः पवमानः सोमः त्रिष्टुप्&lt;/summary&gt;&#xA;&lt;p&gt;प्राहि॒न्वानो॓ज॑नीतारो॒दस्योः । रा॒थोनवा॒जं॑सानीष॒न्ना॑यासीत् । इ॒न्द्रं॑गच्छन्ना॒यु॑धासंशी॒शा॑नाः । वि॒श्वा॑वा॑सूहा॒स्ता॑योरादधा॑नः ॥ ४ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - वैश्वज्योतिषाणित्रीणि ॥ त्रयाणां विश्वज्योतिस्त्रिष्टुप्सूर्यः ॥&lt;/summary&gt;&#xA;&lt;p&gt;हाबुहो+++(ति)+++हाइ+++(शा)+++प्रहिन्वानो+++(षी)+++जनितारो+++(खी)+++दसी+++(खा)+++योः+++(प्ल)+++। हाबुहो+++(ति)+++हाइ+++(शा)+++रथोनवाजं+++(षु)+++सनिषा+++(खि)+++न्नया+++(खा)+++सी+++(श)+++त्। हाबुहो+++(ति)+++हाइ+++(शा)+++इन्द्रङ्गच्छ+++(षी)+++न्नायुधासां+++(खी)+++शिशा+++(खा)+++नाः+++(प्ल)+++। हाबुहो+++(ति)+++हाइ+++(शा)+++विश्वावसु+++(षी)+++हस्तयोरा+++(खी)+++दधा+++(खा)+++नाः+++(प्ल)+++। दधा+++(खा)+++ना+++(प्ल)+++बु+++(श)+++। बा+++(श)+++ ॥ ६ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०५</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/6_pavamAnapAThaH/07_R-12_sA-21/05/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/6_pavamAnapAThaH/07_R-12_sA-21/05/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - कर्णश्रुद्वासिष्ठः पवमानः सोमः त्रिष्टुप्&lt;/summary&gt;&#xA;&lt;p&gt;त॒क्षद्या॒दिमा॑नासावेना॑तोवा॒क् । ज्येष्ठा॑स्यधर्मन्द्यूक्षोरानी॑के । आ॓दी॑मायन्वा॒रामा॒वावाशानः॒ । जुष्टंपा॓तिं॑कालाशेगा॒वइ॒न्दुम् ॥ ५ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - वाचस्सामनीद्वे ॥ द्वयोः वाक्रिष्टुप्वाक्सोमौ ॥&lt;/summary&gt;&#xA;&lt;p&gt;ताक्षा+++(फा)+++द्यादी+++(फा)+++हो+++(फ)+++इमना+++(णि)+++सावेनतो+++(फी)+++वा+++(फ)+++क्। ज्येष्ठा+++(फा)+++स्याधा+++(फा)+++हो+++(फ)+++र्म्म+++(ण)+++द्युक्षोरनी+++(फी)+++का+++(फ)+++इ+++(श)+++। आदी+++(फा)+++माया+++(फा)+++न्हो+++(फ)+++इवरा+++(णि)+++मावावशा+++(फी)+++नाः+++(फ)+++। जूष्टं+++(फा)+++पातीं+++(फा)+++हो+++(फ)+++इङ्कलशेगा+++(प्लु)+++वइन्दाबु+++(शी)+++। बा+++(श)+++ ॥ ७ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - वाचस्सामनीद्वे ॥ द्वयोः वाक्रिष्टुप्वाक्सोमौ ॥&lt;/summary&gt;&#xA;&lt;p&gt;तक्षाद्यादा+++(की)+++ओ+++(प)+++इमना+++(णि)+++सावेनतो+++(फी)+++वा+++(त)+++क्। ज्येष्ठास्याधा+++(की)+++ओ+++(प)+++र्म्म+++(ण)+++द्युक्षोरनी+++(फी)+++का+++(त)+++इ+++(श)+++। आ+++(क)+++दाइमाया+++(की)+++ओ+++(प)+++न्वरा+++(णा)+++मावावशा+++(फी)+++नाः+++(त)+++। जुष्टम्पाता+++(की)+++ओ+++(प)+++इङ्कलशेगा+++(प्लु)+++वइन्दाबु+++(शी)+++। बा+++(श)+++ ॥ ८ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०६</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/6_pavamAnapAThaH/07_R-12_sA-21/06/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/6_pavamAnapAThaH/07_R-12_sA-21/06/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - नोधा गौतमः पवमानः सोमः त्रिष्टुप्&lt;/summary&gt;&#xA;&lt;p&gt;सा॒कामु॒क्षोमर्जयन्तस्वासा॑रः । दशधीरा॑स्याधीता॒योधा॒नूत्रीः । हा॒रीःप॒र्याद्रावार्जस्सू॒र्या॑स्या । द्रो॒ण॒न्ननक्षेअत्योना॒वाजी ॥ ६ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - दाशस्पत्यानिषट् ॥ द्वयोर्दशस्पतिस्त्रिष्टुप्सूर्यः ॥ चतुर्णा दशस्पतिस्त्रिष्टुप्सूर्यसोमेन्द्राः सोमेन्द्रौ वा ॥&lt;/summary&gt;&#xA;&lt;p&gt;साका+++(ता)+++म्। उक्षो+++(षा)+++मर्जयन्तस्वा+++(कु)+++सा+++(ट)+++राः+++(त)+++। दाशा+++(टा)+++धीरस्यधीतयो+++(कू)+++धानू+++(टा)+++त्रीः+++(त)+++। हारी+++(टा)+++पर्यद्रवज्जा+++(कु)+++स्सूर्या+++(टा)+++स्या+++(त)+++। द्रोणा+++(टाच्)+++न्ना+++(क)+++नक्षेअत्येनवा+++(टू)+++हाउवा+++(ति)+++। जी+++(ख)+++ ॥ ९ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०७</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/6_pavamAnapAThaH/07_R-12_sA-21/07/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/6_pavamAnapAThaH/07_R-12_sA-21/07/</guid>
