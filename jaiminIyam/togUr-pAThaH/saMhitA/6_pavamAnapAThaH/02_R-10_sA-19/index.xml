    <item>
      <title>०१</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/6_pavamAnapAThaH/02_R-10_sA-19/01/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/6_pavamAnapAThaH/02_R-10_sA-19/01/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - (कविर्मेधावी) श्यावाश्वः आत्रेयः पवमानः सोमः गायत्री&lt;/summary&gt;&#xA;&lt;p&gt;प्र॓सो॓मासोमादच्यू॒ताः । श्रा॒वा॑सेनोमा॑घो॒नां॑ । सू॒तावीद॒थेअक्रमुः ॥ १ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - सौभरेद्वे ॥ द्वयोः सुभरिर्गायत्री सोमः ॥&lt;/summary&gt;&#xA;&lt;p&gt;प्रसोमा+++(खि)+++साः+++(ण)+++। मदच्यू+++(चि)+++ताऔ+++(टा)+++हो+++(त)+++वा+++(त)+++इश्रवा+++(टि)+++सा+++(ख)+++इनाः+++(णा)+++। ओइमघोना+++(टु)+++म्। सूतावा+++(टिट्)+++इदा+++(खा)+++औहोवा+++(शि)+++। थेअक्रमूः+++(खी)+++ ॥ १ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०२</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/6_pavamAnapAThaH/02_R-10_sA-19/02/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/6_pavamAnapAThaH/02_R-10_sA-19/02/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - त्रित आप्त्यः पवमानः सोमः गायत्री&lt;/summary&gt;&#xA;&lt;p&gt;प्र॒सो॒मा॑सोवीपश्ची॒ताः॑ । आ॒पो॑नायन्ताऊर्म॑याः॑ । वाना॒नी॑माहीषा॑ईवा ॥ २ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - सौभरेद्वे ॥ द्वयोः सुभरिर्गायत्री सोमः ॥&lt;/summary&gt;&#xA;&lt;p&gt;प्रसोमासाः+++(ती)+++। वाइपाश्ची+++(की)+++ता+++(श)+++आ+++(च)+++पो+++(य)+++नाया+++(टा)+++न्ताऊर्मयो+++(की)+++वा+++(च)+++ना+++(य)+++निमा+++(टा)+++ओऔ+++(का)+++हो+++(त)+++। हिषाई+++(चि)+++वाइळा+++(टि)+++भा+++(खण्)+++। ओ+++(प)+++इळा+++(शा)+++ ॥ २ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०३</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/6_pavamAnapAThaH/02_R-10_sA-19/03/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/6_pavamAnapAThaH/02_R-10_sA-19/03/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - अमहीयुराङ्गिरसः पवमानः सोमः गायत्री&lt;/summary&gt;&#xA;&lt;p&gt;पा॒वा॑स्वेन्दोवृ॓षा॑सूतः । कृ॒धी॓नोयाशासोजने । विश्वा॒आप॒द्वी॒षो॑जहि ॥ ३ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - इन्द्रस्यवृषकाणित्रिणि ॥ त्रयाणामिन्द्रो गायत्री सोमः ॥&lt;/summary&gt;&#xA;&lt;p&gt;पवस्वेन्दो+++(फी)+++वृषा+++(शा)+++सुताः+++(का)+++। कृधीनोयशसो+++(षु)+++जनाए+++(पि)+++वाइश्वायापा+++(शु)+++। द्वा+++(ट)+++इषा+++(खा)+++औहोवा+++(शि)+++। जा+++(ख)+++हि+++(श)+++ ॥ ३ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०४</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/6_pavamAnapAThaH/02_R-10_sA-19/04/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/6_pavamAnapAThaH/02_R-10_sA-19/04/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - भृगुर्वारुणिर्जमदग्निर्भार्गवो वा पवमानः सोमः गायत्री&lt;/summary&gt;&#xA;&lt;p&gt;वृषाह्या॓सी॑भानु॒ना । द्यु॒मन्तं॑त्वाहवामहे । पा॒वा॑मानास्वर्दृ॒श॑म् ॥ ४ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - इन्द्रस्यवृषकाणित्रिणि ॥ त्रयाणामिन्द्रो गायत्री सोमः ॥&lt;/summary&gt;&#xA;&lt;p&gt;वृषाहिया+++(ती)+++। सिभानू+++(भि)+++ना+++(त)+++। द्युमन्तत्वाहवा+++(यू)+++माहा+++(पा)+++इपावा+++(ति)+++। मानासुवो+++(टी)+++ओ+++(प)+++बा+++(श)+++। दृ+++(ख)+++श+++(श)+++म् ॥ ४ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - इन्द्रस्यवृषकाणित्रिणि ॥ त्रयाणामिन्द्रो गायत्री सोमः ॥&lt;/summary&gt;&#xA;&lt;p&gt;वृषाहिया+++(फी)+++सिभानुना+++(की)+++। द्युमन्तन्त्वा+++(टी)+++हवामहे+++(की)+++होवा+++(का)+++औ+++(ट)+++होवा+++(का)+++। पावमा+++(टि)+++ना+++(च)+++सुवदृशं+++(टी)+++होवा+++(का)+++औ+++(ट)+++होवा+++(का)+++। हूवो+++(खा)+++इळा+++(प्ला)+++ ॥ ५ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०५</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/6_pavamAnapAThaH/02_R-10_sA-19/05/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/6_pavamAnapAThaH/02_R-10_sA-19/05/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - पवमानः सोमः गायत्री&lt;/summary&gt;&#xA;&lt;p&gt;इ॒न्दूः॑पविष्टाचे॒तानः । प्रीयः॓का॑वीना॒म्मातिः । सृजद॓श्वं॑राथिरिव ॥ ५ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - बभ्रोःकुम्भस्यसामानित्रीणि ॥ कौम्भ्यस्य वा । त्रयाणां बभ्रुर्गायत्री सोमः ॥&lt;/summary&gt;&#xA;&lt;p&gt;इन्दू+++(खा)+++रौहोवाहाइपावी+++(शृ)+++। ष्टचा+++(टा)+++ईतनो+++(खि)+++हा+++(ण)+++इ+++(श)+++। हा+++(क)+++होए+++(टा)+++हो+++(ट)+++वा+++(त)+++। प्रीयाःकवी+++(की)+++नाम्मतिरो+++(पी)+++हा+++(ण)+++इ+++(श)+++। हा+++(क)+++होए+++(टा)+++हो+++(ट)+++वा+++(त)+++। सृजा+++(टा)+++दश्वां+++(खा)+++हा+++(ण)+++इ+++(श)+++। हा+++(क)+++होए+++(टा)+++हो+++(ट)+++वा+++(त)+++। रा+++(ट)+++था+++(ख)+++औहोवा+++(शि)+++। ई+++(ख)+++वा+++(श)+++ ॥ ६ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - बभ्रोःकुम्भस्यसामानित्रीणि ॥ कौम्भ्यस्य वा । त्रयाणां बभ्रुर्गायत्री सोमः ॥&lt;/summary&gt;&#xA;&lt;p&gt;इन्दुःपविष्टचे+++(षू)+++तनःप्रियःकवा+++(तू)+++इ+++(श)+++। हिं+++(ट)+++हिन्नाम्मा+++(खि)+++तीः+++(ण)+++। सृजदा+++(पि)+++श्वा+++(श)+++म्। हिं+++(ट)+++हिं+++(त)+++रा+++(टट्)+++था+++(ख)+++औहोवा+++(शि)+++। ई+++(ख)+++वा+++(श)+++ ॥ ७ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - बभ्रोःकुम्भस्यसामानित्रीणि ॥ कौम्भ्यस्य वा । त्रयाणां बभ्रुर्गायत्री सोमः ॥&lt;/summary&gt;&#xA;&lt;p&gt;इन्दुःपविष्टचेतनःप्रियःकवि+++(षो)+++नाम्मतिंसृजा+++(तु)+++दश्वां+++(ता)+++। ओवा+++(का)+++ओवा+++(का)+++रा+++(टट्)+++था+++(ख)+++औहोवा+++(शि)+++। ई+++(ख)+++वा+++(श)+++ ॥ ८ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०६</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/6_pavamAnapAThaH/02_R-10_sA-19/06/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/6_pavamAnapAThaH/02_R-10_sA-19/06/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - कश्यपो मारीचः पवमानः सोमः गायत्री&lt;/summary&gt;&#xA;&lt;p&gt;आ॒सृक्षातप्रावाजी॒नाः । गव्या॒सोमा॑सोआश्वाया॒ । शुक्रा॒सो॑वीराया॒शा॒वाः॒ ॥ ६ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - बभ्रोःकार्तवेशानित्रीणि ॥ त्रयाणां कृतवेशोगायत्री सोमः ॥&lt;/summary&gt;&#xA;&lt;p&gt;असृक्षाता+++(खी)+++प्रा+++(श)+++वाजीनाः+++(प्लि)+++। गव्या+++(टा)+++सोमा+++(टा)+++सो+++(त)+++आश्वया+++(चि)+++। शुक्रा+++(टा)+++सोवी+++(टा)+++रया+++(काच्)+++शा+++(क)+++वओ+++(पा)+++इळा+++(शा)+++ ॥ ९ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - बभ्रोःकार्तवेशानित्रीणि ॥ त्रयाणां कृतवेशोगायत्री सोमः ॥&lt;/summary&gt;&#xA;&lt;p&gt;असृक्षताप्रा+++(तु)+++वाजीनाः+++(ति)+++। गव्यासोमासो+++(षु)+++आश्वया+++(टि)+++हो+++(च)+++इ+++(श)+++। शुक्रा+++(ता)+++सोवा+++(टा)+++हो+++(च)+++इ+++(श)+++। रा+++(क)+++याशा+++(टाट्)+++वा+++(ख)+++औहोवा+++(शि)+++। ग्वा+++(ख)+++भीः+++(श)+++ ॥ १० ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - बभ्रोःकार्तवेशानित्रीणि ॥ त्रयाणां कृतवेशोगायत्री सोमः ॥&lt;/summary&gt;&#xA;&lt;p&gt;असृक्षत+++(षी)+++प्रवाजिनए+++(खु)+++गव्यासोमा+++(शी)+++। सो+++(त)+++आश्वा+++(पा)+++या+++(श)+++। शुक्रा+++(टा)+++सो+++(ख)+++वी+++(ण)+++। रा+++(क)+++यो+++(प)+++बा+++(प्ल)+++शावो+++(प्ला)+++। हाइ+++(शा)+++ ॥ ११ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०७</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/6_pavamAnapAThaH/02_R-10_sA-19/07/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/6_pavamAnapAThaH/02_R-10_sA-19/07/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - निध्रुविः काश्यपः पवमानः सोमः गायत्री&lt;/summary&gt;&#xA;&lt;p&gt;पा॒वा॑स्वादेवा॓आयूषा॑त् । इन्द्रं॑गच्छतूतेमादाः॑ । वायुमा॓रो॑हाध॒र्मा॑णा ॥ ७ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - शार्म्मदे द्वे ॥ द्वयोः शम्मद्गायत्रीन्द्रवायू ॥&lt;/summary&gt;&#xA;&lt;p&gt;पावास्वादे+++(ती)+++। वया+++(ता)+++वा+++(ट)+++या+++(ख)+++औहोवा+++(शि)+++। यू+++(ख)+++षागाइन्द्रङ्गच्छा+++(शू)+++। तुता+++(ता)+++इतु+++(टा)+++ता+++(ख)+++औहोवा+++(शि)+++। मा+++(ख)+++दाः+++(प्ल)+++। वायूं+++(टाच्)+++हो+++(य)+++आ+++(ट)+++रो+++(त)+++। हधा+++(ता)+++हा+++(ट)+++धा+++(ख)+++औहोवा+++(शि)+++। र्म्मा+++(ख)+++णा+++(श)+++ ॥ १२ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - शार्म्मदे द्वे ॥ द्वयोः शम्मद्गायत्रीन्द्रवायू ॥&lt;/summary&gt;&#xA;&lt;p&gt;पवस्वदेवा+++(फु)+++ऐहिऐही+++(खी)+++या+++(श)+++। आयुषागै+++(टी)+++हीऐ+++(टा)+++ही+++(ट)+++या+++(त)+++। इन्द्रङ्गच्छ+++(षी)+++न्तुतेमदाऐ+++(टु)+++हीऐ+++(टा)+++ही+++(ट)+++या+++(त)+++। वायूमारो+++(की)+++ओहा+++(का)+++धो+++(प)+++बा+++(प्ल)+++र्म्माणो+++(प्ला)+++। हाइ+++(शा)+++ ॥ १३ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०८</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/6_pavamAnapAThaH/02_R-10_sA-19/08/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
