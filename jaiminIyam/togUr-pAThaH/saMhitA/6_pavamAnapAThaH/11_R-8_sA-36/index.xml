    <item>
      <title>०१</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/6_pavamAnapAThaH/11_R-8_sA-36/01/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/6_pavamAnapAThaH/11_R-8_sA-36/01/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - गौरवीतिः शाक्स्यः पवमानः सोमः ककुप&lt;/summary&gt;&#xA;&lt;p&gt;पा॓वा॑स्वामा॒धू॑मक्तमः । इन्द्रा॑यसोमक्रातूवि॓क्ता॑मोमा॒दाः॑ । मा॒हिद्युक्षा॒तामोमा॒दाः॑ ॥ १ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - वासिष्ठेद्वे ॥ वसिष्ठः ककुप्सोमः ॥&lt;/summary&gt;&#xA;&lt;p&gt;पावा+++(ता)+++। स्वामाधुमाक्तामा+++(टू)+++उवो+++(खा)+++वा+++(श)+++। ई+++(ख)+++न्द्रा+++(श)+++। यसोमा+++(कि)+++क्रा+++(क)+++तू+++(क)+++विक्तामा+++(भि)+++मादा+++(टा)+++ओइमाहा+++(टी)+++उवो+++(खा)+++वा+++(श)+++। द्युक्षा+++(चा)+++तमो+++(ता)+++मादाः+++(टा)+++ ॥ १ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - वासिष्ठेद्वे ॥ द्वयोर्देवाः ककुप् इन्द्रसोमौ ॥&lt;/summary&gt;&#xA;&lt;p&gt;पवस्वमाए+++(तु)+++। धुमा+++(का)+++क्तमाइ+++(कि)+++न्द्रायसो+++(ति)+++ओऔ+++(का)+++हो+++(त)+++वा+++(त)+++। माक्रातूवी+++(टी)+++त्ता+++(त)+++ओऔ+++(का)+++हो+++(ख)+++तमो+++(खा)+++मादाः+++(ता)+++। महाइद्यू+++(टीट्)+++क्षा+++(ख)+++औहोवा+++(शि)+++। तमो+++(ता)+++मा+++(ट)+++दाः+++(ख)+++ ॥ २ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - सभानित्रीणि ॥ वसिष्ठः ककुप्सोमेन्द्रौ ॥ देवाः ककुप्सोमः ॥&lt;/summary&gt;&#xA;&lt;p&gt;पवस्वमधुमा+++(षू)+++इहा+++(ता)+++। क्तामाइन्द्राय+++(षु)+++सोमःकृतुवी+++(कु)+++क्तमोमा+++(टि)+++दाइहा+++(ति)+++। महाइद्यू+++(टी)+++क्षाइहा+++(ति)+++। तामोमा+++(टि)+++दाः+++(खण्)+++। ओ+++(प)+++इळा+++(शा)+++ ॥ ३ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - सभानित्रीणि ॥ वसिष्ठः ककुप्सोमेन्द्रौ ॥ देवाः ककुप्सोमः ॥&lt;/summary&gt;&#xA;&lt;p&gt;पा+++(ख)+++वस्वमधूमा+++(प्लु)+++क्ता+++(ङ)+++माः+++(श)+++। आइन्द्रायसोमा+++(टू)+++क्रा+++(क)+++तुवाइत्ता+++(पी)+++मो+++(श)+++मा+++(त)+++दाः+++(त)+++। माहिद्युक्षाता+++(पु)+++मो+++(श)+++मा+++(ख)+++दो+++(प्ल)+++। हाइ+++(शा)+++ ॥ ४ ॥&lt;/p&gt;</description>
    </item>
    <item>
      <title>०२</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/6_pavamAnapAThaH/11_R-8_sA-36/02/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/6_pavamAnapAThaH/11_R-8_sA-36/02/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - ऊर्ध्वसद्मा आङ्गिरसः पवमानः सोमः ककुप&lt;/summary&gt;&#xA;&lt;p&gt;आभि॒द्युम्नं॒बृहद्याशाः । ई॒ळा॑स्पतेदीदीही॒देवादेवायूं । वीको॒शं॑माध्यामंयू॑वा ॥ २ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - ऐषिराणिचत्वारिच्यावनानिवा ॥ चतुर्णामिषिरः ककुप्सोमः ॥&lt;/summary&gt;&#xA;&lt;p&gt;अभाइद्यु+++(की)+++म्ना+++(ख)+++म्बृहाद्या+++(कि)+++शाः+++(फ)+++। इळास्पते+++(की)+++दिदीहिदे+++(खी)+++वा+++(श)+++देवा+++(का)+++यू+++(फ)+++म्। वीकोश+++(कि)+++म्मद्ध्यमां+++(कि)+++। यू+++(ख)+++वा+++(त्र)+++ ॥ ६ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - ऐषिराणिचत्वारिच्यावनानिवा ॥ चतुर्णामिषिरः ककुप्सोमः ॥&lt;/summary&gt;&#xA;&lt;p&gt;अभ्येद्यूम्ना+++(ती)+++म्। बृहा+++(चा)+++द्या+++(य)+++शाः+++(ट)+++। इळास्पता+++(षी)+++इदिदी+++(कि)+++हा+++(ख)+++इदे+++(शा)+++वादाइवा+++(खी)+++युं+++(श)+++विकौवाउवो+++(खु)+++वा+++(ण)+++। शर्म्मा+++(का)+++द्ध्यामां+++(ता)+++आउवा+++(टि)+++। यू+++(ख)+++वा+++(श)+++ ॥ ७ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - ऐषिराणिचत्वारिच्यावनानिवा ॥ चतुर्णामिषिरः ककुप्सोमः ॥&lt;/summary&gt;&#xA;&lt;p&gt;अभिद्युम्न+++(षी)+++म्बृहदिहा+++(ती)+++। याशाइळास्पते+++(षू)+++दिदीहिदे+++(की)+++वादेवा+++(टि)+++यू+++(त)+++म्। विकौहोवा+++(ती)+++हा+++(त)+++इ+++(श)+++। शर्म्मा+++(टाच्)+++द्ध्यामं+++(का)+++यूवा+++(का)+++इळाभा+++(खिण्)+++। ओ+++(प)+++इळा+++(शा)+++ ॥ ८ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - ऐषिराणिचत्वारिच्यावनानिवा ॥ चतुर्णामिषिरः ककुप्सोमः ॥&lt;/summary&gt;&#xA;&lt;p&gt;अभिद्युम्नम्बृ+++(तु)+++हद्यशाः+++(ति)+++। ई+++(क)+++ळास्पताइदिदी+++(कू)+++हिदाइवा+++(की)+++देवयू+++(चि)+++म्। वीकोशम्मद्ध्यमां+++(टूच्)+++हो+++(य)+++यू+++(प)+++वाएहिया+++(प्ली)+++हा+++(श)+++। हो+++(प्ल)+++इळा+++(शा)+++ ॥ ९ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०३</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/6_pavamAnapAThaH/11_R-8_sA-36/03/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/6_pavamAnapAThaH/11_R-8_sA-36/03/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - ऋजिश्वा भारद्वाजः पवमानः सोमः ककुप&lt;/summary&gt;&#xA;&lt;p&gt;आ॒सोतापा॒री॑षिञ्चता । अश्व॒न्न॓स्तो॑मामप्तूरं॑राजस्तू॑रं । वनप्राक्षा॑मूतप्रूतम् ॥ ३ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - शौक्तानित्रीणि ॥ त्रयाणां कर्णश्रवा ककुबश्वः ॥&lt;/summary&gt;&#xA;&lt;p&gt;आसोतापा+++(ती)+++। रा+++(ट)+++इषा+++(खा)+++औहोवा+++(शि)+++। ञ्चा+++(ख)+++ता+++(श)+++। अश्व+++(था)+++न्नस्तो+++(का)+++ममप्तूरं+++(की)+++रजस्तु+++(कि)+++रमोए+++(भि)+++वना+++(ता)+++ओए+++(टा)+++प्रक्षा+++(खा)+++औहोवा+++(शि)+++। उदा+++(ता)+++प्रू+++(ट)+++ता+++(ख)+++म् ॥ १० ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - शौक्तानित्रीणि ॥ त्रयाणां कर्णश्रवा ककुबश्वः ॥&lt;/summary&gt;&#xA;&lt;p&gt;आसोतापा+++(ती)+++। रिषि+++(का)+++ञ्चता+++(टा)+++ऊ+++(ट)+++हो+++(क)+++वा+++(थ)+++ऊ+++(ट)+++। अश्व+++(था)+++न्नस्तो+++(का)+++ममप्तुरा+++(टी)+++ऊ+++(ट)+++हो+++(क)+++वा+++(थ)+++ऊ+++(ट)+++। रा+++(च)+++जस्तुरा+++(टि)+++ऊ+++(ट)+++हो+++(क)+++वा+++(थ)+++ऊ+++(ट)+++। वानप्रा+++(चि)+++क्षा+++(ट)+++ऊ+++(ट)+++हो+++(क)+++वा+++(थ)+++ऊ+++(ट)+++। उदा+++(ता)+++प्रू+++(ट)+++ता+++(ख)+++औहोवा+++(शि)+++। उऊ+++(खा)+++पा+++(श)+++ ॥ ११ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - शौक्तानित्रीणि ॥ त्रयाणां कर्णश्रवा ककुबश्वः ॥&lt;/summary&gt;&#xA;&lt;p&gt;आसोता+++(टि)+++पा+++(त)+++। रिषाइञ्चता+++(टु)+++अश्वन्नस्तोममा+++(कू)+++प्तू+++(ख)+++रं+++(श)+++रजस्तू+++(खि)+++रंवनोहाबु+++(शु)+++। प्राक्षामू+++(पि)+++दा+++(श)+++हिम्माए+++(भि)+++। प्रू+++(ख)+++त+++(श)+++म् ॥ १२ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - वाचस्सामानित्रीणि ॥ त्रयाणां वाक्ककुबश्वः ॥&lt;/summary&gt;&#xA;&lt;p&gt;आसोतापा+++(ती)+++रीषिञ्चता+++(ती)+++। आश्वा+++(टा)+++औहो+++(खा)+++वा+++(श)+++। नस्तो+++(का)+++ममप्तुरं+++(की)+++रजस्तुरं+++(षी)+++होइवना+++(टी)+++औहो+++(खा)+++वा+++(श)+++। प्रक्षा+++(का)+++मुदा+++(ता)+++प्रू+++(ट)+++ता+++(ख)+++म् ॥ १३ ॥&lt;/p&gt;</description>
    </item>
    <item>
      <title>०४</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/6_pavamAnapAThaH/11_R-8_sA-36/04/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/6_pavamAnapAThaH/11_R-8_sA-36/04/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - कृतयशा आङ्गिरसः पवमानः सोमः ककुप&lt;/summary&gt;&#xA;&lt;p&gt;एता॒मुत्य॓म्मा॑दच्यू॒तं॑ । साहा॒स्रा॑धारंवृषाभ॓न्दी॑वोदूहं॑ । वि॒श्वा॑वा॓सू॑निबिभ्रा॑तम् ॥ ४ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - कौन्मलबर्हिषाणिपञ्च ॥ द्वयोः कुल्मलबर्हिः ककुप् वृषभः ॥ (शङ्क) । प्रजापतिः ककुप् वृषभः ॥ त्रयाणां कुल्मलबर्हिः ककुप् वृषभः ॥&lt;/summary&gt;&#xA;&lt;p&gt;एता+++(ता)+++म्। उत्यम्मदा+++(टी)+++श्चू+++(ख)+++त+++(ण)+++म्। साहास्राधा+++(की)+++रंवार्षाभां+++(टी)+++दीवो+++(टा)+++दू+++(ख)+++ह+++(ण)+++म्। विश्वा+++(टा)+++होइहोइवा+++(टु)+++सू+++(त)+++। ना+++(ट)+++इबा+++(खा)+++औहोवा+++(शि)+++। भ्रा+++(ख)+++त+++(श)+++म् ॥ १६ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - कौन्मलबर्हिषाणिपञ्च ॥ द्वयोः कुल्मलबर्हिः ककुप् वृषभः ॥ (शङ्क) । प्रजापतिः ककुप् वृषभः ॥ त्रयाणां कुल्मलबर्हिः ककुप् वृषभः ॥&lt;/summary&gt;&#xA;&lt;p&gt;एतमूत्य+++(ती)+++म्। मदा+++(ता)+++आउवा+++(टि)+++। च्यू+++(ख)+++त+++(श)+++म्। साहास्रधा+++(की)+++रंवृषा+++(कि)+++भन्दिवो+++(टि)+++दू+++(क)+++हां+++(ख)+++वाइश्वावसू+++(शु)+++। निबा+++(का)+++आउवाए+++(भी)+++। भ्रा+++(ख)+++त+++(श)+++म् ॥ १७ ॥&lt;/p&gt;</description>
    </item>
    <item>
      <title>०५</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/6_pavamAnapAThaH/11_R-8_sA-36/05/</link>
