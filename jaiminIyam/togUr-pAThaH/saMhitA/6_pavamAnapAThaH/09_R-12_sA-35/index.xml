      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/6_pavamAnapAThaH/09_R-12_sA-35/01/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - कविर्भार्गवः पवमानः सोमः जगती&lt;/summary&gt;&#xA;&lt;p&gt;आ॒भी॒प्रीया॒णी॑पवातेचानो॑हितः । ना॒मा॑नीयह्वो॒आ॒धीयेषूवा॒र्धा॑ते । आ॒सू॒र्यास्यबृहा॒तो॒बृहन्ना॒धी । रा॒थं॒विष्व॒ञ्चमऋहद्वीचाक्षाणः॒ ॥ १ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - कावम् ॥ (कुत्सो) । कविः जगती सोमसूयौ ॥&lt;/summary&gt;&#xA;&lt;p&gt;आभीप्री+++(खि)+++या+++(श)+++णीपावा+++(खि)+++ता+++(ण)+++इ+++(श)+++। चा+++(क)+++नोहितो+++(टि)+++नामानी+++(खि)+++या+++(श)+++ह्वोआधी+++(खि)+++ये+++(ण)+++। षू+++(क)+++वर्धताए+++(भि)+++आसूरी+++(खि)+++या+++(श)+++स्याबृहा+++(खि)+++ताः+++(ण)+++। बृ+++(क)+++हन्नधाए+++(भी)+++रथांवा+++(खि)+++इश्वां+++(शा)+++चामारू+++(खि)+++हा+++(ण)+++त्। विचा+++(ता)+++आउवा+++(टि)+++। क्षा+++(ख)+++णाः+++(प्ल)+++ ॥ १ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - प्रजापतेर्वाजसनिनीद्वे ॥ कविर्जगती सोमसूर्यौ ॥&lt;/summary&gt;&#xA;&lt;p&gt;ए+++(त)+++आभी+++(चा)+++प्री+++(क)+++या+++(फ)+++। ओ+++(त)+++णीपावा+++(चि)+++ताए+++(ता)+++चनोही+++(चि)+++ताए+++(ता)+++नामा+++(चा)+++नी+++(क)+++या+++(फ)+++। ओ+++(त)+++ह्वोअधी+++(चि)+++याए+++(ता)+++। षुवर्धा+++(चि)+++ताए+++(ता)+++। आसू+++(चा)+++री+++(क)+++या+++(फ)+++। ओ+++(त)+++स्यबृहा+++(चि)+++ताए+++(ता)+++बृहा+++(चा)+++न्ना+++(क)+++धी+++(फ)+++। ए+++(त)+++राथां+++(चा)+++वी+++(क)+++ष्वा+++(फ)+++। ओ+++(त)+++ञ्चमारू+++(चि)+++हादे+++(ता)+++। विचक्षणाः+++(प्लु)+++। हो+++(प्ल)+++इळा+++(शा)+++ ॥ २ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - प्रजापतेर्वाजसनिनीद्वे ॥ वाजसनिः जगती सोमसूर्यौ ॥&lt;/summary&gt;&#xA;&lt;p&gt;अभ्यौहोवाहाइ+++(षू)+++प्रियाणी+++(ति)+++। पावाता+++(कि)+++इचा+++(खा)+++नो+++(ण)+++। हितोना+++(टि)+++मानियह्वो+++(की)+++अधिया+++(ति)+++इ+++(श)+++षूवा+++(चा)+++र्धाता+++(चा)+++इ+++(श)+++। आ+++(ट)+++सूरिया+++(कि)+++स्यबृहातो+++(ची)+++बृह+++(चा)+++न्ना+++(क)+++धा+++(च)+++इ+++(श)+++। राथंवाइष्वाञ्चा+++(कू)+++मरूहा+++(कि)+++द्विचा+++(ता)+++आउवा+++(टि)+++। क्षा+++(त)+++णाः+++(टख्)+++ ॥ ३ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - वाजिजितौद्वौ ॥ द्वयोर्वाजजित् (प्रजापतिः) जगती सोमसूर्यौ ॥&lt;/summary&gt;&#xA;&lt;p&gt;आ+++(क)+++भिप्रयाणि+++(कीच्)+++पावताइ+++(शी)+++होइहोवा+++(की)+++होए+++(पा)+++चनोहिताहाइहोवाहाइ+++(शै)+++। नामा+++(था)+++नियाह्वो+++(किच्)+++आधियाइ+++(शी)+++होइहोवा+++(की)+++होए+++(पा)+++षुवर्धताहाइहोवाइ+++(शे)+++। आसू+++(था)+++रियास्य+++(चि)+++बृहतो+++(शि)+++होइहोवा+++(की)+++होए+++(पा)+++बृहन्नधीहाइहोवाहाइ+++(शै)+++। राथं+++(का)+++विष्वाञ्चा+++(किच्)+++मारूहा+++(कि)+++द्धोइहोवा+++(टी)+++होए+++(पा)+++विचक्षणाः+++(षी)+++हाइहोवा+++(प्ली)+++हाउवा+++(शि)+++। वा+++(क)+++जीजीगी+++(क)+++वा+++(तच्)+++ ॥ ४ ॥&lt;/p&gt;</description>
