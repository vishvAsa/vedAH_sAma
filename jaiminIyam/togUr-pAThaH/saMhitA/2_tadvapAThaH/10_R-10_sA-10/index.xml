    <item>
      <title>०१</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/2_tadvapAThaH/10_R-10_sA-10/01/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/2_tadvapAThaH/10_R-10_sA-10/01/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - त्रिशोकः काण्वः इन्द्रः गायत्री&lt;/summary&gt;&#xA;&lt;p&gt;ता॓रा ॓णिवोज॒ना॑नां । त्रादं॓वा ॓ज॑स्यागो॒मा॑तः । समाना॒मुप्रा॒शंसिषः ॥ १ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - श्यावाश्वञ्च ॥ श्यावाश्वो गायत्रीन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;तरणिंवाः+++(ती)+++। जना+++(टा)+++नाम+++(त)+++म्। त्रादंवाजा+++(टी)+++हा+++(त)+++स्यागो+++(का)+++मा+++(ख)+++ताः+++(ण)+++। समाना+++(टि)+++मू+++(त)+++। प्रशांसिषाः+++(प्ली)+++। हो+++(प्ल)+++इळा+++(शा)+++ ॥ १ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०२</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/2_tadvapAThaH/10_R-10_sA-10/02/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/2_tadvapAThaH/10_R-10_sA-10/02/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - मधुच्छन्दा वैश्वामित्रः इन्द्रः गायत्री&lt;/summary&gt;&#xA;&lt;p&gt;आसृ॑ग्रमिन्द्राते॒गीराः॑ । प्रा॒तीत्वा॒मू॒दा॑हासता । सा॒जो॒षा॑वृषा॓भं॒पा॒तिम् ॥ २ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - वैरूपञ्च ॥ विरूपो गायत्रीन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;असृग्रमाइन्द्रा+++(तू)+++तेगिराः+++(ति)+++। प्राती+++(टा)+++त्वामू+++(टा)+++दहा+++(का)+++सता+++(शा)+++। साजो+++(टा)+++षावृ+++(टा)+++षभां+++(काच्)+++पातिमो+++(पि)+++इळा+++(प्ला)+++ ॥ २ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०३</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/2_tadvapAThaH/10_R-10_sA-10/03/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/2_tadvapAThaH/10_R-10_sA-10/03/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - वत्सः काण्वः (वशोऽश्वयः) इन्द्रः गायत्री&lt;/summary&gt;&#xA;&lt;p&gt;सुनीथोघासामार्त्याः॑ । य॒म्मा॓रूतोया॓मर्यामा । मित्रःपा॒न्त्यद्रू॒होआ॒तीद्वीषाः॑ ॥ ३ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - सौमित्रञ्च ॥ कौत्सं वा । सुमित्रो गायत्रीन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;सुनीथोघा+++(फी)+++समा+++(शा)+++र्क्त्याः+++(क)+++। यम्मरूतो+++(टीच्)+++यम+++(चा)+++र्यामा+++(चा)+++मित्राःपा+++(चि)+++न्त्यद्रुहा+++(टि)+++उउवा+++(टिच्)+++हा+++(य)+++उवा+++(टा)+++। आ+++(थ)+++तिद्वीषाः+++(टिख्)+++ ॥ ३ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०४</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/2_tadvapAThaH/10_R-10_sA-10/04/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/2_tadvapAThaH/10_R-10_sA-10/04/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - त्रिशोकः काण्वः इन्द्रः गायत्री&lt;/summary&gt;&#xA;&lt;p&gt;य॒द्वीळा॓वि॑न्द्राया॒त्स्थि॑रे । य॓त्प॓र्शा॑नेपा॒रा॑भृतं । वा॓सु॑स्पार्हं॑ता॒दा॒भा॑रा ॥ ४ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - स्तौभञ्च ॥ तुभो गायत्रीन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;औहोवाऔहो+++(खु)+++वा+++(श)+++ओहा+++(प्ला)+++इ+++(श)+++। यद्विळावी+++(खी)+++न्द्राया+++(कि)+++स्थीरा+++(फा)+++इ+++(श)+++। औहोवाऔहो+++(खु)+++वा+++(श)+++ओहा+++(प्ला)+++इ+++(श)+++। यत्पर्शाने+++(खु)+++पारा+++(का)+++भृतं+++(फा)+++। औहोवाऔहो+++(खु)+++वा+++(श)+++ओहा+++(प्ला)+++इ+++(श)+++वसुस्पार्हा+++(खी)+++न्तादा+++(का)+++भारा+++(फ)+++। औहोवाऔहो+++(खु)+++वा+++(श)+++ओहा+++(प्ला)+++इ+++(श)+++। हो+++(प्ल)+++इळा+++(शा)+++ ॥ ४ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०५</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/2_tadvapAThaH/10_R-10_sA-10/05/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/2_tadvapAThaH/10_R-10_sA-10/05/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - सुकक्ष आंगिरसः इन्द्रः गायत्री&lt;/summary&gt;&#xA;&lt;p&gt;श्रूतं॒वो॑वृत्रा॑ह॒न्ता॑मं । प्र॒श॒र्धञ्चर्षो॑णीनां । आ॒शी॒षेरा॒धा॑सेमाहे ॥ ५ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - श्रौतञ्च ॥ श्रुतो गायत्रीन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;श्रूता+++(ता)+++म्। वोवृत्रहन्तमं+++(षू)+++प्रशद्धञ्चऋ+++(कु)+++षाणा+++(टा)+++इना+++(ता)+++म्। आशा+++(का)+++इषा+++(टा)+++इरा+++(ता)+++। धसे+++(काच्)+++मा+++(क)+++हाऔ+++(टा)+++हो+++(ख)+++बा+++(प्ल)+++। हो+++(प्ल)+++इळा+++(शा)+++ ॥ ५ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०६</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/2_tadvapAThaH/10_R-10_sA-10/06/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/2_tadvapAThaH/10_R-10_sA-10/06/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - वामदेवो गौतमः इन्द्रः गायत्री&lt;/summary&gt;&#xA;&lt;p&gt;आर॑न्तइन्द्राश्रा॒वा॑से । गमे॒मा॑शूरत्वा॒वातः । आ॒रं॑शाक्रापा॒रेमणि ॥ ६ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - आभीशवञ्च ॥ अभीशुः गायत्रीन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;अरन्तइन्द्र+++(षू)+++श्रवसे+++(ति)+++ए+++(त)+++। गमा+++(चा)+++इ+++(श)+++मा+++(थ)+++शूरत्वा+++(कि)+++वतो+++(टा)+++होवा+++(टा)+++हा+++(त)+++इ+++(श)+++। आरां+++(चा)+++शा+++(य)+++क्रा+++(ट)+++होवा+++(टा)+++हा+++(त)+++इ+++(श)+++। पारेमा+++(टि)+++णा+++(खण्)+++इ+++(श)+++। ओ+++(प)+++इळा+++(प्ला)+++ ॥ ६ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०७</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/2_tadvapAThaH/10_R-10_sA-10/07/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/2_tadvapAThaH/10_R-10_sA-10/07/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - विश्वामित्रो गाथिनः इन्द्रः गायत्री&lt;/summary&gt;&#xA;&lt;p&gt;धानाव॑न्तंकारंभीणम् । आ॒पू॒पाव॑न्तामुक्थी॒न॑म् । इ॓न्द्राप्राता॒र्जु॑षस्वनः ॥ ७ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - ऐषञ्च ॥ पूषा गायत्रीन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;धाना+++(फा)+++वन्तङ्करा+++(खी)+++म्भिण+++(शा)+++म्। आपूपवन्तमू+++(यू)+++त्थी+++(प)+++ना+++(श)+++म्। इन्द्राप्रा+++(खि)+++ता+++(शप्ल्)+++ओ+++(ख)+++हा+++(ण)+++इ+++(श)+++। जुषोबा+++(प्लि)+++स्वानो+++(प्ला)+++। हाइ+++(शा)+++ ॥ ७ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०८</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/2_tadvapAThaH/10_R-10_sA-10/08/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/2_tadvapAThaH/10_R-10_sA-10/08/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - गोषूकश्वसूनूकाण्वायनाै इन्द्रः गायत्री&lt;/summary&gt;&#xA;&lt;p&gt;आ॒पांफे॓ने॑नानामू॑चेः । शी॑रा॑इ॑न्द्रोद॑वर्क्तया । वि॒श्वा॒या॓दजयस्पृधाः॑ ॥ ८ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - इन्द्रस्यचक्षुरपवी ॥ इन्द्रो गायत्रीन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;अपाम्फेने+++(षी)+++ननमुचेः+++(ती)+++। शीरइ+++(चि)+++न्द्रोदवा+++(टि)+++र्क्ता+++(ख)+++याः+++(ण)+++। वाइश्वाया+++(टीट्)+++दा+++(ख)+++औहोवा+++(शि)+++। जया+++(ता)+++स्पा+++(ट)+++र्धाः+++(ख)+++ ॥ ८ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०९</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/2_tadvapAThaH/10_R-10_sA-10/09/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/2_tadvapAThaH/10_R-10_sA-10/09/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - वामदेवो गौतमः इन्द्रः गायत्री&lt;/summary&gt;&#xA;&lt;p&gt;ईमे॒ताइन्द्रासो॒माः । सूता॒सोयेचासो॒त्वाः॑ । तेषांमत्स्वप्रभूवसो ॥ ९ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - सौमित्रे ॥ सुमित्रो गायत्रीन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;इमेतया+++(ती)+++। न्द्रासोमो+++(टि)+++होवा+++(का)+++हो+++(च)+++इ+++(श)+++। सू+++(क)+++तासोये+++(टि)+++चासो+++(का)+++तू+++(ख)+++वाः+++(ण)+++। ते+++(ख)+++षां+++(प्ल)+++हा+++(त)+++हा+++(त)+++इ+++(श)+++। मात्स्वप्रभू+++(की)+++ओ+++(प)+++बा+++(प्ल)+++वासो+++(प्ला)+++। हाइ+++(शा)+++ ॥ ९ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>१०</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/2_tadvapAThaH/10_R-10_sA-10/10/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/2_tadvapAThaH/10_R-10_sA-10/10/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - श्रुतकक्षः सुकक्षो वा आंगिरसः इन्द्रः गायत्री&lt;/summary&gt;&#xA;&lt;p&gt;तुभ्यंसूतासस्सोमाः॑ । स्तीर्ण॑म्बर्ही॑र्वी॑भवसो । स्तो॒तृभ्या॑इन्द्रमृडया ॥ १० ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - सौमित्रे ॥ सुमित्रो गायत्रीन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;तुभ्यां+++(ता)+++हा+++(त)+++बु+++(श)+++। सूतासस्सोमा+++(षु)+++स्तीर्णांबा+++(टि)+++र्ही+++(त)+++वीभा+++(टाच्)+++हो+++(य)+++इवा+++(टा)+++सो+++(त)+++। स्तोतृ+++(पा)+++आ+++(श)+++भ्या+++(ट)+++इन्द्रमृ+++(खि)+++औहोवा+++(शि)+++। डा+++(ख)+++या+++(श)+++ ॥ १० ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
  </channel>
