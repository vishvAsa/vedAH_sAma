    <item>
      <title>०१</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/2_tadvapAThaH/08_R-9_sA-11/01/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/2_tadvapAThaH/08_R-9_sA-11/01/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - कण्वो घौरः इन्द्रः (वरुणमित्रा-यर्मणः) गायत्री&lt;/summary&gt;&#xA;&lt;p&gt;यं॓रा॑क्ष॓न्तिप्रा॒चे॑तसःवा॒रू॑णोमित्रो॓अर्यामा॒ । ना॒कीस्सा॒दभ्यातेज॒नाः॑ ॥ १ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - सौमित्रञ्च ॥ सुमित्रो गायत्रीन्द्रो विश्वेदेवा वा ॥&lt;/summary&gt;&#xA;&lt;p&gt;यंरक्षन्ति+++(षी)+++प्रचेतसाः+++(ती)+++। वारूणोमित्रो+++(षु)+++अर्या+++(टा)+++मा+++(त)+++। नाकाइस्सा+++(टी)+++दा+++(त)+++। हिम्माइभ्या+++(टीट्)+++ता+++(ख)+++औहोवा+++(शि)+++। जा+++(ख)+++नाः+++(प्ल)+++ ॥ १ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०२</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/2_tadvapAThaH/08_R-9_sA-11/02/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/2_tadvapAThaH/08_R-9_sA-11/02/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - वत्सः (वशोऽश्वयः) काण्वः इन्द्रः गायत्री&lt;/summary&gt;&#xA;&lt;p&gt;ग॒व्योषू॒णो॑या॓था॑पूरा । अश्वायो॓तारा॑थाया॒ । वरिवास्या॒माहो॒ना॑म् ॥ २ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - श्यावाश्वेद्वे ॥ द्वयोश्श्यावाश्वोः गायत्रीन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;गव्योषुणो+++(षी)+++यथापुरा+++(ती)+++। अश्वयो+++(कि)+++तरथाया+++(की)+++वारी+++(का)+++वस्यामहोमा+++(टु)+++होना+++(खा)+++औहोवा+++(शि)+++। ऊ+++(ख)+++पा+++(श)+++ ॥ २ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - श्यावाश्वेद्वे ॥ द्वयोश्श्यावाश्वोः गायत्रीन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;गव्योषुणो+++(षी)+++यथापुरा+++(ती)+++ए+++(त)+++। अश्वयो+++(कि)+++तरथा+++(टि)+++या+++(कथ्)+++वारी+++(टा)+++वास्यामहोमाहो+++(टूट)+++ना+++(ख)+++औहोवा+++(शि)+++। ई+++(ख)+++ ॥ ३ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०३</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/2_tadvapAThaH/08_R-9_sA-11/03/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/2_tadvapAThaH/08_R-9_sA-11/03/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - वत्सः काण्वः इन्द्रः गायत्री&lt;/summary&gt;&#xA;&lt;p&gt;ईमा॒स्ता॑इन्द्रापृ॒श्ना॑यः । घृतन्दू॑हाता॒आशी॒रं । एनामृ॓ता ॓स्या॑पिष्यूषीः ॥ ३ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - शैखण्डिनञ्च ॥ शिखण्डी गायत्रीन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;इमास्तया+++(ती)+++। न्द्रापृश्नयो+++(की)+++घृतन्तू+++(टि)+++हा+++(त)+++बुहो+++(टा)+++हा+++(त)+++हा+++(त)+++इतया+++(टि)+++शा+++(ख)+++इर+++(णा)+++म्। एना+++(खा)+++मृता+++(ता)+++। स्या+++(क)+++पो+++(प)+++बा+++(प्ल)+++प्यूषा+++(प्ला)+++इ+++(श)+++। हाइ+++(शा)+++ ॥ ४ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०४</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/2_tadvapAThaH/08_R-9_sA-11/04/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/2_tadvapAThaH/08_R-9_sA-11/04/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - श्रुतकक्षः सुकक्षो वा आंगिरसः इन्द्रः गायत्री&lt;/summary&gt;&#xA;&lt;p&gt;आ॒या॒धीया॒चर्चा॑गव्याया॒ । पू॒रू॑नामन्पुरूष्ठूत । यत्सो॒मे॑सोमआ॒भू॑वः ॥ ४ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - वैतहव्यञ्च ॥ वीतहव्यो गायत्रीन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;अयाधियाच+++(षु)+++गव्यया+++(ति)+++ए+++(त)+++। पुरूना+++(कि)+++मन्पू+++(खा)+++रू+++(ण)+++। ष्टूतौ+++(का)+++वा+++(तत्)+++। यत्सोमेसोमया+++(तू)+++। यत्सोमे+++(टि)+++सोमयो+++(पि)+++बा+++(प्ल)+++भूवो+++(प्ला)+++। हाइ+++(शा)+++ ॥ ५ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०५</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/2_tadvapAThaH/08_R-9_sA-11/05/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/2_tadvapAThaH/08_R-9_sA-11/05/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - मधुच्छन्दा वैश्वामित्रः इन्द्रः गायत्री&lt;/summary&gt;&#xA;&lt;p&gt;पवाका॒नस्सा॒रा॒स्वती । वा॒जे॑भिर्वाजि॑नीवति । यज्ञां॒वा॑ष्टूधीया॒वा॑सुः ॥ ५ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - भारद्वाजञ्च ॥ भरद्वाजो गायत्रीन्द्रः ॥ सरस्वती वा ॥&lt;/summary&gt;&#xA;&lt;p&gt;पावकानईया+++(तू)+++। सारा+++(चा)+++स्वा+++(य)+++ती+++(ट)+++। वाजे+++(चा)+++भिर्वा+++(थाच्)+++जीना+++(का)+++इवा+++(या)+++ती+++(ट)+++। यज्ञांवा+++(टिट्)+++ष्टू+++(ख)+++औहोवा+++(शि)+++। धिया+++(ता)+++वा+++(ट)+++सूः+++(ख)+++ ॥ ६ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०६</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/2_tadvapAThaH/08_R-9_sA-11/06/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/2_tadvapAThaH/08_R-9_sA-11/06/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - वामदेवो गौतमः इन्द्रः गायत्री&lt;/summary&gt;&#xA;&lt;p&gt;का॒ईम॓न्ना॓हू॑षीष्वा । इ॒न्द्रंसो॒मा॒स्यतर्पयात् । सा॒नो॑वासून्या॒भा॑रात् ॥ ६ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - अरूणस्यचवैददश्वेस्साम ॥ अरुणो वीतहव्यः गायत्रीन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;कइम्मुहुवा+++(तु)+++हा+++(त)+++इ+++(श)+++। ना+++(तच्)+++हूषा+++(का)+++इषू+++(या)+++वा+++(ट)+++। आइन्द्रं+++(कि)+++सोमा+++(का)+++स्यातार्पा+++(यि)+++या+++(ट)+++त्सनो+++(टा)+++वसू+++(टाच्)+++नीया+++(का)+++भा+++(य)+++रा+++(ट)+++त्सनो+++(टा)+++वसू+++(का)+++निया+++(टा)+++भरा+++(का)+++उवा+++(ता)+++। आगह्येही+++(षी)+++तइमे+++(टिख्)+++ ॥ ७ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०७</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/2_tadvapAThaH/08_R-9_sA-11/07/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/2_tadvapAThaH/08_R-9_sA-11/07/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - इरिम्बिठः काण्वः इन्द्रः गायत्री&lt;/summary&gt;&#xA;&lt;p&gt;आया॑हीसूषूमा॒ही॑ते॒ । इ॒न्द्रासो॓मंपीबा॒इमं । ए॒दंबर्हि॓स्सादोमा॒मा ॥ ७ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - सौभरञ्च ॥ सुभरिर्गायत्रीन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;आयाहिसू+++(ती)+++। षूमा+++(चा)+++हा+++(य)+++इते+++(टाच्)+++षूमा+++(का)+++हा+++(य)+++इते+++(टा)+++। आइन्द्रा+++(चि)+++सोमं+++(था)+++पिबा+++(का)+++आ+++(य)+++इमां+++(टाच्)+++पिबा+++(का)+++आ+++(य)+++इमां+++(टा)+++। एदम्ब+++(कि)+++र्हाइस्सा+++(कि)+++दोमा+++(टा)+++मा+++(खण्)+++। ओ+++(प)+++इळा+++(प्ला)+++ ॥ ८ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०८</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/2_tadvapAThaH/08_R-9_sA-11/08/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/2_tadvapAThaH/08_R-9_sA-11/08/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - सत्यव्रतबाऱुणिः इन्द्रः (आदित्यः) गायत्री&lt;/summary&gt;&#xA;&lt;p&gt;माहि॑त्रीणा॒मा॒वा॑रस्तु । धुक्षंमित्र॓स्या॑र्यम्णः । दूराध॒ऋषंवा॒रूणस्या ॥ ८ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - पाष्ठौहेच ॥ पष्ठवाङ्गायत्रीन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;महाइत्रा+++(खी)+++इण+++(णा)+++म्। आवा+++(टा)+++रस्तुद्युक्षा+++(की)+++र्मा+++(ख)+++इत्रा+++(णा)+++। स्या+++(ट)+++र्यम्ना+++(टा)+++दुरा+++(का)+++धा+++(ख)+++र्ष+++(ण)+++म्। वा+++(क)+++रो+++(प)+++बा+++(प्ल)+++णास्यो+++(प्ला)+++। हाइ+++(शा)+++ ॥ ९ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - पाष्ठौहेच ॥ (मित्रावरुणोऽर्यमा) ॥&lt;/summary&gt;&#xA;&lt;p&gt;महित्रीणा+++(षी)+++मवरस्तु+++(ती)+++ए+++(त)+++। द्युक्षर्म्मित्र+++(षी)+++स्यार्यम्णा+++(कि)+++दुराधा+++(टि)+++र्षा+++(त)+++म्। वारौहोवा+++(की)+++हिम्मा+++(टा)+++णास्यो+++(टाट्)+++या+++(ख)+++औहोवा+++(शि)+++। हा+++(त)+++ओवा+++(टा)+++ओवा+++(टाख्)+++ ॥ १० ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०९</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/2_tadvapAThaH/08_R-9_sA-11/09/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/2_tadvapAThaH/08_R-9_sA-11/09/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - वत्सः (वशोऽश्वयः) काण्वः इन्द्रः गायत्री&lt;/summary&gt;&#xA;&lt;p&gt;त्वा॒वा॑तःपुरोवसो । वा॒या॒मिन्द्रः॑प्रणेता । अस्मासी॑स्थातर्हरीणाम् ॥ ९ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - साकमश्वन्धुरांवासाम ॥ साकमश्वो गायत्रीन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;त्वावातो+++(कि)+++हाबुहो+++(कि)+++ओ+++(च)+++इ+++(श)+++। पुरोवसो+++(की)+++हाबुहो+++(कि)+++ओ+++(च)+++इ+++(श)+++। वायमिन्द्रा+++(की)+++हाबुहो+++(कि)+++ओ+++(च)+++इ+++(श)+++। प्रणेतॠ+++(की)+++हाबुहो+++(कि)+++ओ+++(च)+++इ+++(श)+++। स्मसिस्थातॠ+++(कु)+++हाबुहो+++(कि)+++ओ+++(च)+++इ+++(श)+++। हारीणां+++(कि)+++हाबुहो+++(कि)+++। ओ+++(प)+++इळा+++(शा)+++ ॥ ११ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
  </channel>
