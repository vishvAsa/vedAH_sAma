    <item>
      <title>०१</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/2_tadvapAThaH/04_R-10_sA-15/01/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/2_tadvapAThaH/04_R-10_sA-15/01/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - श्रुतकक्षः (सुकक्षः) आंगिरसः&lt;/summary&gt;&#xA;&lt;p&gt;आपा॑दूशिप्रि॒यन्धा॑साः । सूदक्षा॑स्याप्राहोषीणाः॑ । इ॒न्दोरिन्द्रोया॒वा॑शिरः ॥ १ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - सौश्रवसेद्वे ॥ द्वयोः उपगुः गायत्रीन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;आपादुशी+++(ती)+++। प्रियन्धसा+++(ती)+++स्सूदक्षा+++(टि)+++स्या+++(त)+++प्रहो+++(का)+++षीणाः+++(चा)+++। इन्दो+++(का)+++रा+++(ट)+++इन्द्राः+++(ता)+++। यावाशा+++(टि)+++इराः+++(ता)+++। ऐ+++(क)+++हिया+++(टा)+++इहिया+++(खि)+++औहोवा+++(शि)+++। ए+++(तच्)+++ऊ+++(ट)+++पा+++(ख)+++ ॥ १ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - सौश्रवसेद्वे ॥ द्वयोः उपगुः गायत्रीन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;अपा+++(फा)+++दुशिप्रिया+++(खी)+++न्धसाः+++(शा)+++। सूदक्षस्या+++(षी)+++प्रहोषिणा+++(की)+++इन्दौहौ+++(टि)+++हुवा+++(पा)+++इन्द्रोयवा+++(फी)+++शा+++(ङ्)+++इराः+++(शा)+++। ऐ+++(क)+++हा+++(ट)+++ए+++(ट)+++हिया+++(खा)+++औहोवा+++(शि)+++। ए+++(त)+++ऊपा+++(टाच्)+++ ॥ २ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०२</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/2_tadvapAThaH/04_R-10_sA-15/02/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/2_tadvapAThaH/04_R-10_sA-15/02/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - मेधातिथिः (शय्युबार्हस्पत्यः) काण्व&lt;/summary&gt;&#xA;&lt;p&gt;ईमा॒उत्वापूरोवासो । आ॒भिप्रा॒नो॑नावुत्गीराः॑ । गा॓वो॑वत्स॒न्ना॒धेना॒वाः॑ ॥ २ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - त्वाष्ट्रीसामच ॥ त्वष्टा गायत्रीन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;इमाउत्वा+++(ती)+++। पुरो+++(टा)+++वसा+++(टा)+++बु+++(श)+++। आभिप्रनोनवू+++(टू)+++त्गाइराः+++(टि)+++। औ+++(थ)+++हो+++(च)+++इ+++(श)+++। गावो+++(था)+++वात्सा+++(टा)+++न्ना+++(प)+++धे+++(श)+++। ना+++(ख)+++वो+++(प्ल)+++। हाइ+++(शा)+++ ॥ ३ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०३</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/2_tadvapAThaH/04_R-10_sA-15/03/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/2_tadvapAThaH/04_R-10_sA-15/03/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - (स्रोते परिचयः न दत्तः)&lt;/summary&gt;&#xA;&lt;p&gt;अ॒त्रा॒हागो॒रा॑मन्वत । नामत्वष्टू॑रा॓पी१च्यं । इत्था॒चन्द्रा॒मा॑सोगृ॒हे ॥ ३ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - त्वष्टुरातिथ्येद्वे ॥ द्वयोः त्वष्टा गायत्रीन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;अत्रा+++(ता)+++। हा+++(क)+++गो+++(ष)+++रमन्वताउवा+++(टू)+++हाउवा+++(टि)+++हो+++(च)+++इ+++(श)+++। नामत्वष्टु+++(षी)+++रपीच्यामुवा+++(टु)+++हाउवा+++(टि)+++हो+++(च)+++इ+++(श)+++। इत्थाचन्द्रमसो+++(षी)+++गृहाउवा+++(टी)+++हाउवा+++(टि)+++हो+++(टट्)+++या+++(ख)+++औहोवा+++(शि)+++। ऊ+++(ख)+++पा+++(श)+++ ॥ ४ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - त्वष्टुरातिथ्येद्वे ॥ (त्वष्टृचन्द्रमसौ वा) ॥&lt;/summary&gt;&#xA;&lt;p&gt;हावत्रा+++(ति)+++। हा+++(क)+++गोर+++(षा)+++मन्वताउवा+++(टु)+++होइया+++(टि)+++होवा+++(था)+++उवो+++(चा)+++इ+++(श)+++। नामत्वष्टुर+++(षु)+++पीच्यमियाउवा+++(टू)+++होइया+++(टि)+++होवा+++(था)+++उवो+++(चा)+++इ+++(श)+++। इत्थाचन्द्रमसो+++(षू)+++गृहाउवा+++(टी)+++होइया+++(टि)+++होवा+++(था)+++उवो+++(टा)+++या+++(ख)+++औहोवा+++(शि)+++। ऊ+++(ख)+++पा+++(श)+++ ॥ ५ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०४</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/2_tadvapAThaH/04_R-10_sA-15/04/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/2_tadvapAThaH/04_R-10_sA-15/04/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - (स्रोते परिचयः न दत्तः)&lt;/summary&gt;&#xA;&lt;p&gt;य॒दि॒न्द्रोआ॓ना॑यद्रीताः । माही॒रापो॒वृ॒ष॑न्तमः । तत्रा॑पूषा॓भू॑वत्सा॒चा ॥ ४ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - पौष्णेद्वे ॥ द्वयोः पूषा गायत्रीन्द्र पूषणौ ॥&lt;/summary&gt;&#xA;&lt;p&gt;यदिन्द्रोया+++(ती)+++। नाया+++(टा)+++दों+++(च)+++ओं+++(ट)+++ओ+++(ख)+++वा+++(श)+++। रीतोमहीरापा+++(टू)+++ओं+++(ट)+++ओ+++(ख)+++वा+++(श)+++। वृषावृषा+++(टी)+++न्तमा+++(खा)+++औहोवा+++(शि)+++। तत्रापू+++(कि)+++षा+++(च)+++भुवा+++(ता)+++त्सा+++(ट)+++चा+++(ख)+++ ॥ ६ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - पौष्णेद्वे ॥ द्वयोः पूषा गायत्रीन्द्र पूषणौ ॥&lt;/summary&gt;&#xA;&lt;p&gt;यदिन्द्रोआना+++(षु)+++यद्रीता+++(ती)+++ए+++(त)+++। माहीरापो+++(टीच्)+++मा+++(क)+++हीरापो+++(टि)+++वार्षा+++(का)+++न्ता+++(ख)+++माः+++(ण)+++। तत्रापू+++(टि)+++षापू+++(टाट्)+++षा+++(ख)+++औहोवा+++(शि)+++। भुवा+++(ता)+++त्सा+++(ट)+++चा+++(ख)+++ ॥ ७ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०५</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/2_tadvapAThaH/04_R-10_sA-15/05/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/2_tadvapAThaH/04_R-10_sA-15/05/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - (स्रोते परिचयः न दत्तः)&lt;/summary&gt;&#xA;&lt;p&gt;गौ॒र्धायतीमारुतां॑ । श्रवस्यु॒र्मातामाघो॒नां॑ । युक्ता॒व॒न्ही॓रा॒था॑नाम् ॥ ५ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - श्यावाश्वेद्वे ॥ द्वयोः श्यावाश्वो विराड्र्गायत्रीन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;गौर्धया+++(ति)+++ए+++(त)+++। तिमरूतां+++(तीच्)+++श्रा+++(क)+++वस्युर्मा+++(टि)+++तामघो+++(खि)+++ना+++(श)+++म्। युक्तावन्हा+++(ची)+++इ+++(श)+++। रथा+++(का)+++ना+++(ट)+++मा+++(ख)+++औहोवा+++(शि)+++। ऊ+++(ख)+++पा+++(श)+++ ॥ ८ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - श्यावाश्वेद्वे ॥ मरुतो वा ॥&lt;/summary&gt;&#xA;&lt;p&gt;गौर्धयति+++(षी)+++मरुता+++(ति)+++मे+++(त)+++। श्रावस्युर्म+++(टी)+++तामघोना+++(टीच्)+++मुहुवा+++(टि)+++हा+++(त)+++इ+++(श)+++। युक्तावा+++(चि)+++न्ही+++(थ)+++रूहुवा+++(टि)+++हा+++(त)+++इ+++(श)+++। रथा+++(का)+++नामौ+++(पा)+++होबा+++(प्ला)+++। हो+++(प्ल)+++इळा+++(शा)+++ ॥ ९ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०६</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/2_tadvapAThaH/04_R-10_sA-15/06/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/2_tadvapAThaH/04_R-10_sA-15/06/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - (स्रोते परिचयः न दत्तः)&lt;/summary&gt;&#xA;&lt;p&gt;ऊ॒पा॑नोहा॒रीभीस्सू॒तं । याही॒मा॒दानांपते॑ । ऊ॓पानोहा॒री॑भीस्सू॒तम् ॥ ६ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - प्रजापतेस्सुतंरयिष्ठीयेद्वे ॥ द्वयोः प्रजापतिर्निचृत् गायत्रीन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;उपानो+++(पि)+++हरिभी+++(प्लि)+++स्सूतो+++(ङा)+++वा+++(श)+++। याहिमदा+++(टी)+++नाम्पाता+++(टि)+++उपनो+++(ति)+++हा+++(त)+++ओ+++(प)+++बा+++(प्ल)+++। रा+++(ख)+++इभीः+++(प्ला)+++। सूतामौ+++(पि)+++होबा+++(प्ला)+++। हो+++(प्ल)+++इळा+++(शा)+++ ॥ १० ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - प्रजापतेस्सुतंरयिष्ठीयेद्वे ॥ द्वयोः प्रजापतिर्निचृत् गायत्रीन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;उपनो+++(षि)+++हाबुहोरा+++(ती)+++इभीः+++(ता)+++। सू+++(ट)+++ता+++(त)+++म्। याहिमदा+++(की)+++नाम्पा+++(टा)+++ताउपानो+++(खी)+++हा+++(ण)+++। रा+++(ट)+++इभा+++(खा)+++औहोवा+++(शि)+++। सूतं+++(का)+++रा+++(च)+++इष्ठाः+++(टाख्)+++ ॥ ११ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०७</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/2_tadvapAThaH/04_R-10_sA-15/07/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/2_tadvapAThaH/04_R-10_sA-15/07/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - (स्रोते परिचयः न दत्तः)&lt;/summary&gt;&#xA;&lt;p&gt;इष्टाहोत्राअसृक्षत । इ॓न्द्रं॑वृधन्तो॑आध्वा॑रे॒ । अच्छावाभृथमो॒ज॑सा ॥ ७ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - आप्सरसञ्च इष्टाहोत्रीयंवा आपांवानिधि ॥ अप्सरसो गायत्रीन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;इष्टाहोत्रा+++(ती)+++। आ+++(च)+++सृक्षा+++(खा)+++ता+++(ण)+++। इ+++(क)+++न्द्रंवृधान्तो+++(टी)+++अध्वा+++(खा)+++रा+++(ण)+++इ+++(श)+++। अच्छावा+++(खि)+++भा+++(श)+++र्त्थमोजा+++(खि)+++सा+++(त्र)+++। ए+++(त)+++ऊ+++(क)+++दधिर्निधीः+++(टीख्)+++ ॥ १२ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०८</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/2_tadvapAThaH/04_R-10_sA-15/08/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/2_tadvapAThaH/04_R-10_sA-15/08/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - (स्रोते परिचयः न दत्तः)&lt;/summary&gt;&#xA;&lt;p&gt;अ॒ह॒मि॒द्धि॒पीतुःपा॑री । मेधा॒मृता॓स्या॑जग्रा॒हा॑ । अहं॒सू॑र्या॒इवा॒जनी ॥ ८ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - प्रजापतेर्निधन कामम् ॥ प्रजापतिर्गायत्रीन्द्रः ॥ सूर्यो वा ॥&lt;/summary&gt;&#xA;&lt;p&gt;अहमिद्धा+++(फी)+++इपितुःपरा+++(कु)+++इ+++(श)+++। मे+++(क)+++धामृतस्यजग्रहा+++(षृ)+++आहंसूर्या+++(की)+++इवा+++(पा)+++हा+++(प्ल)+++हा+++(ङ्)+++इ+++(श)+++। जनिहोइहोऔ+++(कू)+++होऔ+++(का)+++होवा+++(पा)+++हाबु+++(प्ला)+++। बा+++(श)+++ ॥ १३ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०९</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/2_tadvapAThaH/04_R-10_sA-15/09/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/2_tadvapAThaH/04_R-10_sA-15/09/</guid>
