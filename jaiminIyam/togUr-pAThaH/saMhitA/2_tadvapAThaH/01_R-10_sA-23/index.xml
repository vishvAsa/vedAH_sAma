    <item>
      <title>०१</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/2_tadvapAThaH/01_R-10_sA-23/01/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/2_tadvapAThaH/01_R-10_sA-23/01/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - शय्युबार्हस्पत्यः इन्द्रः गायत्री&lt;/summary&gt;&#xA;&lt;p&gt;त॒द्वो॒गायासू॒तेसा॒चा । पुरुहूता॒यासात्वा॑ने । शं॒य॒त्ग॒वेनाशाकीने ॥ १ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - मर्गीयवञ्च ॥ मृगयुर्गायत्रीन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;तद्वौहोवा+++(ती)+++। गाया+++(टा)+++सुताइ+++(खि)+++चा+++(ण)+++। पुरूहू+++(कि)+++ता+++(तच्)+++यासा+++(का)+++त्वा+++(य)+++ना+++(ट)+++इ+++(श)+++। शय्यदोऔ+++(की)+++होइगा+++(खि)+++वा+++(ण)+++इ+++(श)+++। ना+++(टट्)+++शा+++(ख)+++औहोवा+++(शि)+++। ए+++(तच्)+++की+++(ट)+++ने+++(ख)+++ ॥ १ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - रौद्रेद्वे ॥ द्वयोः मृगयुर्गायत्रीन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;तद्वोगाया+++(ती)+++। सुता+++(ता)+++इसचा+++(ति)+++पुरू+++(टा)+++हुता+++(खा)+++हा+++(शप्ल्)+++हा+++(त)+++इया+++(चा)+++सत्वा+++(खा)+++ना+++(ण)+++इ+++(श)+++। शं+++(क)+++यत्गा+++(टा)+++वे+++(त)+++। नाशौ+++(टा)+++हौ+++(टच्)+++हू+++(क)+++वो+++(प)+++बा+++(प्ल)+++काइनो+++(प्लि)+++। हाइ+++(शा)+++ ॥ २ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - रौद्रेद्वे ॥ द्वयोः मृगयुर्गायत्रीन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;तद्वोगाय+++(षी)+++सुतेसाचा+++(ती)+++ए+++(त)+++। पुरुहू+++(कि)+++तायसत्वाने+++(कु)+++पुरू+++(चा)+++हूता+++(था)+++या+++(च)+++सा+++(य)+++त्वा+++(ट)+++ना+++(ख)+++इशंया+++(फि)+++त्गौवाउवो+++(खी)+++वा+++(ण)+++। ना+++(प)+++शा+++(श)+++का+++(ख)+++इनो+++(प्ला)+++। हाइ+++(शा)+++ ॥ ३ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - मार्गीयवञ्चैव ॥ मृगयुः गायत्रीन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;तद्वौगाय+++(षी)+++सुतेसाचा+++(ती)+++ए+++(त)+++। पूरूहु+++(कि)+++तायसत्वनाइ+++(षू)+++शंयत्गा+++(टि)+++वे+++(त)+++। ऐ+++(च)+++हा+++(य)+++या+++(ट)+++ऐहि+++(ता)+++। नाशाका+++(टिट्)+++इना+++(खा)+++औहोवा+++(शि)+++। ई+++(ख)+++ ॥ ४ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०२</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/2_tadvapAThaH/01_R-10_sA-23/02/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/2_tadvapAThaH/01_R-10_sA-23/02/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - श्रुतकक्षः सुकक्षो वा आंगिरसः इन्द्रः गायत्री&lt;/summary&gt;&#xA;&lt;p&gt;य॓स्ते॑नूनंशा॑तकृतो॑ । इन्द्र॑घुम्नीता॑मो॒मा॒दाः॑ । ते॓ना॑नूनम्मादे॑मदेः ॥ २ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - आश्वञ्च ॥ अश्वो गायत्रीन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;यस्तेनूनां+++(फी)+++शताकृता+++(की)+++बु+++(श)+++। इन्द्रद्युम्नी+++(षी)+++तामोमा+++(टि)+++दाः+++(च)+++। ते+++(क)+++ननूना+++(भि)+++म्मा+++(त)+++। दाइमा+++(टि)+++उवा+++(ता)+++। देः+++(ख)+++ ॥ ५ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०३</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/2_tadvapAThaH/01_R-10_sA-23/03/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/2_tadvapAThaH/01_R-10_sA-23/03/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - हयतः प्रागाथः इन्द्रः (अग्निर्हवींषि वा) गायत्री&lt;/summary&gt;&#xA;&lt;p&gt;गा॒वाऊ॒पा॑वादावाटे॒ । माही॒यज्ञास्या॓रप्सू॑दाः । ऊ॒भाक॒र्णा॑हीरण्या॒या ॥ ३ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - ऐटतेद्वे ॥ द्वयोरिटन्वान् गायत्रीन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;गावएगावाः+++(तु)+++। उपावदा+++(ती)+++वा+++(ट)+++दा+++(ख)+++औहोवा+++(शि)+++। वा+++(ख)+++टे+++(श)+++। महीया+++(खि)+++ज्ञा+++(ण)+++। स्यरा+++(ता)+++स्या+++(टट्)+++रा+++(ख)+++औहोवा+++(शि)+++। प्सु+++(ख)+++दा+++(श)+++उभाका+++(खि)+++र्णा+++(ण)+++। हिरा+++(ता)+++हा+++(ट)+++इरा+++(खा)+++औहोवा+++(शि)+++। ण्या+++(ख)+++या+++(श)+++ ॥ ६ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - ऐटतेद्वे ॥ द्वयोरिटन्वान् गायत्रीन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;ओइगा+++(खि)+++वाः+++(ण)+++। उपा+++(ताच्)+++वादा+++(का)+++वाटा+++(टा)+++उवो+++(खा)+++वा+++(श)+++। माही+++(चा)+++यज्ञा+++(का)+++स्यारा+++(ता)+++प्सूदा+++(टा)+++ओयू+++(खा)+++भा+++(श)+++। कर्णा+++(टा)+++उवो+++(खा)+++वा+++(श)+++। हिर+++(का)+++ण्यया+++(टाख्)+++ ॥ ७ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०४</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/2_tadvapAThaH/01_R-10_sA-23/04/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/2_tadvapAThaH/01_R-10_sA-23/04/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - श्रुतकक्षः (सुकक्षो वा) आंगिरसः इन्द्रः गायत्री&lt;/summary&gt;&#xA;&lt;p&gt;आ॒राम॓श्व॑यगायता । श्रू॓ता॑कक्षा॒रंग॒वे । आ॒रामि॓न्द्रा॑स्याधा॒म्ने॓ ॥ ४ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - श्रौतकक्षेद्वे ॥ द्वयोः श्रुतकक्षो गायत्रीन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;अरा+++(खा)+++मश्वायगा+++(प्ली)+++या+++(ङ)+++ता+++(श)+++। श्रूताकक्षा+++(टी)+++रा+++(य)+++ङ्गावा+++(का)+++आ+++(ख)+++र+++(ण)+++म्। हा+++(त)+++हा+++(त)+++इन्द्रास्या+++(पि)+++धा+++(श)+++। हो+++(क)+++ये+++(ट)+++म्नोया+++(खा)+++औहोवा+++(शि)+++। ई+++(ख)+++ति+++(श)+++ ॥ ८ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - श्रौतकक्षेद्वे ॥ द्वयोः श्रुतकक्षो गायत्रीन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;अरमश्वाय+++(षू)+++गायतअरमश्वो+++(तू)+++वा+++(त)+++। यागा+++(का)+++या+++(च)+++ताश्रूता+++(कि)+++कक्षा+++(टा)+++हा+++(त)+++हा+++(त)+++आरा+++(का)+++ङ्गा+++(ख)+++वा+++(ण)+++इ+++(श)+++। आरामिन्द्रा+++(टी)+++हा+++(त)+++हा+++(त)+++स्या+++(क)+++धा+++(थ)+++म्नाऔ+++(टा)+++हो+++(ख)+++बा+++(प्ल)+++। हो+++(प्ल)+++इळा+++(शा)+++ ॥ ९ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०५</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/2_tadvapAThaH/01_R-10_sA-23/05/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/2_tadvapAThaH/01_R-10_sA-23/05/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - श्रुतकक्षः (सुकक्षो वा सुकक्षः) आंगिरसः इन्द्रः गायत्री&lt;/summary&gt;&#xA;&lt;p&gt;त॒मि॒न्द्रं॑वाजयामसि । मा॓हे॑वृत्रायाह॒न्ता॑वे । स॒वृ॒षा॑वृषाभो॒भू॑वात् ॥ ५ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - तन्वस्यपाथस्यसामनीद्वे वसोवार्षेः ॥ तन्वः गायत्रीन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;तामिन्द्रां+++(पि)+++वाजयामसि+++(शु)+++। माहे+++(चा)+++वृत्रा+++(थाच्)+++याहा+++(का)+++न्ता+++(य)+++वे+++(ट)+++। सावा+++(चा)+++र्षा+++(य)+++वृ+++(ट)+++। षा+++(क)+++भो+++(प)+++बा+++(प)+++बा+++(प्ल्)+++भूवा+++(प्ला)+++त्। हाइ+++(शा)+++ ॥ १० ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - तन्वस्यपाथस्यसामनीद्वे वसोवार्षेः ॥ दावसुर्गायत्रीन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;तामिन्द्रां+++(पि)+++वाजयामसिहाबु+++(शू)+++। माहे+++(चा)+++वृत्रा+++(थाच्)+++याहा+++(का)+++न्ता+++(य)+++वे+++(ट)+++होवा+++(टा)+++हा+++(त)+++इ+++(श)+++। सावा+++(चा)+++र्षा+++(य)+++वृ+++(ट)+++हो+++(टा)+++वा+++(त)+++हाइ+++(श)+++। षाभोभू+++(टिट्)+++वा+++(ख)+++औहोवा+++(शि)+++। एदा+++(ता)+++वासू+++(टाख्)+++ ॥ ११ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - अङगिरसान्निवेष्टौद्वौ इळा ॥ वसिष्ठो गायत्रीन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;तमिन्द्रं+++(षि)+++वाजयामसी+++(तु)+++ए+++(त)+++। महा+++(ता)+++हाइवृत्रा+++(चि)+++या+++(क)+++हो+++(च)+++वा+++(क)+++ह+++(क)+++न्तवे+++(टा)+++ओवा+++(का)+++ई+++(टट्)+++या+++(त)+++। ओमोवासहे+++(कु)+++वार्षा+++(टा)+++ओवा+++(का)+++ई+++(टट्)+++या+++(त)+++। ओमोवावृ+++(की)+++षाभो+++(टा)+++या+++(ख)+++औहोवा+++(शि)+++। भू+++(ख)+++वा+++(श)+++त् ॥ १२ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - अङगिरसान्निवेष्टौद्वौ इळा ॥ इडा गायत्रीन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;औहोवाइहुवा+++(तू)+++होइतमि+++(की)+++न्द्रंवा+++(खा)+++जाया+++(का)+++मासी+++(फा)+++। औहोवाइहुवा+++(तू)+++होइमहे+++(की)+++वृत्रा+++(चा)+++याह+++(का)+++न्तावे+++(फा)+++। औहोवाइहुवा+++(तू)+++होइसवा+++(की)+++र्षा+++(ख)+++वृ+++(ण)+++। षाभोभू+++(टिट्)+++वा+++(त)+++दिळा+++(प्ला)+++भाएहिळा+++(प्ली)+++। हो+++(प्ल)+++इळा+++(शा)+++ ॥ १३ ॥&lt;/p&gt;</description>
    </item>
    <item>
      <title>०६</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/2_tadvapAThaH/01_R-10_sA-23/06/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/2_tadvapAThaH/01_R-10_sA-23/06/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - देवजामय इन्द्रमातरः ऋषिकाः इन्द्रः गायत्री&lt;/summary&gt;&#xA;&lt;p&gt;त्वा॓मिन्द्राब॒लाद॒धी॑ । साहा॒सा॒जाता॒ओ॒ज॑सा । त्वं॓सन्वृष॑न्वृषेद॑सि ॥ ६ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - शय्यातानित्रीणि ॥ त्रयाणां शर्यातिर्गायत्रीन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;हाबुत्वमिन्द्रा+++(तु)+++। बलादधिहा+++(कु)+++बुहा+++(ता)+++बु+++(श)+++। सहा+++(का)+++साजा+++(था)+++ता+++(ट)+++ओजासा+++(भि)+++हाबुहा+++(ति)+++बु+++(श)+++। त्वां+++(च)+++सा+++(य)+++न्वार्षा+++(टा)+++न्हाबुहा+++(ति)+++बु+++(श)+++। वृषाइदा+++(टीट्)+++सा+++(ख)+++औहोवा+++(शि)+++। वृधे+++(ताच्)+++ ॥ १४ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - शय्यातानित्रीणि ॥ त्रयाणां शर्यातिर्गायत्रीन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;त्वमिन्द्र+++(षि)+++बलादधी+++(ती)+++ए+++(त)+++। सहा+++(का)+++साजा+++(था)+++ता+++(ट)+++ओजसा+++(भि)+++इया+++(का)+++होइया+++(कि)+++इयो+++(खा)+++वा+++(श)+++। त्वां+++(च)+++सा+++(य)+++न्वार्षा+++(टा)+++न्इया+++(का)+++होइया+++(कि)+++इयो+++(खा)+++वा+++(श)+++। वृषाइदा+++(टीट्)+++सा+++(ख)+++औहोवा+++(शि)+++। महे+++(ताच्)+++ ॥ १५ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - शय्यातानित्रीणि ॥ त्रयाणां शर्यातिर्गायत्रीन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;त्वमिन्द्रंबला+++(षू)+++दधीसहसा+++(तु)+++। जाता+++(का)+++ओजा+++(का)+++सा+++(ख)+++इहोइहा+++(शी)+++। त्वांसा+++(काच्)+++न्वा+++(क)+++र्षा+++(ख)+++निहोइहा+++(शी)+++। वृषाइदा+++(टीट्)+++सा+++(ख)+++औहोवा+++(शि)+++। ई+++(ख)+++हा+++(श)+++ ॥ १६ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०७</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/2_tadvapAThaH/01_R-10_sA-23/07/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/2_tadvapAThaH/01_R-10_sA-23/07/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - गोषूकश्वसूनूकाण्वायनाै इन्द्रः गायत्री&lt;/summary&gt;&#xA;&lt;p&gt;यज्ञाइ॒न्द्रा॑मवर्धयात् । य॒त्भूमिंव्या॒वा॑र्क्तयात् । चक्रा॓णाओपाश॒न्दीवि ॥ ७ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - इन्द्राण्यास्साम ॥ इन्द्राणी गायत्रीन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;यज्ञइन्द्र+++(षी)+++मवर्धा+++(ति)+++या+++(त)+++त्। यत्भूमिंवायवा+++(टू)+++र्ता+++(ख)+++या+++(ण)+++त्। चा+++(ख)+++क्रा+++(प्ल)+++णा+++(ख)+++ओ+++(ण)+++। पाश+++(काच्)+++न्दी+++(क)+++वीचक्रा+++(किच्)+++णाओ+++(का)+++पाशा+++(खा)+++औहोवा+++(शि)+++। दी+++(ख)+++वि+++(श)+++ ॥ १७ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
