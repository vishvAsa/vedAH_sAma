    <item>
      <title>०१</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/2_tadvapAThaH/03_R-10_sA-20/01/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/2_tadvapAThaH/03_R-10_sA-20/01/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - कण्वो घौरः इन्द्रः (मरुतः) गायत्री&lt;/summary&gt;&#xA;&lt;p&gt;ईहे॒वा॑शृण्वाएषां । काशाह॓स्तेषूयद्वादा॑न् । निया॓मैःचित्रा॒मृन्जते ॥ १ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - ऐषञ्च ॥ इषो गायत्रीन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;ईहेवा+++(पि)+++श्रुण्वएषा+++(शी)+++म्। काशाहस्तेषुया+++(यू)+++द्वा+++(प)+++दा+++(श)+++न्। नियामैश्ची+++(खी)+++त्रामृ+++(कि)+++न्ज+++(क)+++ता+++(फ)+++इ+++(श)+++। नीयामै+++(षि)+++श्चाइत्रामा+++(टी)+++न्जा+++(ख)+++ता+++(ण)+++इ+++(श)+++। एहिया+++(खि)+++औहो+++(ता)+++। ए+++(क)+++हियौहोए+++(की)+++हियौहोवा+++(की)+++। ए+++(ख)+++हि+++(श)+++ ॥ १ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०२</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/2_tadvapAThaH/03_R-10_sA-20/02/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/2_tadvapAThaH/03_R-10_sA-20/02/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - त्रिशोकः इन्द्रः गायत्री&lt;/summary&gt;&#xA;&lt;p&gt;ईमा॓ऊत्वावीचा॑क्षते । सा॒खा॑याइन्द्रासोमीनाः॑ । पुष्टावन्तोया॓था॑पाशु॒म् ॥ २ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - पौषञ्च ॥ पूषा गायत्रीन्द्रः ॥ मरुतः ॥&lt;/summary&gt;&#xA;&lt;p&gt;इमाउत्वा+++(षी)+++विचक्षते+++(खी)+++सखा+++(खा)+++याः+++(श)+++। इन्द्रसोमा+++(भी)+++इना+++(ता)+++होये+++(टा)+++हो+++(ट)+++वा+++(त)+++। पुष्टावा+++(टि)+++न्तो+++(त)+++होये+++(टा)+++हो+++(क)+++वा+++(त)+++। या+++(क)+++थो+++(प)+++बा+++(प्ल्)+++पाशु+++(प्ला)+++म्। हाइ+++(शा)+++ ॥ २ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०३</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/2_tadvapAThaH/03_R-10_sA-20/03/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/2_tadvapAThaH/03_R-10_sA-20/03/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - वत्सः काण्वः इन्द्रः गायत्री&lt;/summary&gt;&#xA;&lt;p&gt;सा॒मा॑स्यामन्या॒वेवीशाः॑ । विश्वे॑नमन्ताकृष्टा॒याः । समुद्रा॓ये॑वासिन्धावः ॥ ३ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - मरूताञ्चसंवेशीयम् ॥ मरुतो गायत्रीन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;सामस्यामा+++(टी)+++न्या+++(त)+++वेवीशाः+++(चि)+++। विश्वेनामा+++(टी)+++न्ता+++(त)+++कृष्टायाः+++(चि)+++। सामुद्राये+++(टीच)+++वा+++(क)+++सिन्धा+++(टा)+++वाः+++(खण्)+++। ओ+++(प)+++इळा+++(शा)+++ ॥ ३ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०४</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/2_tadvapAThaH/03_R-10_sA-20/04/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/2_tadvapAThaH/03_R-10_sA-20/04/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - कुसीदी काण्वः इन्द्रः (विश्वेदेवाः) गायत्री&lt;/summary&gt;&#xA;&lt;p&gt;देवा॒नामी॓दावो॑माहा॒त् । ता॒दा॒वृणीमहेवायं । वृष्णा॑मस्मा॓भ्या॑मूता॒ये ॥ ४ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - हाविष्मतेद्वे ॥ द्वयोर्हविष्मान् गायत्रीन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;देवाना+++(फि)+++मिदाउवो+++(खी)+++वा+++(श)+++। आवा+++(टा)+++उवो+++(खा)+++वा+++(श)+++। मा+++(ख)+++हा+++(श)+++त्। तादावृणाइ+++(ष)+++माहा+++(टा)+++उवो+++(खा)+++वा+++(श)+++। वा+++(ख)+++य+++(श)+++म्। वृष्णामस्माभ्यामा+++(टू)+++उवो+++(खा)+++वा+++(श)+++। ता+++(ख)+++ये+++(श)+++ ॥ ४ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - हाविष्मतेद्वे ॥ (विश्वेदेवाः वा) ॥&lt;/summary&gt;&#xA;&lt;p&gt;हाबुदेवाना+++(षु)+++मिदवोमहद्धा+++(तू)+++बु+++(श)+++। तादा+++(का)+++वार्णा+++(टा)+++इमा+++(चा)+++हे+++(क)+++वा+++(ख)+++य+++(ण)+++म्। ऐ+++(टच)+++हा+++(य)+++या+++(ट)+++ऐही+++(ता)+++। वृष्णामा+++(भि)+++स्मा+++(त)+++। भ्यामूता+++(टिट्)+++या+++(ख)+++औहोवा+++(शि)+++। हावीष्मा+++(टि)+++ते+++(ख)+++ ॥ ५ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - हाविष्कृतेद्वे ॥ द्वयोर्हविष्कृद्गायत्रीन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;देवानामिदवो+++(षू)+++हाबुमा+++(ति)+++हा+++(त)+++त्। तादावृणाइ+++(षु)+++माहाइवा+++(टी)+++या+++(त)+++म्। वृष्णां+++(टाच्)+++हो+++(य)+++या+++(ट)+++स्मा+++(त)+++। भ्यामूता+++(टिट्)+++या+++(ख)+++औहोवा+++(शि)+++। हाविष्का+++(टि)+++र्ते+++(ख)+++ ॥ ६ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - हाविष्कृतेद्वे ॥ (विश्वेदेवाः) ॥&lt;/summary&gt;&#xA;&lt;p&gt;देवानामिदवो+++(षू)+++मा+++(त)+++हा+++(त)+++त्। तादावृणी+++(कीच्)+++मा+++(क)+++हाइवा+++(टि)+++या+++(त)+++म्। वृष्णामा+++(भि)+++स्मा+++(तच्)+++भ्या+++(क)+++मो+++(प)+++बा+++(प्ल)+++तायो+++(प्ला)+++। हाइ+++(शा)+++ ॥ ७ ॥&lt;/p&gt;</description>
    </item>
    <item>
      <title>०५</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/2_tadvapAThaH/03_R-10_sA-20/05/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/2_tadvapAThaH/03_R-10_sA-20/05/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - मेधातिथिः काण्वः इन्द्रः (ब्रह्मणस्पतिः) गायत्री&lt;/summary&gt;&#xA;&lt;p&gt;सोमानांस्वा॒रा॑णां । कृ॒णू॒ही॑ब्रह्मणस्पते । कक्षीवन्तंया॓औशीजः॒ ॥ ५ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - काक्षीवतञ्च ॥ कक्षीवान् विराङ्गायत्री ब्रह्मणस्पतिः ॥&lt;/summary&gt;&#xA;&lt;p&gt;सोमा+++(खा)+++नांस्वरण+++(शी)+++म्। कृणूहि+++(षि)+++ब्रह्मणस्पा+++(की)+++ताये+++(टा)+++ओ+++(ख)+++हा+++(प्ल)+++हा+++(त)+++इ+++(श)+++। कक्षाइवा+++(भी)+++न्ता+++(त)+++म्। यऔहो+++(तिच्)+++औ+++(क)+++हो+++(ख)+++बा+++(प्ल्)+++शाइजो+++(प्लि)+++। हाइ+++(शा)+++ ॥ ८ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०६</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/2_tadvapAThaH/03_R-10_sA-20/06/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/2_tadvapAThaH/03_R-10_sA-20/06/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - श्रुतकक्षः (सुकक्षः) आंगिरसः इन्द्रः गायत्री&lt;/summary&gt;&#xA;&lt;p&gt;बोध॒न्माना॒इद॒स्तुनः । वृत्राहा॓भू॒र्या॑सुतिः । श्रृणो॓तू॑शक्रा॒आशी॒ष॑म् ॥ ६ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - उषसश्च साम ॥ उषो गायत्रीन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;बोधन्मनाः+++(ती)+++। इदा+++(टा)+++स्तूनो+++(ट्)+++वृत्रहा+++(कि)+++भूर्या+++(ट्)+++सू+++(ख)+++तीः+++(ण)+++। श्रुणो+++(खा)+++औहो+++(ता)+++। तुशा+++(चा)+++क्रा+++(क)+++आशिषामौ+++(पी)+++होबा+++(प्ला)+++। हो+++(प्ल)+++इळा+++(शा)+++ ॥ ९ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०७</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/2_tadvapAThaH/03_R-10_sA-20/07/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/2_tadvapAThaH/03_R-10_sA-20/07/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - श्यावाश्व आत्रयेः इन्द्रः (सविता) गायत्री&lt;/summary&gt;&#xA;&lt;p&gt;अ॒द्या॒नो॑देवसवितः । प्रा॒जा॒वा॑त्सा॒वीसौ॒भा॑गं । पा॓रा॓दुष्वा॒प्न्यिं॑सुवा ॥ ७ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - भारद्वाजस्यमौक्षेद्वे ॥ भरद्वाजो गायत्री सविता ॥&lt;/summary&gt;&#xA;&lt;p&gt;अद्यनोदेव+++(षु)+++सवितरौहो+++(तु)+++वा+++(त)+++इ+++(श)+++। इहश्रुधाइ+++(षु)+++प्रजावा+++(टि)+++त्सा+++(त)+++वीस्सौ+++(टा)+++भगा+++(चा)+++। म्पा+++(य)+++रादू+++(टा)+++ष्वा+++(त)+++होवा+++(टा)+++हा+++(त)+++इ+++(श)+++। प्नियंसू+++(पि)+++वा+++(त्र)+++। दक्षा+++(ता)+++या+++(टख्)+++ ॥ १० ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - भारद्वाजस्यमौक्षेद्वे ॥ भरद्वाजो गायत्री सविता ॥&lt;/summary&gt;&#xA;&lt;p&gt;अद्या+++(खा)+++नोदेवसवितः+++(शू)+++। प्रजा+++(का)+++वत्सावीसौ+++(की)+++भगाम्पा+++(टि)+++रादू+++(खा)+++ष्वा+++(ण)+++। प्नियंसुवाउवा+++(कू)+++ओ+++(टट्)+++वा+++(ख)+++औहोवा+++(शि)+++। अस्माभ्य+++(चि)+++ङ्गा+++(त)+++तुवित्त+++(क)+++मा+++(ख)+++म् ॥ ११ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०८</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/2_tadvapAThaH/03_R-10_sA-20/08/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/2_tadvapAThaH/03_R-10_sA-20/08/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - प्रगाथः इन्द्रः गायत्री&lt;/summary&gt;&#xA;&lt;p&gt;क्वाट्ट्यस्या॓वृ॑षाभोयू॑वा । तुविग्री॒वोआ॒नानतः । ब्रह्मा॒कस्तंसा॒पर्यति ॥ ८ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - भारद्वाजानित्रीणि ॥ त्रयाणां भरद्वाजो गायत्रीन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;को+++(प)+++वस्यवा+++(फि)+++र्षभोयूवा+++(शी)+++। तुविग्री+++(चि)+++वो+++(क)+++आ+++(क)+++नानतो+++(कि)+++ब्रह्माका+++(टि)+++स्ता+++(त)+++म्। ऐ+++(टच्)+++हा+++(य)+++या+++(ट)+++ऐही+++(ता)+++। सा+++(क)+++पर्या+++(टा)+++ता+++(खण्)+++इ+++(श)+++। ओ+++(प)+++इळा+++(शा)+++ ॥ १२ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - भारद्वाजानित्रीणि ॥ त्रयाणां भरद्वाजो गायत्रीन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;कूवाकूवा+++(ती)+++। स्यावृ+++(चा)+++षाभोयूवा+++(टी)+++ओ+++(ख)+++हा+++(प्ल)+++हा+++(त)+++इ+++(श)+++। तुवी+++(का)+++ग्रीवो+++(थाच्)+++आनानता+++(टी)+++ओ+++(ख)+++हा+++(प्ल)+++हा+++(त)+++इ+++(श)+++। ब्रह्माका+++(टिट्)+++स्ता+++(ख)+++औहोवा+++(शि)+++। सपर्याती+++(खी)+++ ॥ १३ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - भारद्वाजानित्रीणि ॥ त्रयाणां भरद्वाजो गायत्रीन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;ऐहीऐही+++(ती)+++। क्वास्यवृषभो+++(षु)+++यूवाऐहीऐही+++(तू)+++। तुविग्रीवोआना+++(षू)+++नताऐहीऐही+++(तू)+++। ब्रह्माकस्तंसप+++(षू)+++र्याताऐहीऐही+++(तू)+++। आ+++(ट)+++इहा+++(खा)+++औहोवा+++(शि)+++। आ+++(ख)+++इही+++(शा)+++ ॥ १४ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
