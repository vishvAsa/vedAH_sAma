      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - मेधातिथिः काण्वः इन्द्रः गायत्री&lt;/summary&gt;&#xA;&lt;p&gt;आतीहीमन्यूषावीणं । सूषूवां॒सामू॒पै॑रय । अस्या॑रा॓तौ॑सूतंपी॑बा ॥ १ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - कौत्सञ्च ॥ कुत्सो गायत्रीन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;अतीहिमा+++(ती)+++। न्यूषा+++(टा)+++वाइणां+++(टि)+++। सूषूवां+++(चि)+++सा+++(टच)+++हो+++(क)+++उपै+++(या)+++राया+++(टा)+++। आस्यरा+++(कि)+++ताबुसू+++(टि)+++ता+++(ख)+++औहोवा+++(शि)+++। पी+++(ख)+++बा+++(श)+++ ॥ १ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०२</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/2_tadvapAThaH/12_R-10_sA-12/02/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/2_tadvapAThaH/12_R-10_sA-12/02/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - वामदेवो गौतमः इन्द्रः गायत्री&lt;/summary&gt;&#xA;&lt;p&gt;का॒दूप्रा॒चे॑तसेमहे॒ । वा॓चो॑देवाया॑शस्यते । तदी॓द्ध्या॑स्यावार्धा॒नम् ॥ २ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - काश्यपञ्चआप्सुरसंवा ॥ कश्यपो गायत्रीन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;कदूप्राचे+++(चि)+++ता+++(क)+++से+++(फ)+++महा+++(ता)+++इवा+++(पा)+++चो+++(श)+++देवाहाबुवचोदेवा+++(शृ)+++। याशस्या+++(टि)+++ता+++(ख)+++इतदा+++(खि)+++इधिया+++(ति)+++। स्या+++(क)+++वो+++(प)+++वा+++(प्ल)+++र्धानां+++(प्ला)+++। हाइ+++(शा)+++ ॥ २ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०३</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/2_tadvapAThaH/12_R-10_sA-12/03/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/2_tadvapAThaH/12_R-10_sA-12/03/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - मेधातिथिः काण्वः, प्रियमेधश्चांगिरसः इन्द्रः गायत्री&lt;/summary&gt;&#xA;&lt;p&gt;उक्थञ्चाना॒शस्या॒मा॑नं । ना॓गो॑रा॒यिरा॒ची॑केता । ना॓गा॒यत्रं॑गीयामानम् ॥ ३ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - बार्हदुक्थेद्वे ॥ द्वयोबृहदुक्थो गायत्रीन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;उक्थञ्चनो+++(ती)+++हा+++(त)+++इ+++(श)+++। शस्यमाना+++(षी)+++न्नागोरा+++(टिच्)+++इरा+++(चा)+++चिके+++(खा)+++ता+++(श)+++। नागाया+++(टि)+++त्रां+++(त)+++। गी+++(क)+++यामा+++(टा)+++ना+++(ख)+++औहोवा+++(शि)+++। ऊ+++(ख)+++पा+++(श)+++ ॥ ३ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०४</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/2_tadvapAThaH/12_R-10_sA-12/04/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/2_tadvapAThaH/12_R-10_sA-12/04/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - विश्वामित्रो गाथिनः इन्द्रः गायत्री&lt;/summary&gt;&#xA;&lt;p&gt;इ॓न्द्रा॑उक्थे॒भिर्म॑न्दीष्ठः । वा॒जा॑नांचावा॑ज॒प॑तिः । हा॒रीवा॑न्सूतानांसाखा॑ ॥ ४ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - बार्हदुक्थेद्वे ॥ द्वयोबृहदुक्थो गायत्रीन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;इन्द्रउक्था+++(ती)+++इ+++(शु)+++। भ्य+++(क)+++र्मन्दाइष्ठो+++(टी)+++वाजाना+++(खि)+++ञ्चा+++(ण)+++। वा+++(च)+++जपा+++(चा)+++तिर्हरा+++(टि)+++ईवा+++(खा)+++न्सू+++(ण)+++। तानां+++(काच्)+++सा+++(क)+++खाऔ+++(टा)+++हो+++(ख)+++बा+++(प्ल)+++। हो+++(प्ल)+++इळा+++(शा)+++ ॥ ४ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०५</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/2_tadvapAThaH/12_R-10_sA-12/05/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/2_tadvapAThaH/12_R-10_sA-12/05/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - मेधातिथिः काण्वः, प्रियमेधश्चांगिरसः इन्द्रः गायत्री&lt;/summary&gt;&#xA;&lt;p&gt;ब्र॒ह्मा॑णादीन्द्रारा॑धा॑साः । पी॒बा॓सो ॓मा॑मृतूंरा॒नू । तवे॓दु॑सख्या॒मस्तृतम् ॥ ५ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - और्ध्वसद्मनेद्वे प्रहितोर्वा संयोजने ॥ ऊर्ध्वसद्मा गायत्रीन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;ब्राह्मणादी+++(ती)+++। न्द्ररा+++(का)+++धसाःपिबा+++(की)+++सोमा+++(टा)+++मृतूं+++(का)+++रनू+++(चा)+++। तावे+++(का)+++दूसा+++(टा)+++ख्या+++(प)+++मा+++(श)+++स्ता+++(ख)+++र्त्ता+++(प्ल)+++। हाइ+++(शा)+++ ॥ ५ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०६</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/2_tadvapAThaH/12_R-10_sA-12/06/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/2_tadvapAThaH/12_R-10_sA-12/06/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - दुमित्रः (सुमित्रो वा) कौत्सः इन्द्रः गायत्री&lt;/summary&gt;&#xA;&lt;p&gt;वा॓यङ्घा॑तेआपी॑स्मसि । स्तोता॒र॑इन्द्र॓गिर्वणः । त्व॒न्नोजिन्वसोमपः ॥ ६ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - और्ध्वसद्मनेद्वे प्रहितोर्वा संयोजने ॥ ऊर्ध्वसद्मा गायत्रीन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;वयङ्घाते+++(फी)+++अपी+++(शा)+++स्मसा+++(का)+++इ+++(श)+++। स्तो+++(क)+++तारइन्द्रगिर्वणा+++(षृ)+++उवउवा+++(टी)+++हो+++(च)+++इ+++(श)+++। तू+++(च)+++वा+++(य)+++न्नोजी+++(टा)+++उवउवा+++(टी)+++हो+++(कथ्)+++न्वा+++(श)+++सोमा+++(टाट्)+++पा+++(ख)+++औहोवा+++(शि)+++। ए+++(त)+++ऊपा+++(टाख्)+++ ॥ ६ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०७</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/2_tadvapAThaH/12_R-10_sA-12/07/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/2_tadvapAThaH/12_R-10_sA-12/07/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - मेधातिथिः काण्वः इन्द्रः गायत्री&lt;/summary&gt;&#xA;&lt;p&gt;आ॑याह्यू॒पा॑नास्सू॒तं । वा॓जेभिर्मा॑हृ॑णीयथा । माहं॓ईवा॑यूवा॒जानि ॥ ७ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - कौत्सानिचत्वारि ॥ कुत्सो गायत्रीन्द्रः ॥ द्वयोः कुत्सो भुरिग्गायत्रीन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;आयाही+++(ति)+++। ऊ+++(च)+++पाना+++(चा)+++स्सूतं+++(शा)+++होवा+++(टा)+++हा+++(त)+++इ+++(श)+++। वाजेभि+++(कि)+++माहृणी+++(कि)+++यथा+++(ता)+++होवा+++(टा)+++हा+++(त)+++इ+++(श)+++। माहं+++(चा)+++ईवायुवा+++(टी)+++होवा+++(टा)+++हा+++(त)+++इ+++(श)+++। जा+++(टट्)+++ना+++(ख)+++औहोवा+++(शि)+++। उऊ+++(खा)+++पा+++(श)+++ ॥ ७ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०८</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/2_tadvapAThaH/12_R-10_sA-12/08/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/2_tadvapAThaH/12_R-10_sA-12/08/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - मेधातिथिः काण्वः इन्द्रः गायत्री&lt;/summary&gt;&#xA;&lt;p&gt;का॓दा॒वासोस्तोत्रं॓ह ॓र्याताआ । आव॑श्मशा॓रूधाद्वाः॒ । दीर्घं॒सूतं॒वा॒ता॒प्या॑या ॥ ८ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - कौत्सानिचत्वारि ॥ कुत्सो गायत्रीन्द्रः ॥ द्वयोः कुत्सो भुरिग्गायत्रीन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;ओ+++(टच्)+++हो+++(च)+++इ+++(श)+++कादा+++(का)+++वसो+++(फा)+++स्तोत्रां+++(टा)+++हर्यता+++(खि)+++या+++(श)+++। ओ+++(टच्)+++हो+++(च)+++इ+++(श)+++यावा+++(का)+++श्माशा+++(फा)+++रूधादू+++(खि)+++वाः+++(ण)+++। ओ+++(टच्)+++हो+++(च)+++इ+++(श)+++दीर्घं+++(का)+++सूतं+++(फा)+++वाता+++(पा)+++पीया+++(खा)+++या+++(त्र)+++। ई+++(ख)+++ ॥ ८ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - कौत्सानिचत्वारि ॥ कुत्सो गायत्रीन्द्रः ॥ द्वयोः कुत्सो भुरिग्गायत्रीन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;कादा+++(खा)+++औ+++(क)+++होवा+++(था)+++वासोस्तोत्रां+++(टी)+++हर्यता+++(खि)+++या+++(श)+++। अवा+++(खा)+++औ+++(क)+++होवा+++(था)+++। । श्मशा+++(का)+++रूधादू+++(खि)+++वाः+++(ण)+++। दीर्घा+++(खा)+++औ+++(क)+++होवा+++(था)+++। सूतां+++(टा)+++। वाता+++(खा)+++पीया+++(खा)+++। या+++(त्र)+++ ॥ ९ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - कौत्सानिचत्वारि ॥ कुत्सो गायत्रीन्द्रः ॥ द्वयोः कुत्सो भुरिग्गायत्रीन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;औ+++(च)+++होवाइ+++(शि)+++कादावा+++(कि)+++सो+++(फ)+++स्तोत्रां+++(टा)+++हर्याता+++(खि)+++या+++(श)+++। औ+++(च)+++होवाइ+++(शि)+++यावा+++(का)+++श्माशा+++(फा)+++रूधादू+++(खि)+++वाः+++(ण)+++। औ+++(च)+++होवाइ+++(शि)+++दीर्घं+++(का)+++सूतं+++(फा)+++वाता+++(पा)+++पीया+++(खा)+++या+++(त्र)+++। ए+++(तच्)+++ ॥ १० ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०९</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/2_tadvapAThaH/12_R-10_sA-12/09/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/2_tadvapAThaH/12_R-10_sA-12/09/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - विश्वामित्रो गाथिनोऽभीपाद उदलो वा इन्द्रः गायत्री&lt;/summary&gt;&#xA;&lt;p&gt;ए॓न्द्रा॑पृक्षूका॑सूचीत् । नृम्णं॒तानू॒षू॑धेहिनः । स॒त्रा॒जिदुग्रापौं१स्यम् ॥ ९ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - अभिवादस्यचऔदलस्यसाम ॥ उदलो निचृत्गायत्रीन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;एन्द्रपृक्षु+++(षी)+++कासुची+++(ति)+++दे+++(त)+++। नृम्णा+++(चा)+++तनू+++(काच्)+++षूधा+++(का)+++हा+++(य)+++इनाः+++(टा)+++। सा+++(च)+++त्रा+++(श)+++जिदू+++(चा)+++ग्रापा+++(टा)+++पुंसिया+++(कि)+++उवा+++(ता)+++। ऊ+++(ख)+++पा+++(श)+++ ॥ ११ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>१०</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/2_tadvapAThaH/12_R-10_sA-12/10/</link>
