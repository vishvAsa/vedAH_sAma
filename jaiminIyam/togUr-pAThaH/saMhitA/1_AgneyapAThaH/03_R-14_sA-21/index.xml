    <item>
      <title>०१</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/03_R-14_sA-21/01/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/03_R-14_sA-21/01/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - प्रयोगो भागर्वः अग्निः गायत्री&lt;/summary&gt;&#xA;&lt;p&gt;अग्निंवोवृधन्तं । अध्वाराणांपुरूतामं । अच्छानाप्नेसाहा॒स्वते ॥ १ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - सैन्धुक्षितानित्रीणि ॥ त्रयाणां सिन्धुक्षिगायत्र्यग्निः ॥ (स्वारं सैन्धुक्षितम्) ॥&lt;/summary&gt;&#xA;&lt;p&gt;अग्निंवोवृधा+++(तु)+++न्ता+++(त)+++म्। आध्वा+++(चा)+++राणां+++(थाच्)+++पूरू+++(का)+++ता+++(य)+++मौ+++(ट)+++होवा+++(टा)+++हा+++(त)+++इ+++(श)+++। आच्छा+++(टा)+++नाप्त्रे+++(टा)+++। सा+++(क)+++हो+++(प)+++बा+++(प्ल)+++स्वातो+++(प्ला)+++। हाइ+++(शा)+++ ॥ १ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - सैन्धुक्षितानित्रीणि ॥ त्रयाणां सिन्धुक्षिगायत्र्यग्निः ॥ (स्वारं सैन्धुक्षितम्) ॥&lt;/summary&gt;&#xA;&lt;p&gt;अग्निंवा+++(ति)+++ए+++(त)+++। वृधन्ता+++(षि)+++मध्वराणांपुरू+++(कू)+++तममच्छा+++(टीच्)+++हो+++(य)+++इना+++(टा)+++प्त्रे+++(त)+++। साहास्वा+++(पि)+++ता+++(त्र)+++इ+++(श)+++। ई+++(ख)+++ति+++(श)+++ ॥ २ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - सैन्धुक्षितानित्रीणि ॥ त्रयाणां सिन्धुक्षिगायत्र्यग्निः ॥ (स्वारं सैन्धुक्षितम्) ॥&lt;/summary&gt;&#xA;&lt;p&gt;अग्निंवो+++(ति)+++हा+++(त)+++इ+++(श)+++। वृधा+++(टा)+++न्ता+++(त)+++म्। आध्वराणांपुरू+++(यू)+++ता+++(प)+++मा+++(श)+++म्। अच्छानप्त्रो+++(खी)+++हा+++(ण)+++इ+++(श)+++। सा+++(क)+++हो+++(प)+++हा+++(च)+++इ+++(श)+++। स्वा+++(क)+++ताऔ+++(टा)+++हो+++(ख)+++बा+++(प्ल)+++। हो+++(प्ल)+++इळा+++(शा)+++ ॥ ३ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०२</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/03_R-14_sA-21/02/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/03_R-14_sA-21/02/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - भाद्वाजो बार्हस्पत्यः अग्निः गायत्री&lt;/summary&gt;&#xA;&lt;p&gt;अग्निस्तिग्मे॓ना॑शोचीषा॑ । यंसद्वि॒श्वंन्या३त्रीणं । अ॒ग्नि॒र्नो॑वंसतेरायिम्॓ ॥ २ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - अग्नेर्हरसीद्वे ॥ द्वयोरग्निर्गायत्र्यग्निः ॥&lt;/summary&gt;&#xA;&lt;p&gt;आग्ना+++(टा)+++उवो+++(खा)+++वा+++(श)+++। तिग्मे+++(थाच्)+++ना+++(क)+++शोचाइषा+++(टी)+++उवो+++(खा)+++वा+++(श)+++। यंसा+++(टा)+++उवो+++(खा)+++वा+++(श)+++। वाइश्वान्यात्राइणा+++(टू)+++उवो+++(खा)+++वा+++(श)+++। अग्निर्नो+++(टि)+++वंसते+++(किच्)+++रायी+++(चा)+++म् ॥ ४ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - अग्नेर्हरसीद्वे ॥ द्वयोरग्निर्गायत्र्यग्निः ॥&lt;/summary&gt;&#xA;&lt;p&gt;ओहायाग्नीः+++(ती)+++। ता+++(ख)+++इग्मे+++(शा)+++नाशोचा+++(खि)+++इषा+++(णा)+++। यंसा+++(टा)+++द्वा+++(ख)+++इश्वा+++(शा)+++नीयात्रा+++(खि)+++इण+++(णा)+++म्। अग्निर्नो+++(टि)+++वंसा+++(टाट्)+++ता+++(ख)+++औहोवा+++(शि)+++। रा+++(ख)+++यि+++(श)+++म् ॥ ५ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - इहवद्वामदेव्यंतृतीयम् ॥ वामदेवो गायत्र्यग्निः ॥&lt;/summary&gt;&#xA;&lt;p&gt;अग्निस्तिग्मे+++(षी)+++नशोचिषाइहा+++(तू)+++। यंसद्विश्व+++(षी)+++न्न्यत्रीणा+++(टि)+++मिहा+++(ता)+++। अग्निर्नोवंसता+++(टू)+++इहा+++(ता)+++। रा+++(प)+++आयाइं+++(प्लि)+++। हाइ+++(शा)+++ ॥ ६ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०३</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/03_R-14_sA-21/03/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/03_R-14_sA-21/03/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - वामदेवो गौतमः अग्निः गायत्री&lt;/summary&gt;&#xA;&lt;p&gt;अग्नेमृ॓ळामाहंआ॑सि॑ । आ॒याआ॓दे॑वायुन्ज॑नम् । ईये॓थाबर्ही॑रासादम् ॥ ३ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - यामेद्वे ॥ यमो गायत्र्यग्निः ॥&lt;/summary&gt;&#xA;&lt;p&gt;अग्नाइमृळा+++(टु)+++महंया+++(खि)+++सी+++(ण)+++। आयआदा+++(टी)+++इवयुन्जा+++(खी)+++न+++(ण)+++म्। ईयेथाबा+++(टी)+++र्हिरासा+++(खि)+++। दा+++(त्र)+++म् ॥ ७ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - यामेद्वे ॥ यमो गायत्र्यग्निः ॥&lt;/summary&gt;&#xA;&lt;p&gt;आ+++(ण)+++ग्ने+++(फ)+++मृळामा+++(फि)+++हंयासि+++(फि)+++ओहा+++(खा)+++ओ+++(ख)+++हा+++(श)+++। आ+++(ण)+++या+++(फ)+++आदेवा+++(फि)+++युन्जना+++(फि)+++मो+++(ख)+++हाओ+++(खा)+++हा+++(श)+++। इयाईथा+++(टी)+++बर्हिरासा+++(खा)+++। दा+++(त्र)+++म् ॥ ८ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०४</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/03_R-14_sA-21/04/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/03_R-14_sA-21/04/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - वसिष्ठो मैत्रावरुणिः अग्निः गायत्री&lt;/summary&gt;&#xA;&lt;p&gt;अ॒ग्नेर॓क्षाणोअं॒हा॑सः । प्रा॒तीस्मदेवरिषाताः । ता॒पीष्ठैराज॒रोदहा ॥ ४ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - अग्नेराक्षोघ्नेद्वे ॥ अग्निर्गायत्र्यग्निः ॥&lt;/summary&gt;&#xA;&lt;p&gt;अग्नेराक्षा+++(खी)+++णो+++(श)+++अंहासः+++(प्लि)+++। प्रातिस्मदे+++(की)+++वारीषा+++(टि)+++ताः+++(त)+++। तापाइष्ठा+++(टी)+++इरा+++(ता)+++। जरोदा+++(टि)+++हा+++(खण्)+++। ओ+++(प)+++इळा+++(शा)+++ ॥ ९ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०५</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/03_R-14_sA-21/05/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/03_R-14_sA-21/05/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - भाद्वाजो बार्हस्पत्यः अग्निः गायत्री&lt;/summary&gt;&#xA;&lt;p&gt;अ॓ग्नेयुंक्ष्वाहीयेता॒वा॑ । अश्वा॑सोदेवासाधावाः । आ॒रं॑वा॓ह॑न्त्याशा॒वाः॑ ॥ ५ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - अग्नेराक्षोघ्नेद्वे ॥ अग्निर्गायत्र्यग्निः ॥&lt;/summary&gt;&#xA;&lt;p&gt;अग्नेयूङ्क्ष्वा+++(खी)+++ही+++(श)+++येतावा+++(प्लि)+++। अश्वासोदे+++(ची)+++वासाधा+++(टि)+++वाः+++(त)+++। आरंवा+++(टि)+++हा+++(त)+++न्ती+++(क)+++याशा+++(टा)+++वाः+++(खण्)+++। ओ+++(प)+++इळा+++(शा)+++ ॥ १० ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०६</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/03_R-14_sA-21/06/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/03_R-14_sA-21/06/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - वसिष्ठो मैत्रावरुणिः अग्निः गायत्री&lt;/summary&gt;&#xA;&lt;p&gt;नित्वा॑नक्ष्यविस्पते । धू॒म॑न्त॒न्धीमहेवायम् । सु॒वी॒रामग्नआ॓हुतः ॥ ६ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - वैश्वमनसञ्च ॥ विश्वमना गायत्र्यग्निः ॥&lt;/summary&gt;&#xA;&lt;p&gt;नित्वाहो+++(खि)+++इनक्ष्या+++(शि)+++। वा+++(च)+++इस्पाता+++(चि)+++इ+++(श)+++द्यू+++(क)+++मन्त+++(था)+++न्धाइमा+++(चि)+++हे+++(क)+++वा+++(ख)+++य+++(ण)+++म्। सुवो+++(ता)+++हा+++(त)+++इ+++(श)+++। रामग्ना+++(चि)+++ओ+++(प)+++बाहूतो+++(प्लि)+++। हाइ+++(शा)+++ ॥ ११ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०७</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/03_R-14_sA-21/07/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/03_R-14_sA-21/07/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - विरूप आंगिरसः अग्निः गायत्री&lt;/summary&gt;&#xA;&lt;p&gt;अ॒ग्नि॒र्मूर्द्धादीवाःकाकू॒त् । पा॒तीःपृथिव्या॒आ॒यम् । आपांरेतांसिजिन्वति ॥ ७ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - अग्नेश्चार्षेयम् ॥ अग्निर्गायत्र्यग्निः ॥&lt;/summary&gt;&#xA;&lt;p&gt;अग्निर्मूर्धादी+++(तु)+++वःककू+++(ति)+++त्। पातीः+++(टा)+++पार्त्थी+++(टा)+++व्याअया+++(चि)+++म्। आपां+++(टा)+++राइतां+++(टि)+++सी+++(क)+++जिन्वा+++(टा)+++ता+++(खण्)+++इ+++(श)+++। ओ+++(प)+++इळा+++(प्ला)+++ ॥ १२ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०८</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/03_R-14_sA-21/08/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/03_R-14_sA-21/08/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - शुनः शेप आजीर्गितः अग्निः गायत्री&lt;/summary&gt;&#xA;&lt;p&gt;ई॒मामू॑षुत्वाम॒स्मा॑कम् । सा॒नि॓ङ्गा॑यात्र॒न्नव्या॑सम् । अग्ने॑दे॒वे॒षुप्रा॒वोचः ॥ ८ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - सोमसामच ॥ सोमो गायत्र्यग्निः ॥&lt;/summary&gt;&#xA;&lt;p&gt;इममूषू+++(ती)+++। त्वामास्मा+++(टि)+++का+++(त)+++म्। सानिं+++(टा)+++होइगाया+++(टी)+++हो+++(क)+++तृ+++(थ)+++न्नव्यां+++(टा)+++सा+++(ता)+++म्। आग्ने+++(टा)+++होइदेवा+++(टी)+++हो+++(कथ्)+++षुप्रावो+++(टि)+++चाः+++(खण्)+++। ओ+++(प)+++इळा+++(प्ला)+++ ॥ १३ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०९</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/03_R-14_sA-21/09/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/03_R-14_sA-21/09/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - गोपवन अत्रयेः अग्निः गायत्री&lt;/summary&gt;&#xA;&lt;p&gt;तन्त्वा॑गोपा॒वा॑नोगिरा । जा॒नि॑ष्ठदग्नेअङ्गिरः । सा॒पा॑वकाश्रू॑धीहा॒व॑म् ॥ ९ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - गोपवनञ्च ॥ गोपवनो गायत्र्यग्निः ॥&lt;/summary&gt;&#xA;&lt;p&gt;तन्त्वागोपा+++(ती)+++। वानो+++(टा)+++गा+++(ख)+++इराः+++(णा)+++। जना+++(चा)+++इष्ठादग्नाया+++(टू)+++ङ्गा+++(ख)+++इराः+++(णा)+++। सपौवाउवो+++(खु)+++वा+++(श)+++कौवाउवो+++(खि)+++वा+++(ण)+++। श्रुधीहवां+++(प्ली)+++। हो+++(प)+++इळा+++(शा)+++ ॥ १४ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>१०</title>
