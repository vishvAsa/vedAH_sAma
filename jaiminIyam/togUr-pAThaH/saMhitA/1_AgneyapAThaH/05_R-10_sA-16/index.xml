    <item>
      <title>०१</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/05_R-10_sA-16/01/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/05_R-10_sA-16/01/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - वसिष्ठो मैत्रावरुणिः अग्निः बृहती&lt;/summary&gt;&#xA;&lt;p&gt;ए॒नावो॒अग्नि॒न्ना॒मा॑सा । ऊर्जो॓नापातामाहू॑वे । प्री॒यञ्चेतिष्ठामारातिं॓स्वाध्वारं॒ । विश्वा॑स्यादूता॓मामृत॑म् ॥ १ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - अग्नेराग्नेयेद्वे ॥ द्वयोरग्निर्बृहत्यग्निः ॥&lt;/summary&gt;&#xA;&lt;p&gt;एनावोअग्निन्ना+++(तू)+++ओमसा+++(ति)+++। ऊर्जोनपा+++(की)+++तामा+++(या)+++हुवे+++(टा)+++। प्रायन्चे+++(चि)+++तिष्ठा+++(टा)+++मारतिं+++(चि)+++सूआध्वारां+++(भि)+++। विश्वा+++(चा)+++स्या+++(य)+++दू+++(ट)+++। ता+++(च)+++मामृ+++(चा)+++ता+++(क)+++मिळा+++(टा)+++भा+++(खण्)+++। ओ+++(प)+++इळा+++(शा)+++ ॥ १ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - अग्नेराग्नेयेद्वे ॥ द्वयोरग्निर्बृहत्यग्निः ॥&lt;/summary&gt;&#xA;&lt;p&gt;एनावोअग्नि+++(षु)+++न्नामसा+++(तू)+++हा+++(त)+++बु+++(श)+++। ऊर्जोनपा+++(की)+++तामा+++(या)+++हुवे+++(टा)+++हा+++(त)+++बु+++(श)+++। प्रायन्चे+++(चि)+++तिष्ठा+++(टा)+++मारतिं+++(चि)+++सू+++(ट)+++आध्वारां+++(भि)+++हा+++(त)+++बु+++(श)+++। विश्वा+++(चा)+++स्या+++(य)+++दू+++(ट)+++हा+++(त)+++बु+++(श)+++। ता+++(च)+++मामृ+++(चा)+++ता+++(क)+++मिळा+++(टा)+++भा+++(खण्)+++। ओ+++(प)+++इळा+++(शा)+++ ॥ २ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - गौतमस्यमनार्येद्वे ॥ द्वयोर्गोतमो बृहत्यग्निः ॥&lt;/summary&gt;&#xA;&lt;p&gt;एनावोअग्निम्मे+++(तू)+++नमसा+++(ति)+++। ऊ+++(क)+++र्जोनपा+++(टिच्)+++तामा+++(चा)+++हुवे+++(का)+++प्रा+++(ट)+++या+++(त)+++म्। चाइती+++(चि)+++ष्ठामा+++(का)+++रतिं+++(टाच्)+++सूआ+++(का)+++ध्वा+++(य)+++रा+++(ट)+++म्। विश्वा+++(का)+++स्या+++(य)+++दू+++(ट)+++। ता+++(च)+++मामृ+++(चा)+++ता+++(क)+++मिळा+++(टा)+++भा+++(खण्)+++। ओ+++(प)+++इळा+++(शा)+++ ॥ ३ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - गौतमस्यमनार्येद्वे ॥ द्वयोर्गोतमो बृहत्यग्निः ॥&lt;/summary&gt;&#xA;&lt;p&gt;एनावोअग्निन्न+++(षू)+++मसऊर्जोनपो+++(तू)+++वा+++(त)+++। तामा+++(चा)+++हुवे+++(का)+++प्रा+++(ट)+++या+++(त)+++म्। चाइती+++(चि)+++ष्ठामा+++(का)+++रा+++(ट)+++तीं+++(त)+++। स्वा+++(थ)+++ध्वारंविश्वस्या+++(टु)+++दू+++(त)+++। ता+++(च)+++मामृ+++(चा)+++ता+++(क)+++मिळा+++(टा)+++भा+++(खण्)+++। ओ+++(प)+++इळा+++(शा)+++ ॥ ४ ॥&lt;/p&gt;</description>
    </item>
    <item>
      <title>०२</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/05_R-10_sA-16/02/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/05_R-10_sA-16/02/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - भगः प्रागाथः अग्निः बृहती&lt;/summary&gt;&#xA;&lt;p&gt;शे॒षेवा॒ने॑षूमातृ॑षु । स॒न्त्वामर्क्ता॑सइन्धते । आत॑न्द्रोहव्यं॒वा॑हसिहाविष्कृताः॑ । आ॒दि॒द्देवेषु॑राजसि ॥ २ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - दैवोराजञ्च ॥ देवराड् (गौतमः) बृहत्यग्निः ॥&lt;/summary&gt;&#xA;&lt;p&gt;शेषेवना+++(फी)+++इषुमातृषू+++(कु)+++। सान्त्वा+++(का)+++मार्ता+++(काच्)+++सा+++(क)+++इन्धा+++(टा)+++ता+++(त)+++इ+++(श)+++। आतन्द्रो+++(किच्)+++हव्यं+++(चा)+++वहा+++(का)+++साइहावी+++(टी)+++ष्का+++(ख)+++र्ताः+++(ण)+++। आदिद्दे+++(कि)+++वा+++(च)+++इ+++(श)+++। षूराजा+++(टि)+++जा+++(टि)+++सा+++(खण्)+++इ+++(श)+++। ओ+++(प)+++इळा+++(शा)+++ ॥ ५ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०३</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/05_R-10_sA-16/03/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/05_R-10_sA-16/03/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - सोभिरः काण्वः अग्निः बृहती&lt;/summary&gt;&#xA;&lt;p&gt;अ॒द॑र्शीगातूवि॒क्ता॑मः । यस्मि॑न्व्राता॓न्याद॒धुः॒ । ऊपोषूजाता॓मा ॓र्यास्यावार्थानं । अ॒ग्नि॒न्ना॑क्षन्तूनोगीराः॑ ॥ ३ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - गाधिनश्चकौशिकस्यसाम ॥ कौशिको गाथिः बृहत्यग्निः ॥&lt;/summary&gt;&#xA;&lt;p&gt;अदर्शिगा+++(षी)+++तुवित्तमा+++(तु)+++ए+++(त)+++। यास्मिन्व्रा+++(की)+++तान्या+++(टाच्)+++दधुरू+++(कि)+++पो+++(य)+++षूजा+++(टा)+++हा+++(त)+++हा+++(त)+++इ+++(श)+++। तामा+++(चा)+++र्या+++(क)+++स्यावा+++(चा)+++र्धाना+++(का)+++मग्ना+++(का)+++इन्नक्षा+++(टि)+++हा+++(त)+++हान्तुनोगी+++(ची)+++राइळा+++(टि)+++भा+++(खण्)+++। ओ+++(प)+++इळा+++(शा)+++ ॥ ६ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०४</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/05_R-10_sA-16/04/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/05_R-10_sA-16/04/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - मनवुर्वैस्वस्तः अग्निः बृहती&lt;/summary&gt;&#xA;&lt;p&gt;अग्नी॒रूत्थेपूरो॒हितः॒ । ग्रावा॑णोबर्हीरा॑ध्वारे॒ । ऋचा॒या॑मिमरुतोब्रह्मणस्पते । देवंआ॒वोवा॒रेण्यम् ॥ ४ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - बार्हदुत्थेद्वे ॥ द्वयोर्वृहदुक्थो बृहत्यग्निः ॥&lt;/summary&gt;&#xA;&lt;p&gt;अग्निरुक्था+++(ती)+++इ+++(श)+++। पुरोहा+++(खि)+++इताः+++(णा)+++। ग्रा+++(क)+++वाणो+++(का)+++ब+++(च)+++र्हीराध्वा+++(खि)+++रा+++(ण)+++इ+++(श)+++। ऋचायामि+++(षी)+++मरुतोब्रह्मा+++(चु)+++णा+++(य)+++स्पाता+++(टा)+++इ+++(श)+++। दाइवं+++(टि)+++आवो+++(टाच्)+++वा+++(क)+++रो+++(प)+++बा+++(प्ल)+++णाया+++(प्ला)+++म्। हाइ+++(शा)+++ ॥ ७ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - बार्हदुत्थेद्वे ॥ द्वयोर्वृहदुक्थो बृहत्यग्निः ॥&lt;/summary&gt;&#xA;&lt;p&gt;अग्निरुक्थाबुहो+++(तू)+++हो+++(त)+++हा+++(त)+++इ+++(श)+++। पुरौवाउवो+++(खु)+++वाहितः+++(शि)+++। ग्रा+++(क)+++वाणो+++(का)+++बर्हिरौ+++(कि)+++वाउवो+++(खि)+++वाध्वराइ+++(शी)+++। ऋचौ+++(टा)+++हो+++(त)+++यामिमरुतो+++(षु)+++ब्रह्माणा+++(यि)+++स्पाता+++(टा)+++इ+++(श)+++। दाइवं+++(टि)+++आवो+++(टाच्)+++वा+++(क)+++रो+++(प)+++बा+++(प्ल)+++णाया+++(प्ला)+++म्। हाइ+++(शा)+++ ॥ ८ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०५</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/05_R-10_sA-16/05/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/05_R-10_sA-16/05/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - सुदीतिपुरुमी-ळावांगिरसौ अग्निः बृहती&lt;/summary&gt;&#xA;&lt;p&gt;अग्नी॓मीळिष्वा॒वा॑से । गा॒था॑भीश्शीरा॒शो॑चिषं । अ॒ग्निं॒राये॒पू॑रूमिढाश्रूतन्ना॒राः॑ । अग्निस्सू॑दीताये॓च्छार्दिः ॥ ५ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - पौरुमीढञ्च ॥ पुरुमीढो बृहत्यग्निः ॥&lt;/summary&gt;&#xA;&lt;p&gt;अग्निमी+++(फि)+++ळिष्वा+++(खा)+++औ+++(ण)+++हो+++(फ)+++वा+++(श)+++। अवसे+++(कि)+++गाधाभी+++(चि)+++श्शी+++(थ)+++रा+++(क)+++शोचा+++(टा)+++इषा+++(ता)+++म्। अग्निंरायाइ+++(ष)+++पुरूमा+++(टि)+++इढा+++(ता)+++। श्रूतन्नरोअग्निस्सू+++(टू)+++दी+++(त)+++। तायाइच्छा+++(पी)+++र्दी+++(त्र)+++। दक्षा+++(ता)+++या+++(टाख्)+++ ॥ ९ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०६</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/05_R-10_sA-16/06/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/05_R-10_sA-16/06/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - प्रस्कण्वः काण्वः अग्निः बृहती&lt;/summary&gt;&#xA;&lt;p&gt;श्रूधि॒श्रुत्कर्णावन्ही॑भिः । देवैरा॑ग्ने॒सायावा॑भिः । आसी॑दतुबर्ही॒षी॑मित्रो॓अर्यामा । प्रात॒र्या॒वा॑भीराध्वारे॒ ॥ ६ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - कार्णश्रवसम् ॥ कर्णश्रवा बृहत्यग्निः ॥&lt;/summary&gt;&#xA;&lt;p&gt;श्रुधी+++(ता)+++श्रू+++(प)+++धिश्रुत्कर्णवन्हिभाइः+++(शृ)+++। दे+++(क)+++वैराग्ने+++(कि)+++सायावा+++(टि)+++भीः+++(त)+++। आ+++(क)+++सीदतुबर्हिषि+++(षू)+++मित्रोअर्या+++(टी)+++मा+++(त)+++। प्रा+++(क)+++तर्या+++(टा)+++वा+++(त)+++। भा+++(ट)+++इरा+++(खा)+++औहोवा+++(शि)+++। ए+++(त)+++ध्वरा+++(ता)+++या+++(ख)+++ ॥ १० ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०७</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/05_R-10_sA-16/07/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/05_R-10_sA-16/07/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - सोभिरः काण्वः अग्निः बृहती&lt;/summary&gt;&#xA;&lt;p&gt;प्रदै॒वो॑दासोअग्निः । दे॒वइन्द्रोनाम॒ज्मा॒ना । आ॓नू॒मातारं॑पृथिवींवीवा॑वृते । तस्थौ॓ना ॓का॑स्याशर्माणि ॥ ७ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - दैवोदासञ्च ॥ दिवोदासो बृहत्यग्निः ॥&lt;/summary&gt;&#xA;&lt;p&gt;प्र+++(ष)+++दैवोदासोअग्नीः+++(तू)+++। दे+++(क)+++वइन्द्रो+++(कि)+++नामज्माना+++(ची)+++म्। आनूमा+++(टिच्)+++ता+++(क)+++रं+++(च)+++पृथिवीं+++(टि)+++विवावृता+++(ची)+++इ+++(श)+++। तस्थौना+++(भि)+++का+++(त)+++। स्याश+++(का)+++र्मणिइळा+++(टि)+++भा+++(खण)+++। ओ+++(प)+++इळा+++(शा)+++ ॥ ११ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०८</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/05_R-10_sA-16/08/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/05_R-10_sA-16/08/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - मेधातिमध्येआतिथी काण्वौ इन्द्रः बृहती&lt;/summary&gt;&#xA;&lt;p&gt;आधा॑ज्मो॒आधा॑वादी॑वः । बृ॒हातो॓रो॑चानाद॒धी॑ । आया॒वा॓र्धस्वा॒तन्वा॒गीरा॒मामा । आजाता॒सूकृतॊ॑पृणा ॥ ८ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - सौकृतवञ्च ॥ सुक्रतुर्वृहत्यग्निः ॥&lt;/summary&gt;&#xA;&lt;p&gt;अधज्माओवा+++(तु)+++। आ+++(च)+++धावा+++(का)+++दा+++(य)+++इवाः+++(टा)+++। बृहतोरोचा+++(चु)+++ना+++(य)+++दाधि+++(टा)+++। आयौहो+++(कि)+++औहो+++(ता)+++वा+++(त)+++। वार्धस्वा+++(चि)+++तन्वा+++(था)+++गा+++(च)+++इरा+++(य)+++ममा+++(टा)+++। आजातासौ+++(की)+++होऔहो+++(ति)+++वा+++(त)+++। हा+++(फ)+++हाउवा+++(ति)+++। कृतोपृणा+++(खी)+++ ॥ १२ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
