    <item>
      <title>०१</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/09_R-10_sA-13/01/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/09_R-10_sA-13/01/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - गय आत्रयेः अग्निः अनुष्टुप्&lt;/summary&gt;&#xA;&lt;p&gt;अग्ना॓ओजीष्ठामा॒भा॑रा । धुम्नामस्माभ्या॑मधिगो । प्रा॓नो॓रा॑येपा॒नीयसे । रत्सीवा॓जायापन्थाम् ॥ १ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - पाथेद्वे ॥ द्वयोः पथोऽनुष्टुबग्निः ॥&lt;/summary&gt;&#xA;&lt;p&gt;आग्ना+++(टा)+++उवो+++(खा)+++वा+++(श)+++। ओजी+++(चा)+++ष्ठामाभारा+++(टा)+++उवो+++(खा)+++वा+++(श)+++। द्यु+++(क)+++म्नमस्मा+++(चि)+++भ्यमध्रिगो+++(ती)+++ओइप्राना+++(टी)+++उवो+++(खा)+++वा+++(श)+++। रा+++(क)+++येपानी+++(कि)+++यसे+++(ता)+++ओइरात्सा+++(टी)+++उवो+++(खा)+++वा+++(श)+++। वाजा+++(थाच्)+++या+++(क)+++प+++(ट)+++न्धा+++(ख)+++म् ॥ १ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - पाथेद्वे ॥ द्वयोः पथोऽनुष्टुबग्निः ॥&lt;/summary&gt;&#xA;&lt;p&gt;अग्ने+++(ता)+++हा+++(त)+++बु+++(श)+++। ओजीष्ठामा+++(यी)+++भारा+++(टा)+++औहो+++(खा)+++वा+++(श)+++। द्युम्नमस्मभ्यामा+++(यू)+++ध्रीगा+++(टा)+++औहो+++(खा)+++वा+++(श)+++। प्रानोरायेपानी+++(यू)+++यासा+++(टा)+++औहो+++(खा)+++वा+++(श)+++। रात्सी+++(टा)+++वाजा+++(टाच्)+++या+++(क)+++पो+++(प)+++बा+++(प्ल)+++न्धायां+++(प्ला)+++। हाइ+++(शा)+++ ॥ २ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०२</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/09_R-10_sA-13/02/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/09_R-10_sA-13/02/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - वामदेवः अग्निः अनुष्टुप्&lt;/summary&gt;&#xA;&lt;p&gt;या॓दीवीरो॑आनूष्यात् । अ॒ग्नी॒मि॒न्धीतामार्क्त्या: । आ॒जुह्वद्धेर्व्यमानूषाक् । शर्माभक्षितादै॒व्य॑म् ॥ २ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - बृहच्चाग्नेयम् ॥ अग्निरनुष्टुबग्निः ॥&lt;/summary&gt;&#xA;&lt;p&gt;यदिवीरो+++(षी)+++अनुष्यादय्या+++(खु)+++ई+++(ख)+++या+++(श)+++। अग्निमिन्धीतमौ+++(चू)+++हो+++(ट)+++हा+++(त)+++होवा+++(टा)+++र्त्याः+++(त)+++। आजु+++(टा)+++बाक्ता+++(टा)+++र्व्यामा+++(टा)+++नू+++(ख)+++षा+++(ण)+++त्। श+++(क)+++र्मभक्षाइतादा+++(टू)+++हा+++(त)+++इवा+++(ता)+++ओ+++(प)+++बा+++(प्ल)+++। व्या+++(ख)+++म् ॥ ३ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०३</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/09_R-10_sA-13/03/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/09_R-10_sA-13/03/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - भरद्वाजो बार्हस्पत्यः अग्निः अनुष्टुप्&lt;/summary&gt;&#xA;&lt;p&gt;त्वे॒ष॓स्ते॑धूमा॒ऋण्वति । दिविसत्शुक्रआ॒त॑तः । सू॒रोनहिद्यूतात्वं॒ । कृपापावा॒कारो॒चा॑से ॥ ३ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - कौन्मुदम् ॥ यमोऽनुष्टुबग्निः ॥&lt;/summary&gt;&#xA;&lt;p&gt;त्वे+++(क)+++षास्ते+++(पा)+++धूमऋण्वतीहाबु+++(शृ)+++। दिविसन्शू+++(ची)+++क्राआ+++(का)+++ता+++(य)+++ता+++(प)+++सूरोनहिहाबु+++(शू)+++। द्युता+++(चा)+++तू+++(य)+++वा+++(प)+++ङ्कृपापवाहाबु+++(शृ)+++। कारोचा+++(टि)+++सा+++(खण्)+++इ+++(श)+++। ओ+++(प)+++इळा+++(प्ला)+++ ॥ ४ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०४</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/09_R-10_sA-13/04/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/09_R-10_sA-13/04/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - भरद्वाजो बार्हस्पत्यः अग्निः अनुष्टुप्&lt;/summary&gt;&#xA;&lt;p&gt;त्वं॑हीक्षैता॒व॒द्या॒शाः । अ॓ग्ने॑मित्रो॒नापा॒त्या॑से । त्वंवि॑चर्षा॑णेश्रा॒वाः॑ । वासो॑पूष्टिन्ना॒पूष्यसि ॥ ४ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - बृहचैवाग्नेयम् ॥ अग्निरनुष्टुबग्निः ॥&lt;/summary&gt;&#xA;&lt;p&gt;त्वंहिक्षैतवद्य+++(षू)+++शइयइय्या+++(तु)+++हा+++(त)+++इ+++(श)+++। अग्नाइमित्रोना+++(कू)+++पात्या+++(खा)+++सा+++(ण)+++इ+++(श)+++। ओऔ+++(का)+++हो+++(ख)+++इया+++(प्ला)+++हा+++(ण)+++इ+++(श)+++। त्वंविचार्षणे+++(कु)+++श्रा+++(ख)+++वाः+++(ण)+++। ओऔ+++(का)+++हो+++(ख)+++इया+++(प्ला)+++हा+++(ण)+++इ+++(श)+++। वासो+++(का)+++आ+++(प)+++पुष्टाइन्नापू+++(कु)+++ष्या+++(ख)+++सी+++(ण)+++। ओऔ+++(का)+++हो+++(ख)+++इयाहा+++(प्लि)+++। हो+++(प्ल)+++इळा+++(शा)+++ ॥ ५ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०५</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/09_R-10_sA-13/05/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/09_R-10_sA-13/05/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - द्वितो भृगवुाहा आत्रयेः अग्निः अनुष्टुप्&lt;/summary&gt;&#xA;&lt;p&gt;प्रा॓ता॑रग्निःपूरूप्रीयः॒ । वीश॓स्तावेता॒तीथिः । विश्वेयास्मिन्ना॒मार्ये । हव्यंमर्ता॑साइन्धाते ॥ ५ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - कौन्मुदञ्चैव ॥ कुमुद्द्वृहदनुष्टुबग्निः ॥&lt;/summary&gt;&#xA;&lt;p&gt;प्रातरग्नाइःपू+++(तू)+++रूप्रीयाः+++(ति)+++। वीशा+++(का)+++स्तवे+++(टा)+++ताअतिथा+++(ती)+++इः+++(श)+++। वाइश्वेया+++(की)+++स्मिन्नामा+++(टि)+++र्ता+++(ख)+++या+++(ण)+++इ+++(श)+++। हाव्यां+++(टा)+++होइमर्ता+++(टी)+++हो+++(कथ्)+++साइन्धा+++(टि)+++ता+++(खण्)+++इ+++(श)+++। ओ+++(प)+++इळा+++(प्ला)+++ ॥ ६ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०६</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/09_R-10_sA-13/06/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/09_R-10_sA-13/06/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - वस्युव आत्रयेाः अग्निः अनुष्टुप्&lt;/summary&gt;&#xA;&lt;p&gt;य॓द्वाही॑ष्ठन्ता॑दग्ना॒ये । बृहा॒द॑र्चविभा॑वसो । माही॑षीवत्वा॒द्रायिः । त्व॓द्वा॑जाऊ॒दी॑रते ॥ ६ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - अग्नेर्यद्वाहिष्ठीयेद्वे ॥ द्वयोरग्निरनुष्टुबग्निः ॥&lt;/summary&gt;&#xA;&lt;p&gt;यद्वाहिष्ठन्तदा+++(तू)+++। ग्नायाइ+++(षि)+++बृहदर्चावी+++(तु)+++भावा+++(टा)+++सा+++(त)+++बु+++(श)+++। माही+++(टा)+++षाइवा+++(टि)+++त्वद्रयिस्त्वाद्वा+++(टू)+++जाः+++(त)+++। ऊदीरा+++(टि)+++ता+++(खण्)+++इ। ओ+++(प)+++इळा+++(शा)+++ ॥ ७ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - अग्नेर्यद्वाहिष्ठीयेद्वे ॥ द्वयोरग्निरनुष्टुबग्निः ॥&lt;/summary&gt;&#xA;&lt;p&gt;यद्वाहिष्ठन्तद+++(षु)+++ग्नयेयद्वाहिष्ठो+++(तू)+++वा+++(त)+++। तादग्नयाइ+++(षु)+++बृहदा+++(टि)+++र्चा+++(तच्)+++वी+++(क)+++भा+++(च)+++वासा+++(चा)+++बु+++(श)+++। महीषा+++(टि)+++इवा+++(ता)+++त्वद्रयीस्त्वाद्वा+++(टु)+++जाः+++(त)+++। ऊदीरा+++(टि)+++ता+++(खण्)+++इ। ओ+++(प)+++इळा+++(प्ला)+++ ॥ ८ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०७</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/09_R-10_sA-13/07/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/09_R-10_sA-13/07/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - गोपवन आत्रयेः अग्निः अनुष्टुप्&lt;/summary&gt;&#xA;&lt;p&gt;वी॒शोवी॒शोवोआ॒ती॑थिं । वज॒यन्ताःपूरूप्रीयम् । अ॒ग्निं॓वो॑दुर्यंवाचाः । स्तूषेशुषास्याम॒न्मा॑भिः ॥ ७ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - अग्नेश्चविशोविशीयम् ॥ अग्निरनुष्टुबग्निः ॥&lt;/summary&gt;&#xA;&lt;p&gt;विशोविशोहिंवो+++(तू)+++अतिथा+++(खि)+++इ+++(श)+++म्। वा+++(तच)+++जय+++(का)+++न्ताःपू+++(टा)+++रूप्री+++(प)+++या+++(श)+++म्। अग्निंवो+++(टि)+++दूरा+++(पा)+++या+++(श)+++हिम्मा+++(चा)+++इ+++(श)+++। वा+++(त)+++चा+++(त)+++स्तू+++(प)+++षेहा+++(णा)+++इ+++(श)+++। ओहो+++(का)+++वाइशू+++(खि)+++षा+++(ण)+++हिम्मा+++(चा)+++इ+++(श)+++। स्या+++(त)+++मा+++(त)+++न्मा+++(ख)+++भाएहिया+++(प्ली)+++हा+++(श)+++। हो+++(प्ल)+++इळा+++(शा)+++ ॥ ९ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०८</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/09_R-10_sA-13/08/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/09_R-10_sA-13/08/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - पूरुरात्रयेः अग्निः अनुष्टुप्&lt;/summary&gt;&#xA;&lt;p&gt;बृ॒ह॓द्वा॓योहीभा॒ना॒वे । अ॓र्चा॑देवा॒यअग्ना॒ये । यंमित्र॒न्नप्रा॒शा॑स्तये । म॒र्क्ता॑सोदधी॓रे॑पूरः ॥ ८ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - प्रजापतेःकनीनिकेद्वेअत्रेर्वा ॥ द्वयोरत्रिरनुष्टुबग्निः ॥&lt;/summary&gt;&#xA;&lt;p&gt;बृहद्वयाः+++(ती)+++। हीभाना+++(टि)+++वा+++(त)+++इ+++(श)+++। अर्चादेवायाग्ना+++(टू)+++या+++(त)+++इ+++(श)+++। यम्मित्रन्नप्राशा+++(यू)+++स्ताया+++(टा)+++इ+++(श)+++। मर्तासो+++(पि)+++दा+++(श)+++। धीरो+++(खा)+++बा+++(प्ल)+++पूरो+++(प्ला)+++। हाइ+++(शा)+++ ॥ १० ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - प्रजापतेःकनीनिकेद्वेअत्रेर्वा ॥ द्वयोरत्रिरनुष्टुबग्निः ॥&lt;/summary&gt;&#xA;&lt;p&gt;बृहद्वयो+++(षी)+++हिभानवा+++(ती)+++ए+++(त)+++। अर्चा+++(चा)+++देवा+++(थाच्)+++या+++(क)+++अग्ना+++(टा)+++या+++(त)+++इ+++(श)+++। यम्मित्र+++(कि)+++न्नप्रा+++(का)+++शा+++(य)+++स्ता+++(टा)+++इ+++(श)+++। मा+++(क)+++र्क्तासो+++(था)+++दधाइरे+++(यी)+++पुरा+++(टा)+++औहोहा+++(खि)+++औहोवा+++(शि)+++। वा+++(त)+++हाः+++(टख्)+++ ॥ ११ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०९</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/09_R-10_sA-13/09/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
