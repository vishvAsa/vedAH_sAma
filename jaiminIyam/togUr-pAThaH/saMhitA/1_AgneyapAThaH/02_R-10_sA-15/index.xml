    <item>
      <title>०१</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/02_R-10_sA-15/01/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/02_R-10_sA-15/01/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - आयुन्ङ्क्श्वाहिः (ऋ विरूपांगिरसः) अग्निः गायत्री&lt;/summary&gt;&#xA;&lt;p&gt;नामास्ते॒अग्ना॒ओज॑से । गृणन्तीदे॒वा॑कृष्टायाः । आमै॒रामित्रा॒मर्दया ॥ १ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - अग्नेश्चसंवर्गः ॥ सांवर्गः । अग्निः गायत्र्यग्निः ॥&lt;/summary&gt;&#xA;&lt;p&gt;नमस्तौहो+++(ति)+++ग्ना+++(त)+++इ+++(श)+++। ओजासा+++(कि)+++इगृणा+++(टि)+++न्ता+++(ख)+++इदे+++(णा)+++। वा+++(च)+++का+++(य)+++रिष्टायाः+++(टि)+++। आमाइरा+++(टीट्)+++मा+++(ख)+++औहोवा+++(शि)+++। त्रमर्दया+++(खी)+++ ॥ १ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०२</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/02_R-10_sA-15/02/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/02_R-10_sA-15/02/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - वामदेवो गौतमः अग्निः गायत्री&lt;/summary&gt;&#xA;&lt;p&gt;दूतंवो॑विश्वावे॑दसम् । हव्यावाहामामा॒र्क्त्यम्॑ । याजीष्ठमृन्जसे॒गीरा ॥ २ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - वैश्वमनसञ्च ॥ विश्वमनाः गायत्र्यग्निः ॥&lt;/summary&gt;&#xA;&lt;p&gt;दू+++(ण)+++तां+++(फ)+++वो+++(ख)+++विश्ववेदसा+++(शु)+++म्। हा+++(थ)+++व्यावाहाममा+++(टु)+++र्त्ता+++(ख)+++य+++(ण)+++म्। या+++(च)+++जिष्ठमृञ्जसे+++(टु)+++हा+++(त)+++इ+++(श)+++। गी+++(च)+++राऔ+++(टा)+++हो+++(ख)+++बा+++(प्ल)+++। हो+++(प्ल)+++इळा+++(शा)+++ ॥ २ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०३</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/02_R-10_sA-15/03/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/02_R-10_sA-15/03/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - प्रयोगो भागर्वः अग्निः गायत्री&lt;/summary&gt;&#xA;&lt;p&gt;ऊपात्वाजामायो॒गीराः॑ । देदीशतिर्हा॑विष्कृताः । वायोरा॑नीकेअस्थिरन् ॥ ३ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - श्नाभाश्नौष्टेद्वे ॥ श्नाभो गायत्र्यग्निः ॥&lt;/summary&gt;&#xA;&lt;p&gt;उपत्वाजा+++(ती)+++। मयो+++(टा)+++गीराः+++(टा)+++। ओइयायूर्दा+++(षु)+++इदिशतीर्हा+++(तू)+++विष्कृताः+++(टि)+++। ओ+++(क)+++इयायू+++(टिच्)+++र्वा+++(क)+++योरा+++(टा)+++नी+++(त)+++। कयास्था+++(खि)+++इरा+++(त्रा)+++न्। अश्वा+++(था)+++गा+++(ट)+++वाः+++(ख)+++ ॥ ३ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - श्नाभाश्नौष्टेद्वे ॥ श्नौष्टम् । श्नुष्टो गायत्र्यग्निः ॥&lt;/summary&gt;&#xA;&lt;p&gt;उपत्वाजामा+++(तु)+++योगीराः+++(ति)+++। दा+++(च)+++इ+++(श)+++दिशा+++(का)+++ताइर्हावि+++(टी)+++ष्का+++(ख)+++र्ताः+++(ण)+++। वायोरना+++(ती)+++हाइकाया+++(ती)+++। स्थाइरा+++(टि)+++औहो+++(खा)+++वाइळा+++(शि)+++ ॥ ४ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०४</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/02_R-10_sA-15/04/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/02_R-10_sA-15/04/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - मधुच्छन्दा वैश्वामित्रः अग्निः गायत्री&lt;/summary&gt;&#xA;&lt;p&gt;ऊ॑पात्वाग्नेदीवे॒दीवे । दो॒षा॑वस्तार्धीयावायम्॒ । ना॒मोभा॓र॑न्ताएमा॑सि ॥ ४ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - वैश्वामित्रञ्च ॥ विश्वामित्रो गायत्र्यग्निः ॥&lt;/summary&gt;&#xA;&lt;p&gt;ऊपात्वा+++(पि)+++ग्नेदिवेदिवाइ+++(शू)+++। दोषा+++(टा)+++वास्ता+++(टा)+++र्द्धीया+++(चा)+++वाय+++(चा)+++म्। नामो+++(टा)+++भारा+++(टाच्)+++न्ता+++(च)+++ए+++(क)+++मा+++(ट)+++सा+++(खण्)+++इ+++(श)+++। ओ+++(प)+++इळा+++(शा)+++ ॥ ५ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०५</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/02_R-10_sA-15/05/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/02_R-10_sA-15/05/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - शुनः शेप आजीर्गितः अग्निः गायत्री&lt;/summary&gt;&#xA;&lt;p&gt;जरा॑बोधाताव्दीविड्ढी । वीशेवी॒शेय॑ज्ञीयाया । स्तो॓मंरुद्रायादृशीक॒म् ॥ ५ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - अग्नेश्चजराबोधीये ॥ द्वयोरग्निर्गायत्री रुद्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;जारा+++(ता)+++। बोधा+++(टा)+++बोधा+++(टा)+++ताद्वी+++(चा)+++विढ्ढा+++(चा)+++इ+++(श)+++। वीशे+++(का)+++वाइशे+++(टि)+++यज्ञो+++(टा)+++याया+++(खा)+++औहोवा+++(शि)+++। स्तोमं+++(का)+++रूद्रायदृशी+++(कू)+++का+++(च)+++म् ॥ ६ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - अग्नेश्चजराबोधीये ॥ द्वयोरग्निर्गायत्री रुद्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;जराबोधो+++(ती)+++वा+++(त)+++। ता+++(च)+++द्वीविड्ढा+++(चि)+++इ+++(श)+++। वीशाइवा+++(टी)+++इशे+++(ता)+++। या+++(थ)+++ज्ञी+++(श)+++यायास्तो+++(किच्)+++मां+++(च)+++रू+++(य)+++द्रा+++(प)+++या+++(ण)+++दृ+++(श)+++। शीको+++(खा)+++इळा+++(शा)+++ ॥ ७ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०६</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/02_R-10_sA-15/06/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/02_R-10_sA-15/06/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - मेधातिथिः अग्निः गायत्री&lt;/summary&gt;&#xA;&lt;p&gt;प्रातित्यञ्चा॒रुमाध्वारं॒ । गो॓पी॑था॒यप्रा॒हू॑यसे । मा॒रुद्भीरग्नाआग॑हि ॥ ६ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - मारूतञ्च ॥ मरुतो गायत्र्यग्निः ॥&lt;/summary&gt;&#xA;&lt;p&gt;प्रातित्या+++(पि)+++ञ्चारूमध्वरा+++(शु)+++म्। गोपी+++(था)+++थायाप्रा+++(चि)+++हु+++(क)+++या+++(ख)+++सा+++(ण)+++इ+++(श)+++। मारू+++(चा)+++त्भी+++(क)+++राग्नाया+++(टि)+++ग+++(च)+++हाऔ+++(टा)+++हो+++(ख)+++बा+++(प्ल)+++। हो+++(प्ल)+++इळा+++(शा)+++ ॥ ८ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०७</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/02_R-10_sA-15/07/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/02_R-10_sA-15/07/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - शुनः शेप आजीर्गितः अग्निः गायत्री&lt;/summary&gt;&#xA;&lt;p&gt;अ॑श्वन्न॒त्वावारा॑व॒न्तम् । व॓न्द॓ध्याआग्नि॒न्नामोभिः । स॒म्म्रा॒जन्तमाध्वाराणा॑म् ॥ ७ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - भार्गवेच ॥ द्वयोः भृगुः गायत्र्यग्निः ॥&lt;/summary&gt;&#xA;&lt;p&gt;आश्वा+++(टा)+++औहो+++(खा)+++वा+++(श)+++। नात्वा+++(टा)+++औहो+++(खा)+++वा+++(श)+++। वारवन्तं+++(षी)+++वन्दध्यै+++(ति)+++। आग्ना+++(टा)+++औहो+++(खा)+++वा+++(श)+++। नमोभि+++(षि)+++स्सम्म्राजन्ता+++(तु)+++म्। आध्वरा+++(कि)+++णामौ+++(पा)+++होबा+++(प्ला)+++। हो+++(प्ल)+++इळा+++(शा)+++ ॥ ९ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - भार्गवेच ॥ द्वयोः भृगुः गायत्र्यग्निः ॥&lt;/summary&gt;&#xA;&lt;p&gt;अश्वन्नत्वा+++(षी)+++वारवन्ता+++(ती)+++म्। वन्दध्या+++(षि)+++अग्निन्नमोभा+++(चु)+++इः+++(श)+++। स+++(क)+++म्म्राज+++(थाच्)+++न्तामा+++(चा)+++ध्वरा+++(खा)+++औहोवाइ+++(खु)+++होहा+++(ण)+++इ+++(श)+++। औ+++(क)+++हो+++(ट)+++या+++(ख)+++औहोवा+++(शि)+++। णा+++(ख)+++म् ॥ १० ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - अग्नेश्चवारवन्तीयम् ॥ शुनश्शेपः गायत्र्यग्निः ॥&lt;/summary&gt;&#xA;&lt;p&gt;अश्वन्नत्वाबुहो+++(तू)+++हा+++(त)+++इ+++(श)+++। वारावा+++(खि)+++न्तं+++(श)+++वन्द+++(का)+++ध्यो+++(प)+++हा+++(ण)+++इ+++(श)+++। अग्नाइन्नमा+++(पु)+++औहोवाइहो+++(खु)+++हा+++(ण)+++इ+++(श)+++। उहुवा+++(खि)+++भीः+++(ण)+++। स+++(क)+++म्म्राज+++(था)+++न्तामाध्वरा+++(पी)+++औहोवाइहो+++(खु)+++हा+++(ण)+++इ+++(श)+++। उहुवा+++(पि)+++णामेहिया+++(प्ली)+++हा+++(श)+++। हो+++(प्ल)+++इळा+++(शा)+++ ॥ ११ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०८</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/02_R-10_sA-15/08/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/02_R-10_sA-15/08/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - प्रयोगो भागर्वः अग्निः गायत्री&lt;/summary&gt;&#xA;&lt;p&gt;और्वा॒भृगूवच्छूचिम् । आप्नावा॒नावादाहु॑वे । अग्निं॓सामुद्रावाससम् ॥ ८ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - और्वस्यवैधारेस्सामनीद्वे ॥ समुद्रस्य वासो वा । और्वः द्वयोरग्निः गायत्र्यग्निः ॥&lt;/summary&gt;&#xA;&lt;p&gt;और्वभृगुवदो+++(चू)+++हा+++(त)+++इ+++(श)+++। शो+++(ख)+++चि+++(श)+++म्। आप्नावा+++(टि)+++ना+++(क)+++वादा+++(टा)+++हुवा+++(टा)+++इहुवायो+++(ची)+++इ+++(श)+++। अग्ना+++(टा)+++इंसामू+++(टिच्)+++सामूओ+++(चि)+++। द्रावा+++(चा)+++सा+++(क)+++सा+++(त)+++बु+++(श)+++। बा+++(ख)+++ ॥ १२ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - और्वस्यवैधारेस्सामनीद्वे ॥ समुद्रस्य वासो वा । और्वः द्वयोरग्निः गायत्र्यग्निः ॥&lt;/summary&gt;&#xA;&lt;p&gt;और्वभृगुव+++(षु)+++च्छुचिमे+++(ति)+++शुचि+++(ता)+++म्। आप्नवा+++(कि)+++ना+++(च)+++वादा+++(टा)+++हुवा+++(ता)+++इहुवा+++(टि)+++इहुवा+++(टि)+++ए+++(त)+++। अग्नाइंसा+++(टी)+++मू+++(त)+++सामू+++(टा)+++सामू+++(टा)+++ए+++(त)+++। द्रा+++(ट्ट्)+++वा+++(ख)+++औहोवा+++(शि)+++। सा+++(च)+++सा+++(ट)+++मे+++(ख)+++ ॥ १३ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०९</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/02_R-10_sA-15/09/</link>
