    <item>
      <title>०१</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/11_R-10_sA-18/01/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/11_R-10_sA-18/01/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - दीर्घतमा औचथ्यः अग्निः उष्णिक्&lt;/summary&gt;&#xA;&lt;p&gt;पूरू॒त्वा॑दाशीवं॒वो॑चे॓त् । आरीरग्नेता॓वास्वीदा॒ । तोद॒स्ये॒वशारणआ॑माहास्या॑ ॥ १ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - तौदेद्वे ॥ द्वयोः तोद उष्णिगग्निः ॥&lt;/summary&gt;&#xA;&lt;p&gt;पुरू+++(ता)+++। त्वा+++(क)+++दाशिवंवोचाए+++(पू)+++दारीरग्नाइ+++(शु)+++। ता+++(क)+++वस्विदा+++(चि)+++। तो+++(क)+++दस्येवशरणया+++(टू)+++हो+++(च)+++इ+++(श)+++। महा+++(टा)+++होये+++(टा)+++स्योया+++(खा)+++औहोवा+++(शि)+++। ई+++(ख)+++ ॥ १ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - तौदेद्वे ॥ द्वयोः तोद उष्णिगग्निः ॥&lt;/summary&gt;&#xA;&lt;p&gt;पुरूत्वादा+++(षी)+++शिवंवोचे+++(तु)+++त्। आरीरा+++(खि)+++ग्नाइ+++(शा)+++तावास्वा+++(खि)+++इदा+++(णा)+++। तोदस्येव+++(षी)+++शरणया+++(खी)+++हा+++(ण)+++इ+++(श)+++। मा+++(ट)+++हा+++(त)+++होये+++(टा)+++स्योया+++(खा)+++औहोवा+++(शि)+++। ई+++(ख)+++ ॥ २ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - दैर्घतमसानित्रीणि ॥ त्रयाणां दीर्घतमा उष्णिगग्निः ॥&lt;/summary&gt;&#xA;&lt;p&gt;पुरुत्वादा+++(षी)+++शिवंवो+++(ति)+++चे+++(त)+++त्। आराइरा+++(पी)+++ग्नाइ+++(शा)+++। तावास्वा+++(खि)+++इदा+++(णा)+++। तोदास्या+++(खि)+++इवा+++(शा)+++शाराणा+++(खि)+++या+++(ण)+++। माहा+++(खा)+++स्या+++(त्र)+++। ए+++(तच्)+++ ॥ ३ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - दैर्घतमसानित्रीणि ॥ त्रयाणां दीर्घतमा उष्णिगग्निः ॥&lt;/summary&gt;&#xA;&lt;p&gt;पुरूत्वा+++(खि)+++दाशिवंवोचे+++(शु)+++त्। अरिरग्ना+++(षी)+++इतवा+++(टि)+++स्वा+++(ख)+++इदा+++(णा)+++। तो+++(ख)+++दा+++(प्ल)+++स्या+++(ख)+++इवा+++(शा)+++शाराणा+++(खि)+++या+++(ण)+++। माहा+++(खा)+++। स्या+++(त्र)+++ ॥ ४ ॥&lt;/p&gt;</description>
    </item>
    <item>
      <title>०२</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/11_R-10_sA-18/02/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/11_R-10_sA-18/02/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - विश्वामित्रो गाथिनः अग्निः उष्णिक्&lt;/summary&gt;&#xA;&lt;p&gt;प्र॓होत्रे॑पूर्वीयंवाचाः॑ । अग्नाये॑भरताबृहा॒त् । वीपांज्योती॑षिबि॓भ्रा॑तेना॒वेधासे॑ ॥ २ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - श्यावाश्वस्यप्रहितौद्वौ ॥ द्वयोः श्यावाश्व उष्णिगग्निः ॥&lt;/summary&gt;&#xA;&lt;p&gt;प्रहोत्रेपू+++(ती)+++। व्यंवचोग्नया+++(टु)+++इभा+++(चा)+++रा+++(क)+++ता+++(च)+++बृहा+++(चा)+++त्। वीपान्जो+++(टि)+++ती+++(त)+++म्। षीबाइभ्रा+++(टीट्)+++ता+++(ख)+++औहोवा+++(शि)+++। नवे+++(ताच्)+++धा+++(ट)+++से+++(ख)+++ ॥ ६ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - श्यावाश्वस्यप्रहितौद्वौ ॥ द्वयोः श्यावाश्व उष्णिगग्निः ॥&lt;/summary&gt;&#xA;&lt;p&gt;प्रहोत्राइपू+++(खु)+++र्वीयंवाचाः+++(प्ली)+++। आग्नये+++(टि)+++भा+++(च)+++रता+++(काच्)+++बृ+++(क)+++हा+++(ट)+++त्। वीपान्जोतीषीबी+++(फू)+++भ्रता+++(ता)+++इ+++(श)+++। ना+++(प)+++वे+++(श)+++धा+++(ख)+++सो+++(प्ल)+++। हाइ+++(शा)+++ ॥ ७ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०३</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/11_R-10_sA-18/03/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/11_R-10_sA-18/03/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - गौतमो राहूगणः अग्निः उष्णिक्&lt;/summary&gt;&#xA;&lt;p&gt;अग्नेवाज॑स्यागोमा॑तः । ई॒शा॑नस्सहसोयहो । अ॓स्मे॒देहीजातवेदोमा॒हिश्रावाः ॥ ३ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - प्रजापतेःश्रुधीयेद्वे ॥ द्वयोः प्रजापति उष्णिगग्निः ॥&lt;/summary&gt;&#xA;&lt;p&gt;अग्नेवाजा+++(फी)+++स्यागोमातो+++(ची)+++वा+++(श)+++। ई+++(क)+++शानस्साहसो+++(कु)+++याहो+++(का)+++अस्मे+++(का)+++देही+++(का)+++जाता+++(चा)+++वेदो+++(था)+++महा+++(टा)+++इश्रवा+++(टि)+++उवा+++(ता)+++। श्रो+++(च)+++धिया+++(टा)+++ए+++(ट)+++हिया+++(खाण्)+++। ओ+++(प)+++इळा+++(शा)+++ ॥ ८ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - प्रजापतेःश्रुधीयेद्वे ॥ द्वयोः प्रजापति उष्णिगग्निः ॥&lt;/summary&gt;&#xA;&lt;p&gt;अग्नेवाज+++(षी)+++स्यगोमतो+++(ती)+++हो+++(त)+++वा+++(त)+++। ई+++(क)+++शानस्साहसो+++(कु)+++या+++(ख)+++हो+++(श)+++। आ+++(च)+++स्मे+++(य)+++दाइही+++(पि)+++जाता+++(प्ला)+++वेदो+++(ता)+++। मा+++(प)+++ही+++(श)+++श्रा+++(ख)+++वो+++(प्ल)+++। हाइ+++(शा)+++ ॥ ९ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०४</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/11_R-10_sA-18/04/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/11_R-10_sA-18/04/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - विश्वामित्रो गाथिनः अग्निः उष्णिक्&lt;/summary&gt;&#xA;&lt;p&gt;अ॓ग्ने॒या॒जीष्ठोआध्वारे । देवान्दे॑वायातेयाजा । होता॑मन्द्रो॓वी॑राज॒स्यातिसृधाः ॥ ४ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - प्रजापतेःसदोहविर्धानानित्रीणिसदःपूर्वंहविर्धाने उत्तरे ॥ त्रयाणां प्रजापतिरुष्णिगग्निः ॥&lt;/summary&gt;&#xA;&lt;p&gt;अग्नेयजिष्ठो+++(षु)+++अध्वरा+++(ति)+++ए+++(त)+++। देवान्देवा+++(ची)+++याता+++(का)+++इया+++(या)+++जा+++(ट)+++हुवा+++(ता)+++होवा+++(का)+++। होता+++(चा)+++मन्द्रो+++(थाच्)+++वीरा+++(का)+++जा+++(य)+++सी+++(ट)+++हुवा+++(ता)+++होवा+++(का)+++। आतिस्रा+++(टि)+++इधाः+++(खाण)+++। ओ+++(प)+++इळा+++(शा)+++ ॥ १० ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - प्रजापतेःसदोहविर्धानानित्रीणिसदःपूर्वंहविर्धाने उत्तरे ॥ त्रयाणां प्रजापतिरुष्णिगग्निः ॥&lt;/summary&gt;&#xA;&lt;p&gt;आग्ना+++(फा)+++इया+++(खा)+++ई+++(ख)+++या+++(श)+++। याजिष्ठोअध्वारा+++(षू)+++इदेवान्दे+++(ती)+++वायते+++(टि)+++हाबुहोवा+++(की)+++। याजा+++(टा)+++होता+++(टा)+++मन्द्रो+++(था)+++वी+++(क)+++राजा+++(पा)+++सी+++(श)+++। आ+++(ट)+++तीया+++(खा)+++औहोवा+++(शि)+++। स्री+++(ख)+++धाः+++(प्ल)+++ ॥ ११ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - प्रजापतेःसदोहविर्धानानित्रीणिसदःपूर्वंहविर्धाने उत्तरे ॥ त्रयाणां प्रजापतिरुष्णिगग्निः ॥&lt;/summary&gt;&#xA;&lt;p&gt;अग्नियाओवा+++(तु)+++। याजिष्ठोअध्वरा+++(षू)+++इदेवान्दा+++(टी)+++इवा+++(ता)+++। आयाते+++(चि)+++याजा+++(टा)+++होता+++(पा)+++उवा+++(शा)+++। मन्द्रो+++(थाच्)+++वीरा+++(का)+++जा+++(ट)+++सा+++(ख)+++औहोवा+++(शि)+++। आ+++(थ)+++तिस्रीधाः+++(टिख्)+++ ॥ १२ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०५</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/11_R-10_sA-18/05/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/11_R-10_sA-18/05/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - त्रित आत्यः पवमानः सोमः उष्णिक्&lt;/summary&gt;&#xA;&lt;p&gt;जज्ञान॒स्सप्ता॒मातृ॒भिः । मे॒धामाशा॑सातश्रिये॒ । आ॓यन्ध्रुवोरायीणां॓चीके॑तादा ॥ ५ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - त्वष्टुश्चातिथ्यम् ॥ त्वष्टोष्णिगग्निरदितिर्वा ॥&lt;/summary&gt;&#xA;&lt;p&gt;जज्ञानस्सा+++(ती)+++। प्तमा+++(काच्)+++तृ+++(क)+++भाइर्मेधा+++(की)+++मा+++(ख)+++शा+++(ण)+++। सातस्रा+++(चि)+++या+++(ट)+++अया+++(टा)+++न्ध्रु+++(ख)+++वाः+++(ण)+++। रया+++(टा)+++इणा+++(ता)+++ञ्चिकाइता+++(टीट्)+++दा+++(ख)+++औहोवा+++(शि)+++। ऊ+++(ख)+++पा+++(श)+++ ॥ १३ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०६</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/11_R-10_sA-18/06/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/11_R-10_sA-18/06/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - इरिम्बिठः काण्वः अदितिः उष्णिक्&lt;/summary&gt;&#xA;&lt;p&gt;ऊत॒स्या॒नोदीवामातिः । आदी॑तीरूत्यगमात् । साश॓न्तातामायास्कारादपश्री॒धाः ॥ ६ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - अदितेश्चसाम ॥ अदितिरुष्णिगग्निरदितिर्वा ॥&lt;/summary&gt;&#xA;&lt;p&gt;उतस्यानो+++(खी)+++दीवामातिः+++(प्ली)+++। आ+++(क)+++दीतिरू+++(कि)+++तिया+++(चा)+++गा+++(य)+++मा+++(ट)+++त्साशान्ता+++(टि)+++ता+++(त)+++। माया+++(फा)+++स्कराउवो+++(खी)+++वा+++(श)+++। अपास्रिधाः+++(प्ली)+++। हो+++(प्ल)+++इळा+++(शा)+++ ॥ १४ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०७</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/11_R-10_sA-18/07/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/11_R-10_sA-18/07/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - विश्वमना वैयश्वः अग्निः उष्णिक्&lt;/summary&gt;&#xA;&lt;p&gt;ईळि॑ष्वाहि॓प्रा॑तिव्यम्॑ । या॒ज॑स्वाजातावे॑दसं । चरिष्णू॑धूमामागृभीतशोचिषम् ॥ ७ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - अगस्तस्यचराक्षोघ्नम् ॥ अगस्त्य उष्णिगग्निः ॥&lt;/summary&gt;&#xA;&lt;p&gt;ईळा+++(का)+++इष्वा+++(पा)+++हिप्रतिव्या+++(शि)+++म्। याजस्वा+++(कि)+++जातावे+++(कि)+++दसा+++(टा)+++ञ्चरिष्णुधूमा+++(खु)+++मग्रभा+++(ति)+++इ+++(श)+++। ता+++(ट)+++शो+++(ख)+++औहोवा+++(शि)+++। ची+++(ख)+++ष+++(श)+++म् ॥ १५ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०८</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/11_R-10_sA-18/08/</link>
