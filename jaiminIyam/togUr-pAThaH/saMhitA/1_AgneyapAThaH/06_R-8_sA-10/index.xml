    <item>
      <title>०१</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/06_R-8_sA-10/01/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/06_R-8_sA-10/01/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - वसिष्ठो मैत्रावरुणिः अग्निः बृहती&lt;/summary&gt;&#xA;&lt;p&gt;दे॒वो॒वो॑द्रविणोदाः । पूर्णां॑वी॑वाष्ट्वासी॒च॑म् । उद्वा॑सिन्चा॒ध्वामू॒पा॑वापृणध्वं । आदीद्वो॑देवा॒ओहते ॥ १ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - अग्नेश्चद्रविणम् ॥ अग्निर्वृहत्यग्निः ॥&lt;/summary&gt;&#xA;&lt;p&gt;देवो+++(णफ)+++वो+++(ख)+++द्रविणोदाः+++(शी)+++। पू+++(क)+++र्णांविवष्ट्वा+++(टीच्)+++सी+++(क)+++चमूद्वा+++(यि)+++सिन्चा+++(टा)+++। ध्वामुपावा+++(टी)+++पृणा+++(का)+++ध्वामा+++(चा)+++दी+++(य)+++द्वोदे+++(टा)+++। वाओ+++(चा)+++हताइळा+++(टी)+++भा+++(खण्)+++। ओ+++(प)+++इळा+++(प्ला)+++ ॥ १ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०२</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/06_R-8_sA-10/02/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/06_R-8_sA-10/02/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - कण्वो घौरः ब्रह्मणस्पतिः बृहती&lt;/summary&gt;&#xA;&lt;p&gt;प्रैतू॓ब्रह्माण॒स्पा॒तीः । प्रा॒देव्येतूसूनृ॒ता । अच्छावीरं॓नर्यं॑पङ्तीरा॑धसं । दे॒वा॒यज्ञ॒न्ना॒यन्तुनः ॥ २ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - बार्हस्पत्यञ्चब्राह्मणस्पत्यंवा ॥ बृहस्पतिर्बुहत्यग्निः ॥&lt;/summary&gt;&#xA;&lt;p&gt;प्रैतूब्रा+++(खि)+++ह्माणास्पातीः+++(प्ली)+++। प्रादाइव्ये+++(टीच्)+++तू+++(क)+++सूनृता+++(कि)+++अच्छा+++(टा)+++वा+++(ख)+++इर+++(णा)+++म्। नर्यंप+++(तिच्)+++न्तीरा+++(चा)+++धा+++(य)+++सा+++(ट)+++म्। देवा+++(टा)+++या+++(ख)+++ज्ञ+++(ण)+++म्। ना+++(ट)+++या+++(ख)+++औहोवा+++(शि)+++। तू+++(ख)+++नाः+++(श)+++ ॥ २ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०३</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/06_R-8_sA-10/03/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/06_R-8_sA-10/03/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - कण्वो घौरः यूपः बृहती&lt;/summary&gt;&#xA;&lt;p&gt;ऊर्ध्वाऊषू॓णा॑ऊता॒ये॑ । तिष्ठा॑देवो॓ना ॓सा॑वीता । ऊर्ध्वोवा॒ज॑स्यासानीता॓यादन्जी॒भिः॑ । वा॒घा॓त्भी॑र्वीभ्वाया॑महे ॥ ३ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - वसिष्ठस्यचवीङ्कम् ॥ वसिष्ठो बृहत्यग्निः ॥&lt;/summary&gt;&#xA;&lt;p&gt;ऊर्ध्वऊषुणा+++(कु)+++ऊता+++(पा)+++या+++(ण)+++इ+++(श)+++। तिष्ठादेवोनसः+++(षू)+++विताऊर्ध्वोवा+++(टु)+++जा+++(त)+++। स्या+++(च)+++सा+++(क)+++निता+++(का)+++या+++(च)+++दा+++(य)+++न्जीभीः+++(टा)+++। वा+++(क)+++घा+++(ट)+++त्भी+++(क)+++र्वीं+++(च)+++भायामा+++(टि)+++हा+++(खण्)+++इ+++(श)+++। ओ+++(प)+++इळा+++(प्ला)+++ ॥ ३ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०४</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/06_R-8_sA-10/04/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/06_R-8_sA-10/04/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - सोभिरः काण्वः अग्निः बृहती&lt;/summary&gt;&#xA;&lt;p&gt;प्र॓योरा॑येनीनीषते । म॒र्तोयस्तेवासोदा॑शा॑त् । सावीरन्धाक्तेअ॒ग्निउत्थाशंसी॑नं । इत्माना॑सहस्रापोषी॒णम् ॥ ४ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - विस्पर्धञ्च ॥ विष्पर्धा बृहत्यग्निः ॥&lt;/summary&gt;&#xA;&lt;p&gt;प्रयोराया+++(फी)+++इनिनीषता+++(तु)+++इ+++(श)+++। मर्क्तोयस्ते+++(की)+++वासोदाशात्सा+++(कु)+++वीरा+++(टा)+++न्धा+++(त)+++। तायग्नेउक्थाशं+++(कू)+++सीनं+++(था)+++त्मानासा+++(टि)+++हा+++(त)+++। स्रापोषा+++(टि)+++इणा+++(खाण्)+++म्। ओ+++(प)+++इळा+++(शा)+++ ॥ ४ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०५</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/06_R-8_sA-10/05/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/06_R-8_sA-10/05/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - कण्वो घौरः अग्निः बृहती&lt;/summary&gt;&#xA;&lt;p&gt;प्रावो॑यंभंपू॑रूणां॒ । वीशा॒न्दे॑वायातीनां । अग्निंसूक्तेभिर्वाचो॑भिर्वृणीमहे । यंसमीदन्याइ॒न्धा॒ते ॥ ५ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - ऐतवृधञ्च ॥ ऐतवद्भिर्वृहत्यग्निः ॥&lt;/summary&gt;&#xA;&lt;p&gt;प्रवाः+++(ता)+++। यम्भंपुरू+++(टी)+++णा+++(त)+++म्। वी+++(क)+++शान्दे+++(टा)+++वायता+++(टि)+++इना+++(ता)+++म्। अग्निंसूक्ते+++(षी)+++भिर्वचोभि+++(की)+++र्वृणीमा+++(टि)+++हा+++(ता)+++इ+++(श)+++। यांसा+++(टा)+++माइदा+++(टि)+++न्याइ+++(का)+++न्धताइळा+++(टी)+++भा+++(खण्)+++। ओ+++(प)+++इळा+++(प्ला)+++ ॥ ५ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०६</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/06_R-8_sA-10/06/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/06_R-8_sA-10/06/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - उत्कीलः कात्यः अग्निः बृहती&lt;/summary&gt;&#xA;&lt;p&gt;आया॒मग्नी॒सूवी॒र्या॑स्या । ई॒शेहिसौ॒भा॒गस्य । रायाई॒शेस्वापत्यास्यागो॒मा॑तः । ईशे॑हिवृ॒त्राहा॒थानाम् ॥ ६ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - मनसश्चदोहः ॥ दोहो बृहत्यग्निः ॥&lt;/summary&gt;&#xA;&lt;p&gt;अयमग्नि+++(षी)+++स्सुवीर्यस्यहा+++(तु)+++बु+++(श)+++। आइशे+++(किच्)+++हीसौभस्या+++(चु)+++होवा+++(टा)+++हा+++(त)+++इ+++(श)+++। रायई+++(कि)+++शेस्वापत्या+++(की)+++स्या+++(क)+++गो+++(य)+++माता+++(टा)+++होवा+++(टा)+++हा+++(त)+++इ+++(श)+++। ई+++(क)+++शेहा+++(टा)+++इवृ+++(ता)+++होवा+++(टा)+++हा+++(त)+++इ+++(श)+++। त्राहा+++(चा)+++था+++(थ)+++नामिळा+++(टा)+++भा+++(खण्)+++। ओ+++(प)+++इळा+++(प्ला)+++ ॥ ६ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०७</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/06_R-8_sA-10/07/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/06_R-8_sA-10/07/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - वसिष्ठो मैत्रावरुणिः अग्निः बृहती&lt;/summary&gt;&#xA;&lt;p&gt;त्वा॓मा॑ग्नेगृहा॒पा॑तिः । त्वं॒होता॑नोआ॓ध्वारे । त्वां॒पो॒ता॑विश्वावारप्रा॒चे॑तः । य॒क्षीया॓सी॑चावार्यम् ॥ ७ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - समन्तानित्रिणिअग्नेरेकमिन्द्राग्न्योर्वाप्रजापतेर्वावरुणस्यद्वे ॥ अग्निर्वसिष्ठो वा बृहत्यग्निः ॥ द्वयोर्वरुणो बृहत्यग्निः ॥&lt;/summary&gt;&#xA;&lt;p&gt;त्वमग्ने+++(षि)+++गृहपता+++(ती)+++इः+++(श)+++। त्वं+++(क)+++होतानो+++(कि)+++अध्वराइत्वाम्पो+++(टू)+++ता+++(त)+++। वाइश्वावारा+++(कु)+++प्रचाइता+++(भी)+++औ+++(क)+++हो+++(फ)+++वा+++(प्ल)+++हा+++(ण)+++इ+++(श)+++। यक्षाइया+++(टी)+++सी+++(त)+++होवा+++(टा)+++हा+++(त)+++इ+++(श)+++। चावारा+++(टी)+++या+++(खण्)+++म्। ओ+++(प)+++इळा+++(प्ला)+++ ॥ ७ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - समन्तानित्रिणिअग्नेरेकमिन्द्राग्न्योर्वाप्रजापतेर्वावरुणस्यद्वे ॥ अग्निर्वसिष्ठो वा बृहत्यग्निः ॥ द्वयोर्वरुणो बृहत्यग्निः ॥&lt;/summary&gt;&#xA;&lt;p&gt;त्वमा+++(खा)+++ग्नेगृहपताइः+++(शू)+++। त्वं+++(क)+++होता+++(का)+++नोअध्वरे+++(की)+++त्वा+++(प)+++म्पोता+++(फा)+++औहो+++(फा)+++औहो+++(फा)+++वा+++(त)+++हा+++(त)+++इ+++(श)+++। वाइश्वावारा+++(कु)+++प्रचाइता+++(पी)+++औहो+++(फा)+++औहो+++(फ)+++वा+++(त)+++हा+++(त)+++इ+++(श)+++। यक्षाइया+++(यी)+++सा+++(प)+++औहो+++(फा)+++औहो+++(फ)+++वा+++(त)+++हा+++(त)+++इ+++(श)+++। चावारा+++(टि)+++या+++(खण्)+++म्। ओ+++(प)+++इळा+++(प्ला)+++ ॥ ८ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - समन्तानित्रिणिअग्नेरेकमिन्द्राग्न्योर्वाप्रजापतेर्वावरुणस्यद्वे ॥ अग्निर्वसिष्ठो वा बृहत्यग्निः ॥ द्वयोर्वरुणो बृहत्यग्निः ॥&lt;/summary&gt;&#xA;&lt;p&gt;त्वमग्नेगृहा+++(तु)+++पतीः+++(ता)+++। त्वंहो+++(खा)+++ता+++(श)+++नोअध्वा+++(खि)+++रा+++(ण)+++इ+++(श)+++। त्वाम्पो+++(खा)+++ता+++(श)+++विश्वावा+++(खि)+++रा+++(ण)+++। प्राचेता+++(किथ्)+++यक्षाइया+++(टीट्)+++सा+++(ख)+++औहोवा+++(श)+++। चावारी+++(टि)+++या+++(ख)+++म् ॥ ९ ॥&lt;/p&gt;</description>
    </item>
    <item>
      <title>०८</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/06_R-8_sA-10/08/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/06_R-8_sA-10/08/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - विश्वामित्रो गाथिनः अग्निः बृहती&lt;/summary&gt;&#xA;&lt;p&gt;साखायस्त्वाववृमहे । दे॒वंमर्ता॒साऊता॒ये । आ॒पान्ना॑पातंसूभा॓गं॑सूदंसा॑सं । सु॒प्रा॒तू॑र्तीमानेहा॒सम् ॥ ८ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - वमृस्यवैखानसस्यसाम ॥ वाम्रो वैखानस आञ्जिग दानवो वा बृहत्यग्निः ॥&lt;/summary&gt;&#xA;&lt;p&gt;सखायस्त्वाबुहो+++(तू)+++हो+++(त)+++हा+++(त)+++इ+++(श)+++। ववृमा+++(खि)+++हा+++(ण)+++इ+++(श)+++। दे+++(क)+++वम्मर्क्ता+++(टि)+++हा+++(त)+++सऊ+++(टा)+++ता+++(ख)+++या+++(ण)+++इ+++(श)+++। अपा+++(चा)+++न्नपा+++(खा)+++त+++(श)+++म्सुभगौवा+++(ती)+++हा+++(त)+++इ+++(श)+++सूदं+++(का)+++सा+++(ख)+++स+++(ण)+++म्। सुप्रातू+++(टि)+++र्क्ती+++(त)+++म्। आनेहा+++(टि)+++सा+++(खण्)+++म्। ओ+++(प)+++इळा+++(प्ला)+++ ॥ १० ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
