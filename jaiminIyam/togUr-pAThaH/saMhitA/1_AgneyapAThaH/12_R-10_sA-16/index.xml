    <item>
      <title>०१</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/12_R-10_sA-16/01/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/12_R-10_sA-16/01/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - प्रयोगो भागर्वः (सोभिरः काण्वः) अग्निः उष्णिक्&lt;/summary&gt;&#xA;&lt;p&gt;प्रमंही॑ष्ठायगायता । ऋताव्नेबृहाते॒शुक्राशो॑चिषे । उ॒प॒स्तूता॓सो॑अग्नाये ॥ १ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - वसिष्ठस्यप्रमंहिष्ठीयानिचत्वारि ॥ द्वयोरिन्द्रः ककुबग्निः ॥ असितः ककुबग्निः ॥ इन्द्रः ककुबग्निः ॥&lt;/summary&gt;&#xA;&lt;p&gt;प्रमंहा+++(खि)+++इष्ठायगायता+++(शू)+++। ऋताव्ने+++(टिच्)+++बृहते+++(कि)+++शुक्रा+++(पा)+++शो+++(श)+++चा+++(त)+++इषा+++(ता)+++इ+++(श)+++। उपाऔ+++(पि)+++हो+++(श)+++स्तुतासो+++(पि)+++आ+++(श)+++ग्ना+++(ख)+++यो+++(प्ल)+++। हाइ+++(शा)+++ ॥ १ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - वसिष्ठस्यप्रमंहिष्ठीयानिचत्वारि ॥ द्वयोरिन्द्रः ककुबग्निः ॥ असितः ककुबग्निः ॥ इन्द्रः ककुबग्निः ॥&lt;/summary&gt;&#xA;&lt;p&gt;प्रमंहिष्ठायगा+++(तू)+++। या+++(च)+++ताऋता+++(टि)+++व्ने+++(टच्)+++बृहा+++(का)+++ता+++(य)+++इशू+++(टा)+++क्रा+++(क)+++शोचा+++(टा)+++इषा+++(ता)+++इ+++(श)+++। ऊपा+++(चा)+++स्तुतौ+++(टाच्)+++हु+++(क)+++वाए+++(टा)+++होवा+++(का)+++। सा+++(क)+++वो+++(प)+++बा+++(प्ल्)+++ग्नायो+++(प्ला)+++। हाइ+++(शा)+++ ॥ २ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - वसिष्ठस्यप्रमंहिष्ठीयानिचत्वारि ॥ द्वयोरिन्द्रः ककुबग्निः ॥ असितः ककुबग्निः ॥ इन्द्रः ककुबग्निः ॥&lt;/summary&gt;&#xA;&lt;p&gt;प्रमंहिष्ठायागा+++(फु)+++इय्या+++(खा)+++ई+++(ख)+++या+++(श)+++। या+++(थ)+++ताऋताव्ने+++(की)+++बृहतेशू+++(टी)+++क्राशौ+++(टा)+++हौ+++(ट)+++हुवा+++(टी)+++इचाइषा+++(टी)+++इ+++(श)+++। उपा+++(का)+++होइस्तुता+++(की)+++हो+++(क)+++सो+++(थ)+++अग्ना+++(टा)+++या+++(खण्)+++इ+++(श)+++। ओ+++(प)+++इळा+++(शा)+++ ॥ ३ ॥&lt;/p&gt;</description>
    </item>
    <item>
      <title>०२</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/12_R-10_sA-16/02/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/12_R-10_sA-16/02/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - सोभिरः काण्वः अग्निः उष्णिक्&lt;/summary&gt;&#xA;&lt;p&gt;प्र॓सोअग्नेतावोतीभीः । सू॒वीरा॑भिस्तारातीवा॒जकर्म॑भिः । या॒स्यत्वं॒सख्यमा॒वी॒थ ॥ २ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - भरद्वाजस्यवाजभृत् ॥ भरद्वाजः ककुबग्निः ॥&lt;/summary&gt;&#xA;&lt;p&gt;प्रासो+++(टा)+++हा+++(त)+++आग्ने+++(टा)+++हा+++(त)+++इ+++(श)+++। तवा+++(ता)+++आउवा+++(टि)+++। ती+++(ख)+++भीः+++(प्ल)+++। सूवी+++(चा)+++रा+++(श)+++भिस्तारा+++(चि)+++तीवा+++(चा)+++जक+++(का)+++र्माभिर्या+++(चि)+++स्या+++(ट)+++हा+++(त)+++इ+++(श)+++। त्वंसा+++(पा)+++ख्यमोबा+++(प्लि)+++वाइथो+++(प्लि)+++। हाइ+++(शा)+++ ॥ ५ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०३</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/12_R-10_sA-16/03/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/12_R-10_sA-16/03/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - सोभिरः काण्वः अग्निः उष्णिक्&lt;/summary&gt;&#xA;&lt;p&gt;तं॒गूर्धायास्व॒र्णारं । देवासो॑देवा॓मा॑रातिन्द॑धन्विरे । देवात्रा॒हव्या॒मू॑हिषे ॥ ३ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - सौभराणित्रीणि ॥ त्रयाणां सुभरिः ककुबग्निः ॥&lt;/summary&gt;&#xA;&lt;p&gt;तङ्गू+++(णाफ्)+++र्धाया+++(खा)+++स्वर्णा+++(प्ला)+++रो+++(ङ)+++वा+++(श)+++। दे+++(क)+++वासो+++(चा)+++दे+++(क)+++वामाराता+++(टी)+++इन्दधा+++(टि)+++होइन्वा+++(टि)+++इरा+++(ता)+++इ+++(श)+++। दे+++(थ)+++वात्राहव्यमू+++(टु)+++हा+++(त)+++हा+++(त)+++इ+++(श)+++। हा+++(ट)+++इषा+++(खा)+++औहोवा+++(शि)+++। ऊ+++(ख)+++क् ॥ ६ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - सौभराणित्रीणि ॥ त्रयाणां सुभरिः ककुबग्निः ॥&lt;/summary&gt;&#xA;&lt;p&gt;तङ्गूर्धयास्वर्णा+++(तू)+++रा+++(त)+++म्। दे+++(क)+++वासो+++(का)+++दा+++(क)+++इवामा+++(चि)+++राता+++(टा)+++इन्दधन्विराउवाइ+++(शॄ)+++। दे+++(ख)+++वा+++(शप्ल्)+++त्रा+++(त)+++हा+++(प)+++व्यमोबा+++(प्लि)+++हाइषो+++(प्लि)+++। हाइ+++(शा)+++ ॥ ७ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - सौभराणित्रीणि ॥ त्रयाणां सुभरिः ककुबग्निः ॥&lt;/summary&gt;&#xA;&lt;p&gt;तङ्गूर्धयास्वौ+++(कु)+++होआर्णा+++(ति)+++रा+++(त)+++म्। देवा+++(टा)+++सो+++(ख)+++दे+++(ण)+++। वामारता+++(टी)+++इन्दा+++(खा)+++धा+++(प्ल)+++न्वा+++(ख)+++इराइ+++(शि)+++। हाहो+++(खा)+++हा+++(ण)+++इ+++(श)+++। देवा+++(टा)+++त्रा+++(ख)+++हा+++(ण)+++। व्यमूहा+++(खिणफप्ल्)+++इ+++(श)+++। षा+++(ख)+++इ+++(श)+++ ॥ ८ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०४</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/12_R-10_sA-16/04/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/12_R-10_sA-16/04/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - प्रयोगो भागर्वः सोभिरः काण्वो वा अग्निः उष्णिक्&lt;/summary&gt;&#xA;&lt;p&gt;मानो॑हृ॑णिथाआ॒तीथिं । वा॓सूरग्निः॒पू॑रूप्राशस्ता॒एषः । या॒सुहोता॑सूआध्वारः ॥ ४ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - पथस्यसौभरस्यसामनीद्वे ॥ द्वयोः पक्थः ककुबग्निः ॥&lt;/summary&gt;&#xA;&lt;p&gt;मानाः+++(ता)+++। हृणी+++(का)+++था+++(ट)+++आतिथिं+++(कि)+++वासु+++(टा)+++रा+++(ख)+++ग्निः+++(श)+++। पुरौ+++(फा)+++होवा+++(ता)+++हा+++(त)+++इ+++(श)+++प्रशौ+++(फा)+++होवा+++(ता)+++हा+++(त)+++इ+++(श)+++। स्तओबा+++(प्लि)+++आइषो+++(प्लि)+++। हाइ+++(शा)+++ ॥ ९ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - पथस्यसौभरस्यसामनीद्वे ॥ द्वयोः पक्थः ककुबग्निः ॥&lt;/summary&gt;&#xA;&lt;p&gt;मानो+++(ता)+++हा+++(त)+++बु+++(श)+++। हा+++(प)+++र्णीथा+++(णा)+++आ+++(ण)+++तिथिं+++(फाप्ल्)+++वासुरा+++(खि)+++ग्ना+++(ण)+++इः+++(श)+++। पूरो+++(चा)+++हाहो+++(चा)+++इ+++(श)+++प्रा+++(क)+++शो+++(थ)+++हाहो+++(काथ्)+++स्ताये+++(पा)+++षाएहिया+++(प्ली)+++हा+++(श)+++। हो+++(प्ल)+++इळा+++(शा)+++ ॥ १० ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०५</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/12_R-10_sA-16/05/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/12_R-10_sA-16/05/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - सोभिरः काण्वः अग्निः उष्णिक्&lt;/summary&gt;&#xA;&lt;p&gt;भद्रो॓नो॑अग्नि॒राहूतः । भ॒द्रा॒रातिस्सू॒भागभद्रो॓आ॑ध्वारः॒ । भद्रा॓ऊतप्रा॒शा॑स्तयः ॥ ५ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - दैवानीकञ्च ॥ देवानीकः ककुबग्निः ॥&lt;/summary&gt;&#xA;&lt;p&gt;भद्रोनो+++(फि)+++ओ+++(प्ल)+++होअग्निरा+++(खी)+++हुताए+++(प्लि)+++। भा+++(क)+++द्रारा+++(था)+++ता+++(च)+++इ+++(श)+++सु+++(क)+++भगा+++(टा)+++भद्रो+++(टा)+++अध्वा+++(खा)+++राः+++(ण)+++। भद्राऊ+++(टि)+++ता+++(त)+++। प्रा+++(प)+++शा+++(श)+++स्ता+++(ख)+++यो+++(प्ल)+++। हाइ+++(शा)+++ ॥ ११ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०६</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/12_R-10_sA-16/06/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/12_R-10_sA-16/06/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - सोभिरः काण्वः अग्निः उष्णिक्&lt;/summary&gt;&#xA;&lt;p&gt;या॒जी॑ष्ठं॑त्वाववृमहे । देवन्दे॑वत्रा॓हो ॓ता॑रामा॒मा॑र्क्त्यम् । अस्या॒यज्ञा॓स्या॑सुक्रातु॑म् ॥ ६ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - साध्रञ्च ॥ साधिः ककुबग्निः ॥&lt;/summary&gt;&#xA;&lt;p&gt;याजी+++(णा)+++ष्ठन्त्वा+++(फा)+++वा+++(ख)+++वृमहाइ+++(शी)+++। दे+++(क)+++वन्देवत्राहोता+++(टू)+++रा+++(च)+++म्। आमा+++(चा)+++र्क्त्या+++(क)+++मास्ययाज्ञा+++(टी)+++। स्या+++(प)+++सु+++(श)+++क्रा+++(ख)+++तू+++(प्ल)+++म्। हाइ+++(शा)+++ ॥ १२ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०७</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/12_R-10_sA-16/07/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/12_R-10_sA-16/07/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - सोभिरः काण्वः अग्निः उष्णिक्&lt;/summary&gt;&#xA;&lt;p&gt;ता॒दग्नेद्युम्नामा॒भारा । य॒त्सासा॒हासाद॑नेकञ्ची॑दत्री॒णं । मन्यु॒ञ्जना॑स्यादूढ्यम् ॥ ७ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - जमदग्नेश्चसंवर्गः ॥ जमदग्न्युष्णिगग्निः ॥&lt;/summary&gt;&#xA;&lt;p&gt;तदग्नेद्यू+++(फी)+++म्नामाभारो+++(ची)+++वा+++(श)+++। यत्सासा+++(टी)+++हा+++(त)+++सादा+++(टा)+++ना+++(त)+++इ+++(श)+++। क+++(थ)+++ञ्चिदत्रा+++(टि)+++इणा+++(ता)+++म्। मन्यू+++(का)+++ञ्जना+++(चा)+++स्यदू+++(टाच्)+++हो+++(य)+++ढा+++(प)+++यामेहिया+++(प्ली)+++हा+++(श)+++। हो+++(प्ल)+++इळा+++(शा)+++ ॥ १३ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०८</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/12_R-10_sA-16/08/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/12_R-10_sA-16/08/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - विश्वमना वैयश्वः अग्निः उष्णिक्&lt;/summary&gt;&#xA;&lt;p&gt;य॒द्वा॒ऊविश्पा॓तीश्शितः । सुप्रीतो॑मा॒नुषोवीशे । विश्वेदग्निप्रा॒तिर॑क्षांसिसेधति ॥ ८ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - अगस्तयस्यचराक्षोघ्नम् ॥ अगस्त्य उष्णिगग्निः ॥&lt;/summary&gt;&#xA;&lt;p&gt;यद्वाऊ+++(पि)+++विश्पतिश्शितः+++(शु)+++। सुप्रीतो+++(कि)+++मानुषो+++(किच्)+++वीशे+++(चा)+++वीश्वेदा+++(टि)+++ग्नीः+++(त)+++। प्रातिरक्षांसिसे+++(कूच्)+++धा+++(क)+++ताऔ+++(टा)+++हो+++(ख)+++बा+++(प्ल)+++। हो+++(प्ल)+++इळा+++(शा)+++ ॥ १४ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
