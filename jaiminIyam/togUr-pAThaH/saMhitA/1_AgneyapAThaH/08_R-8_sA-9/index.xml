    <item>
      <title>०१</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/08_R-8_sA-9/01/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/08_R-8_sA-9/01/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - बुधगविष्ठिरावात्रेयौ अग्निः त्रिष्टुप्&lt;/summary&gt;&#xA;&lt;p&gt;आ॒बो॑ध्यग्निस्सा॒मीधाज॒ना॑नां । प्रा॓तीधेनू॒मीवायातीमू॒षा॒सम् । यह्वा॓इ॓वप्रा॒वाया॒मूज्जीहा॑नाः । प्रा॓भान्नावासस्राते॒नाकामाच्छा ॥ १ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - श्येनञ्च ॥ प्रजापतिस्त्रिष्टुबग्निः ॥ उषा वा ॥&lt;/summary&gt;&#xA;&lt;p&gt;अबोधिया+++(ती)+++। ग्नाइस्समीधा+++(कु)+++जना+++(भा)+++ना+++(त)+++म्। प्रताइधे+++(भी)+++नू+++(त)+++म्। इवा+++(का)+++याती+++(चा)+++मू+++(क)+++षासं+++(था)+++यह्वाई+++(भि)+++वा+++(त)+++। प्रवयामुज्जि+++(चु)+++हानाः+++(था)+++प्रभान्ना+++(भि)+++वाः+++(त)+++। सस्राते+++(कि)+++नाका+++(का)+++मा+++(च)+++च्छाइळा+++(टि)+++भा+++(खण्)+++। ओ+++(प)+++इळा+++(शा)+++ ॥ १ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०२</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/08_R-8_sA-9/02/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/08_R-8_sA-9/02/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - वत्सप्रिर्भालन्दनः‍ अग्निः त्रिष्टुप्&lt;/summary&gt;&#xA;&lt;p&gt;प्राभूर्जय॒न्तम्माहीं॓वीपोधाम् । मूरै॒रा॒मू॒रंपूरा॒न्द॑र्माण॑म् । ना॒यान्तंगी॒र्भिर्वाना॒धिय॑न्धाः । हारी॑श्माश्रून्नावर्मणाधानार्चि॑म् ॥ २ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - वासोक्रञ्च ॥ शुक्रं वा । वसुक्रस्त्रिष्टुबग्निः ॥&lt;/summary&gt;&#xA;&lt;p&gt;प्रभूर्जयन्ता+++(तु)+++म्। माहां+++(णाफ्)+++विबो+++(खा)+++धा+++(श)+++म्। मू+++(क)+++रैरमूरम्पुरा+++(षू)+++न्दर्मा+++(टा)+++णा+++(त)+++म्। नाया+++(णाफ्)+++न्तङ्गी+++(खा)+++र्भिः+++(श)+++। वाणा+++(णाफ्)+++धिया+++(खा)+++न्धाः+++(प्ल)+++। हरिश्मश्रुन्न+++(षु)+++वर्मणा+++(फि)+++हाउवा+++(शि)+++। धना+++(ता)+++र्च्ची+++(ख)+++म् ॥ २ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०३</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/08_R-8_sA-9/03/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/08_R-8_sA-9/03/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - भरद्वाजो बार्हस्पत्यः पूषा त्रिष्टुप्&lt;/summary&gt;&#xA;&lt;p&gt;शु॒क्रन्ते॑अन्य॑द्याजतन्ते॑अन्यात् । वि॑षूरूपेआ॓हा॑निद्यौरीवा॑सी । विश्वा॓हीमाया॒आवासिस्वधावन् । भ॒द्रा॒तेपूषन्नीहारातीरस्तू ॥ ३ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - पौष्णञ्च ॥ पूषा त्रिष्टुप्पूषा ॥&lt;/summary&gt;&#xA;&lt;p&gt;शुक्रन्तेअन्य+++(षु)+++द्यजतन्तेअन्या+++(तू)+++त्। विषुरूपे+++(षी)+++अहनीद्यौ+++(की)+++रीवा+++(टा)+++सी+++(त)+++। विश्वाहिमाया+++(षु)+++अवसाइस्वधा+++(टू)+++वा+++(त)+++न्। भद्राते+++(टि)+++पुषा+++(टा)+++न्नीहारा+++(कि)+++तीरा+++(खा)+++स्तु+++(श)+++। तीरास्तुहा+++(प्ली)+++बु+++(श)+++। बा+++(श)+++ ॥ ३ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०४</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/08_R-8_sA-9/04/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/08_R-8_sA-9/04/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - विश्वामित्रो गाथिनः अग्निः त्रिष्टुप्&lt;/summary&gt;&#xA;&lt;p&gt;ई॑ळामग्ने॓पू॑रूदं॓सं॓सा॓निंगोः । श॒श्वक्तामं॒हा॒वा॑मानायासा॒धा:॑ । स्यानस्सूनुस्ताना॑योर्वीजा॒वा । अ॒ग्नेसाते॑सूमात्य॓र्भूत्वस्मे ॥ ४ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - कौत्सञ्च ॥ कुत्सस्त्रिष्टुबग्निः ॥&lt;/summary&gt;&#xA;&lt;p&gt;इळामग्ना+++(ती)+++इ+++(श)+++। पुरूदंसंसनी+++(खू)+++ङ्गोः+++(प्ल)+++। शश्वक्तमं+++(षी)+++हवमानायसा+++(खू)+++धाः+++(प्ल)+++। स्यानस्सू+++(षि)+++नुस्तनयोर्वीजा+++(कू)+++वा+++(ख)+++ग्नाइसाताइ+++(शु)+++। सूमा+++(णाफ्)+++तिर्भु+++(ख)+++तुहाउवा+++(शी)+++। स्मा+++(ख)+++इ+++(श)+++ ॥ ४ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०५</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/08_R-8_sA-9/05/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/08_R-8_sA-9/05/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - वत्सप्रिर्भालन्दनः‍ अग्निः त्रिष्टुप्&lt;/summary&gt;&#xA;&lt;p&gt;प्रहो॓ता॑जातो॑माहा॓न्ना॒भोवीत् । नृषात्मा॑सीददपां॓वीवार्ते॑ । दधद्यो॑धायीसू॑ते॒वा॒यांसि॑ । यन्तावासूनीवीधाते॓ता॑नूपाः ॥ ५ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - काश्यपेद्वे ॥ द्वयोः कश्यपस्त्रिष्टुबग्निः ॥&lt;/summary&gt;&#xA;&lt;p&gt;प्रहोताजाताः+++(तु)+++। माहान्नभोवाइ+++(षू)+++नृषद्मा+++(टि)+++सी+++(त)+++। दा+++(तच्)+++द+++(क)+++पांविवर्ताइ+++(षु)+++दधद्यो+++(टि)+++धा+++(त)+++। याइसूते+++(षी)+++वयांसियन्ता+++(कु)+++उवा+++(ता)+++। वासूनीवी+++(की)+++धा+++(च)+++तो+++(टट्)+++या+++(ख)+++औहोवा+++(शि)+++। तनू+++(ता)+++पा+++(ख)+++ ॥ ५ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - काश्यपेद्वे ॥ द्वयोः कश्यपस्त्रिष्टुबग्निः ॥&lt;/summary&gt;&#xA;&lt;p&gt;प्रहोताजात+++(षु)+++उहुवा+++(ति)+++हा+++(त)+++इ+++(श)+++। माहा+++(टा)+++न्नभो+++(टा)+++वाइनृषद्मा+++(टु)+++सीददपां+++(की)+++वीवा+++(टा)+++र्ता+++(त)+++इ+++(श)+++। ओऔ+++(का)+++हो+++(त)+++इहा+++(ता)+++। दाधा+++(टा)+++द्योधा+++(टा)+++याइसुते+++(षी)+++वयांसियन्ता+++(कु)+++वासू+++(ट्)+++नी+++(त)+++। ओऔ+++(का)+++हो+++(त)+++इहा+++(ता)+++। वीधा+++(का)+++ताइतनू+++(टीट्)+++पा+++(ख)+++औहोवा+++(शि)+++। हाविष्मा+++(टि)+++ते+++(ख)+++ ॥ ६ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०६</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/08_R-8_sA-9/06/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/08_R-8_sA-9/06/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - वसिष्ठो मैत्रावरुणिः अग्निः त्रिष्टुप्&lt;/summary&gt;&#xA;&lt;p&gt;प्रासम्राजमा॒सू॑रस्यप्रा॑शस्तं । पुंसःकृष्टीना॓मा॑नूमाद्यास्या॑ । इन्द्रस्येवप्रा॒तावा॓सःकृता॒नि । व॒न्द॓द्वीरावन्दमानाविवष्टु ॥ ६ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - घृताचेराङ्गिरसस्यसामनीद्वे ॥ घृताचिस्त्रिष्टुबग्निः ॥ इन्द्रो वा ॥ भरद्वाजस्त्रिष्टुबग्निः ॥&lt;/summary&gt;&#xA;&lt;p&gt;प्रसम्म्राजा+++(ती)+++म्। आसुरस्यप्राशा+++(खू)+++स्त+++(श)+++म्। पुंसःकृष्टाइना+++(टू)+++मानुमा+++(कि)+++दीया+++(खा)+++स्या+++(श)+++। इन्द्रस्येवा+++(खी)+++प्रातावासःकृता+++(खू)+++नि+++(श)+++। वन्द+++(चा)+++द्वीरा+++(था)+++वन्द+++(चा)+++माना+++(था)+++विवा+++(टा)+++ष्टू+++(ख)+++औहोवा+++(शि)+++। दी+++(ख)+++शआः+++(प्ला)+++ ॥ ७ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०७</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/08_R-8_sA-9/07/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/08_R-8_sA-9/07/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - विश्वामित्रो गाथिनः अग्निः त्रिष्टुप्&lt;/summary&gt;&#xA;&lt;p&gt;आरण्॒योर्नीहीतोजातावे॑दाः । ग॓र्भा॑यीवेत्सू॓भृ॑तोगर्भिणीभिः । दीवे॓दीवाईश्वोजागृवा॒त्मिः । हा॒वि॒ष्मा॑द्धि॓र्मानुष्ये॑भीरग्निः॒ ॥ ७ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - घृताचेराङ्गिरसस्यसामनीद्वे ॥ घृताचिस्त्रिष्टुबग्निः ॥ इन्द्रो वा ॥ भरद्वाजस्त्रिष्टुबग्निः ॥&lt;/summary&gt;&#xA;&lt;p&gt;अरण्योः+++(ति)+++। निहितोजा+++(खी)+++तवे+++(खा)+++दाः+++(प्ल)+++। गर्भइवे+++(षी)+++त्सुभृतोग+++(फु)+++र्भिणा+++(खा)+++इभीः+++(प्ला)+++। दीवेदीव+++(षी)+++ईढ्योजा+++(कि)+++गृवा+++(टा)+++त्भीः+++(त)+++। हा+++(ख)+++वी+++(प्ल)+++ष्मा+++(ख)+++त्भीः+++(ण)+++। मनुष्येभीरग्नि+++(षू)+++रेहियाहा+++(प्लू)+++। हो+++(प्ल)+++इळा+++(शा)+++ ॥ ८ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०८</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/08_R-8_sA-9/08/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/1_AgneyapAThaH/08_R-8_sA-9/08/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - पायुर्भारद्वाजः अग्निः त्रिष्टुप्&lt;/summary&gt;&#xA;&lt;p&gt;सा॒नाद॑अग्नेमृणसि॑यतूधाना॑न् । न॒त्वारक्षां॓सीपृ॒ता॑नासुजिग्युः । आनू॑दहासाहामूरान्काया॒दाः । मा॓ते॑हेत्यामू॑क्षातादै॒व्या॑याः ॥ ८ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - भारद्वाजस्यप्रासाहम् ॥ अग्निस्त्रिष्टुबग्निः ॥&lt;/summary&gt;&#xA;&lt;p&gt;अहावोअहावो+++(षू)+++अहा+++(ता)+++। सानादग्नाइ+++(कु)+++मृणासीया+++(की)+++तूधा+++(खा)+++ना+++(श)+++न्। नत्वारक्षांसी+++(कु)+++पार्ताना+++(कि)+++सुजी+++(खा)+++ग्युः+++(प्ल)+++। अनुदहा+++(की)+++सहमूरा+++(की)+++ङ्कया+++(खा)+++दाः+++(प्ल)+++। अहावोअहावो+++(षू)+++अहा+++(ता)+++। मा+++(क)+++ताइहे+++(कि)+++त्यामुक्षतदा+++(पु)+++इवीया+++(खि)+++। याः+++(त्र)+++ ॥ ९ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
  </channel>
