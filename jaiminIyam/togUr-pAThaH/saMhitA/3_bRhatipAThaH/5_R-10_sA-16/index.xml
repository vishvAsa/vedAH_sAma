    <item>
      <title>०१</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/3_bRhatipAThaH/5_R-10_sA-16/01/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/3_bRhatipAThaH/5_R-10_sA-16/01/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - पुरुहन्मा आंगिरसः इन्द्रः बृहती&lt;/summary&gt;&#xA;&lt;p&gt;योरा॒जा॑चर्षा॑णीनां । या॒तारा॓थेभीरा॒ध्री॑गुः । वि॒श्वा॑सान्तारु॒तापृ॒तानानां । जे॒ष्ठंयो॓वृत्राहा॒गृणे ॥ १ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - पौरूहन्मनञ्च ॥ पुरुहन्मा विराट् बृहतीन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;योराजाचा+++(खी)+++र्षाणाइना+++(प्ली)+++म्। यातारथे+++(कीच्)+++भीरा+++(का)+++ध्रा+++(य)+++इगूः+++(टा)+++ध्राइगूः+++(टि)+++। वाइश्वासा+++(टी)+++न्तारूता+++(टि)+++तारूता+++(टि)+++पार्ता+++(का)+++ना+++(ख)+++ना+++(ण)+++म्। ज्याइष्ठायो+++(टी)+++वात्राहा+++(कि)+++गा+++(ख)+++र्णा+++(ण)+++इ+++(श)+++। त्रहागृणा+++(प्ली)+++इ+++(श)+++। हो+++(प्ल)+++इळा+++(शा)+++ ॥ १ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - प्राकर्षञ्च ॥ पुरुहन्मा विराट् बृहतीन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;योराजाचऋ+++(तु)+++षाणा+++(खा)+++इना+++(शा)+++म्। यातारथे+++(की)+++भीराध्रा+++(टि)+++इगूः+++(ता)+++। विश्वासान्तरुता+++(षू)+++पृतना+++(टि)+++ना+++(त)+++म्। ज्या+++(ट)+++इष्ठा+++(ता)+++य्योवृ+++(का)+++त्राहाउवा+++(की)+++। ओ+++(प)+++बागार्णो+++(प्लि)+++। हाइ+++(शा)+++। ॥ २ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०२</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/3_bRhatipAThaH/5_R-10_sA-16/02/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/3_bRhatipAThaH/5_R-10_sA-16/02/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - भर्गः प्रागाथः इन्द्रः बृहती&lt;/summary&gt;&#xA;&lt;p&gt;याता॑इन्द्राभाया॑महे । ता॓तो॑नोआ॒भा॑यंकृ॑धि । मा॒घा॑वन्शग्धिता॓वा॑तन्नाऊता॒ये॑ । वि॒द्वि॒षोविमृधो॑जहि ॥ २ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - इन्द्रस्यचाभयङ्करम् ॥ इन्द्रो बृहतीन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;यतआन्द्रा+++(खी)+++भायामहा+++(प्ली)+++इ+++(श)+++। तातोनो+++(कि)+++अभायङ्का+++(टि)+++र्द्धी+++(त)+++। माघवन्शग्धि+++(षु)+++तवत+++(कि)+++न्नाऊता+++(टि)+++या+++(त)+++इ+++(श)+++। विद्वाइषो+++(टी)+++वी+++(त)+++मार्धो+++(का)+++जहिइळा+++(टी)+++भा+++(खण्)+++। ओ+++(प)+++इळा+++(शा)+++ ॥ ३ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०३</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/3_bRhatipAThaH/5_R-10_sA-16/03/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/3_bRhatipAThaH/5_R-10_sA-16/03/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - इरिम्बिठिः काण्वः इन्द्रः (वास्तोष्पति वा) बृहती&lt;/summary&gt;&#xA;&lt;p&gt;वास्तो॑ष्पतेध्रूवा॒स्थूणां । अंसत्रं॒सौ॑म्या॒नाम् । द्रप्सः॒पूरां॒भेक्ताशश्वा॑तीनाम् । इ॒न्द्रो॒मू॓नीनां॑सा॒खा॑ ॥ ३ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - कावर्षेद्वे ॥ कवषो बृहतीन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;वास्तोष्पता+++(ती)+++इ+++(श)+++। ध्रूवास्थूणा+++(टी)+++उवो+++(खा)+++वा+++(श)+++। अंसत्रं+++(किच्)+++सो+++(क)+++म्याना+++(टा)+++म्। द्रप्सःपुरांभेक्ता+++(षू)+++शश्वता+++(टि)+++इनामा+++(खि)+++इन्द्राः+++(णा)+++। मूनीनां+++(कि)+++आउवा+++(टि)+++। सा+++(ख)+++खा+++(श)+++ ॥ ४ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - कावर्षेद्वे ॥ (वास्तोष्पतिः) ॥&lt;/summary&gt;&#xA;&lt;p&gt;वास्तोष्पतेध्रूवा+++(फू)+++स्थू+++(त)+++णां+++(प)+++सत्रंसो+++(प्लि)+++म्या+++(ङ)+++ना+++(श)+++म्। द्रप्सःपुरांभेक्ता+++(षू)+++शश्वता+++(टि)+++इना+++(ता)+++म्। आ+++(ट)+++इन्द्राः+++(ता)+++। मूनी+++(टा)+++ना+++(खणफप्ल्)+++म्। सा+++(ख)+++खा+++(श)+++ ॥ ५ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०४</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/3_bRhatipAThaH/5_R-10_sA-16/04/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/3_bRhatipAThaH/5_R-10_sA-16/04/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - जमदग्निभागर्वः इन्द्रः (सूर्यः) बृहती&lt;/summary&gt;&#xA;&lt;p&gt;ब॒ण्माहं॒आ॑सीसूर्या । बा॒ळा॑दित्यामाहंआसि । माह॒स्ते॑सातो॓मा॑हीमा॒पा॑निष्ठमा । मन्हा॒दे॑वामाहं॒आसि ॥ ४ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - सूर्यसामच ॥ सूर्यो बृहती सूर्यः ॥&lt;/summary&gt;&#xA;&lt;p&gt;बण्महं+++(खि)+++असिसूर्या+++(शी)+++। बाळादित्या+++(कीच्)+++माहं+++(का)+++आ+++(य)+++सा+++(प)+++ई+++(ण)+++माहस्ते+++(णि)+++सातो+++(फा)+++माहि+++(फा)+++मापा+++(प्ला)+++नी+++(प)+++ष्टा+++(त)+++मा+++(त)+++। मन्हादा+++(टि)+++इवा+++(ता)+++। मा+++(क)+++हो+++(प)+++बा+++(प्ल)+++आसो+++(प्ल)+++। हाइ+++(शा)+++ ॥ ६ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०५</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/3_bRhatipAThaH/5_R-10_sA-16/05/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/3_bRhatipAThaH/5_R-10_sA-16/05/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - देवातिथिः काण्वः इन्द्रः बृहती&lt;/summary&gt;&#xA;&lt;p&gt;या॓दि॑न्द्राप्रा॒गपागूद॑त् । न्या॑ग्वाहूयासेनृभिः॑ । सीमा॑पूरूनृ॒षू॑तोअस्या॒ना॓वे । आ॒सी॑प्रशार्धातुर्वा॒शे ॥ ५ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - नैपातिथेद्वे वाशेवा ॥ द्वयोर्निपातिथिर्वृहतीन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;यदिन्द्रप्रागपा+++(तू)+++त्। ऊदा+++(का)+++न्याग्वाहूयासे+++(कु)+++नृभा+++(टा)+++इः+++(श)+++। सिमा+++(टाच्)+++पूरू+++(चा)+++नृषूतो+++(थि)+++अस्यानवे+++(टी)+++। आसी+++(टा)+++प्राशा+++(टाच्)+++द्धा+++(क)+++तो+++(प)+++बा+++(प्ल)+++र्वाशो+++(प्ला)+++। हाइ+++(शा)+++ ॥ ७ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - नैपातिथेद्वे वाशेवा ॥ द्वयोर्निपातिथिर्वृहतीन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;यदिन्द्रप्रा+++(षी)+++गपागुदा+++(ती)+++गे+++(त)+++। नायग्वाहू+++(कीच्)+++या+++(क)+++साइनृभि+++(टी)+++र्हाबुहो+++(खि)+++हा+++(ण)+++इ+++(श)+++। सिमा+++(टाच्)+++पू+++(क)+++रू+++(च)+++नृषूतो+++(थि)+++अस्यानवे+++(टी)+++र्हाबुहो+++(खि)+++हा+++(ण)+++इ+++(श)+++। आसाइप्राशा+++(टुच्)+++र्हाबुहो+++(खि)+++हा+++(ण)+++इ+++(श)+++। द्धा+++(टट्)+++तू+++(ख)+++औहोवा+++(शि)+++। र्वा+++(ख)+++शे+++(श)+++ ॥ ८ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०६</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/3_bRhatipAThaH/5_R-10_sA-16/06/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/3_bRhatipAThaH/5_R-10_sA-16/06/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - वसिष्ठो मैत्रावरुणिः इन्द्रः बृहती&lt;/summary&gt;&#xA;&lt;p&gt;क॒स्तामि॑न्द्रत्वावसो । आ॒मा॒र्क्त्यो॑दधर्षते । श्र॒द्धाही॒तेमाघा॒वन्पा॓र्येदीवी । वाजी॒वाजंसिषासति ॥ ६ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - कौन्मुदेद्वेस्वर्जोतिषीवा ॥ द्वयोः कुमुदो बृहत् बृहतीन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;कस्तमिन्द्रा+++(ती)+++। तुवा+++(टा)+++वासा+++(टा)+++बु+++(श)+++। आमर्क्त्यो+++(षी)+++दधर्षता+++(ची)+++इ+++(श)+++श्रद्धा+++(था)+++हाइते+++(टि)+++। माघव+++(कि)+++न्पार्याइदा+++(यी)+++इवी+++(टा)+++। वाजी+++(टा)+++वाजां+++(टा)+++सी+++(क)+++षासा+++(टाट्)+++ता+++(ख)+++औहोवा+++(शि)+++। उऊ+++(खा)+++पा+++(श)+++ ॥ ९ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - कौन्मुदेद्वेस्वर्जोतिषीवा ॥ द्वयोः कुमुदो बृहत् बृहतीन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;कस्तमिन्द्रात्वा+++(फु)+++वसा+++(ता)+++बूआ+++(पा)+++मर्क्त्योदधर्षताइ+++(शृ)+++। श्रद्धा+++(था)+++हाइते+++(टि)+++। माघव+++(कि)+++न्पार्याइदाइवा+++(टू)+++उवो+++(खा)+++वा+++(श)+++। वाजी+++(था)+++वाजां+++(टाच्)+++सी+++(क)+++षासा+++(टाट्)+++ता+++(ख)+++औहोवा+++(शि)+++। उऊ+++(खा)+++पा+++(श)+++ ॥ १० ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०७</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/3_bRhatipAThaH/5_R-10_sA-16/07/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/3_bRhatipAThaH/5_R-10_sA-16/07/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - देवातिथिः काण्वः इन्द्रः बृहती&lt;/summary&gt;&#xA;&lt;p&gt;अश्वीराथीसुरूपायुः॒ । गोम॒य्यादिन्द्राते॒साखा । श्वात्राभा॒जावा॒या॑सासचाते॒सादा॑ । चन्द्रै॒र्यातीसाभा॒ऊ॒पा॑ ॥ ७ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - अनूपेद्वे ॥ आनूपो बृहतीन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;अश्वीअश्वी+++(ती)+++। रथी+++(काच्)+++सूरू+++(का)+++पा+++(य)+++यूः+++(ट)+++। गो+++(क)+++मय्यदि+++(कि)+++न्द्राते+++(या)+++साखा+++(टा)+++। श्वात्रा+++(टा)+++भाजा+++(टा)+++वयसा+++(चि)+++सचातेसा+++(टि)+++दा+++(त)+++। चन्द्राइर्या+++(भी)+++ती+++(त)+++। सा+++(प)+++भा+++(श)+++ऊ+++(ख)+++पो+++(प्ल)+++। हाइ+++(शा)+++ ॥ ११ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - अनूपेद्वे ॥ आनूपो बृहतीन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;अश्वीरथीसुरूपा+++(तू)+++यूः+++(त)+++। गो+++(कि)+++मय्यदि+++(कि)+++न्द्रातेसखा+++(की)+++उवा+++(टा)+++हाउवा+++(टि)+++हो+++(क)+++वा+++(थ)+++इया+++(चा)+++। श्वात्राभाजा+++(षी)+++वयसा+++(कि)+++सचातेसदा+++(कु)+++उवा+++(टा)+++हाउवा+++(टि)+++हो+++(क)+++वा+++(थ)+++इया+++(चा)+++। चन्द्रा+++(चा)+++इर्या+++(या)+++ती+++(त)+++। साभा+++(का)+++ऊपाइळा+++(टी)+++भा+++(खण्)+++। ओ+++(प)+++इळा+++(प्ला)+++ ॥ १२ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०८</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/3_bRhatipAThaH/5_R-10_sA-16/08/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/3_bRhatipAThaH/5_R-10_sA-16/08/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - पुरुहन्मा आंगिरसः इन्द्रः बृहती&lt;/summary&gt;&#xA;&lt;p&gt;य॒द्यावा॒इन्द्रतेशातं॒ । शातं॓भूमी॑रूतास्युः । न॒त्वावज्ज्रिन्साहा॒स्रंसू॒र्याआनू॑ । ना॒जाता॓माष्टारोद॑सी ॥ ८ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - वैरूपञ्च ॥ विरूपो बृहतीन्द्रः ॥ (सूर्यः) ॥&lt;/summary&gt;&#xA;&lt;p&gt;यद्यावा+++(पि)+++इन्द्रतेशता+++(शु)+++म्। शातंभूमी+++(की)+++रूतास्यूः+++(टि)+++। नत्वावज्रि+++(षी)+++न्साहस्रंसूर्या+++(कु)+++आनू+++(टा)+++। नाजा+++(टा)+++तामा+++(टाच्)+++ष्टा+++(क)+++रो+++(प)+++बा+++(प्ल)+++दासो+++(प्ला)+++। हाइ+++(शा)+++ ॥ १३ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०९</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/3_bRhatipAThaH/5_R-10_sA-16/09/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/3_bRhatipAThaH/5_R-10_sA-16/09/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - भरद्वाजो बार्हस्पत्यः इन्द्रः (इन्द्राग्नी) बृहती&lt;/summary&gt;&#xA;&lt;p&gt;इन्द्रा॑ग्नीआपा॒दीय॒म् । पूर्वागा॓त्पद्वा॒ती॑भ्यः । हित्वा॓शि ॓रो॑जिह्वा॒या॓रा॑रापच्चारात् । त्रिंशा॒त्पादा॒न्या॑क्रमीत् ॥ ९ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - वाचश्चसाम ॥ वाक् बहती इन्द्राग्नी ॥&lt;/summary&gt;&#xA;&lt;p&gt;इन्द्राग्नी+++(षी)+++यपादिया+++(ती)+++मे+++(त)+++। पूर्वागा+++(टि)+++त्पद्वादा+++(चि)+++इभा+++(या)+++याः+++(ट)+++। हित्वाशिरो+++(टी)+++जिह्वायारारापा+++(यू)+++श्चारा+++(टा)+++त्। त्रिं+++(क)+++शत्पदान्याक्रा+++(टुट्)+++मा+++(ख)+++औहोवा+++(शि)+++। उऊ+++(खा)+++पा+++(श)+++ ॥ १४ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>१०</title>
