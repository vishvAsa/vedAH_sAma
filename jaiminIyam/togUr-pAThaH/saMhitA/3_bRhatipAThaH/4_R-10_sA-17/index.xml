    <item>
      <title>०१</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/3_bRhatipAThaH/4_R-10_sA-17/01/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/3_bRhatipAThaH/4_R-10_sA-17/01/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - मेधातिथिः (मध्येआतिथिः) काण्वः इन्द्रः बृहती&lt;/summary&gt;&#xA;&lt;p&gt;सत्य॒मित्थावृषेद॑सि । वृ॒र्षा॑जूतिर्नोवीता । वृ॒षाह्युठे॑ग्रश्रृण्वीषे॓पा॑रावा॑ती । वृषोअर्वावा॓ती॑श्रुताः॓ ॥ १ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - इन्द्रस्यचवृषकम् ॥ इन्द्रो बृहतीन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;सत्यमित्थावृषा+++(तू)+++इदसा+++(ति)+++इ+++(श)+++। वृषजूतिनो+++(षु)+++र्विता+++(टा)+++वृषा+++(चा)+++ह्युग्रा+++(चा)+++शा+++(य)+++ण्विषा+++(टा)+++इपरा+++(कि)+++वाता+++(चा)+++इ+++(श)+++। वृषोआ+++(टि)+++र्वा+++(त)+++। वाताइश्रू+++(टी)+++ताः+++(ख)+++। ओ+++(प)+++इळा+++(शा)+++ ॥ १ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०२</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/3_bRhatipAThaH/4_R-10_sA-17/02/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/3_bRhatipAThaH/4_R-10_sA-17/02/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - रेभः कश्यपः इन्द्रः बृहती&lt;/summary&gt;&#xA;&lt;p&gt;या॒च्चाक्रासी॑पा॑रावा॒ति । याद॑र्वावा॒तीवृत्रहन् । आ॒ता॑स्त्वागीर्भिद्युगदिन्द्राकेशी॒भीः । सूता॒वंआ॒वी॒वा॑सति ॥ २ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - द्वैगतेच ॥ द्वैगते वा द्वयोः । द्वयोः द्विगत् बृहतीन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;यच्छाक्रासी+++(खी)+++पारावाती+++(प्ली)+++। यादर्वावा+++(टीच्)+++तीवा+++(का)+++त्रा+++(य)+++हा+++(ट)+++न्। अता+++(ता)+++औ+++(ट)+++हो+++(त)+++वा+++(त)+++। स्त्वागीर्भि+++(टि)+++द्युगदि+++(कि)+++न्द्राके+++(या)+++शीभीः+++(टा)+++। सूता+++(चा)+++वं+++(ट)+++आ+++(ख)+++आऔहोवा+++(शि)+++। ए+++(त)+++विवा+++(टा)+++सती+++(खा)+++ ॥ २ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - द्वैगतेच ॥ द्वैगते वा द्वयोः । द्वयोः द्विगत् बृहतीन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;यच्छक्रासि+++(षी)+++परावतियदो+++(तू)+++वा+++(त)+++। अर्वा+++(थाच्)+++वाता+++(का)+++इवा+++(या)+++त्राहा+++(पा)+++न्नता+++(खा)+++स्त्वगा+++(ता)+++इ+++(श)+++। भा+++(क)+++इर्द्युगदि+++(की)+++न्द्राके+++(या)+++शीभीः+++(टा)+++। सूता+++(टा)+++वं+++(टट्)+++आ+++(ख)+++औहोवा+++(शि)+++। विवा+++(टा)+++सती+++(खा)+++ ॥ ३ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०३</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/3_bRhatipAThaH/4_R-10_sA-17/03/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/3_bRhatipAThaH/4_R-10_sA-17/03/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - वत्सः (वशोऽश्वयः) इन्द्रः बृहती&lt;/summary&gt;&#xA;&lt;p&gt;आभीवो॑वीर॓म॒न्धा॑सामादेषुगाया । गीरा॒माहावी॒चे॑तसं । इ॒न्द्रन्नामश्रू॓त्यंशाकीनं॓वाचोयाथा ॥ ३ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - कार्तवेशञ्च ॥ कृतयशा बृहतीन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;आभीवोवीर+++(षु)+++मन्धसा+++(ति)+++। मदे+++(काच्)+++षु+++(क)+++गाया+++(टा)+++गी+++(क)+++रामाहा+++(टि)+++वीचे+++(का)+++ता+++(ख)+++स+++(ण)+++म्। इन्द्रन्नामा+++(ती)+++। श्रुत्यं+++(का)+++शाका+++(टा)+++इना+++(खा)+++मौहोवा+++(शि)+++। वचो+++(ता)+++। ऊ+++(ट)+++पा+++(ख)+++ ॥ ४ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०४</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/3_bRhatipAThaH/4_R-10_sA-17/04/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/3_bRhatipAThaH/4_R-10_sA-17/04/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - भरद्वाजः (शयुः) बार्हस्पत्यः इन्द्रः बृहती&lt;/summary&gt;&#xA;&lt;p&gt;इ॓न्द्रा॑त्रीधा॒तू॑शाराणं॒ । त्रीवा॒रू॒थंस्वस्ताये॓ । छर्दिया॑च्छामाघा॑वा॑भ्या॑श्चामंह्य॑न्च । यावा॓यादिद्यू॒मे॑भ्यः ॥ ४ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - इन्द्रस्यच शरणम् ॥ इन्द्रो बृहतीन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;इन्द्रत्रिधा+++(फी)+++तुशारणा+++(शी)+++म्। त्रीवरूथं+++(षी)+++स्वस्तया+++(चि)+++इछर्दिर्या+++(टी)+++च्छा+++(त)+++। माघवत्भ्या+++(की)+++श्चा+++(क)+++मह्या+++(टा)+++ञ्चा+++(त)+++। या+++(क)+++वया+++(टा)+++दी+++(त)+++द्यूमे+++(का)+++भ्याऔ+++(टा)+++हो+++(ख)+++बा+++(प्ल)+++। हो+++(प्ल)+++इळा+++(शा)+++ ॥ ५ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०५</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/3_bRhatipAThaH/4_R-10_sA-17/05/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/3_bRhatipAThaH/4_R-10_sA-17/05/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - नृमेध आंगिरसः इन्द्रः बृहती&lt;/summary&gt;&#xA;&lt;p&gt;श्रा॒यन्ता॑ईवासूर्य॑ । विश्वे॒दिन्द्रा॑स्यभक्षत । वासू॒नीजातो॓ज॑निमान्यो॒ज॑सा । प्रा॓ती॑भा॑ग॒न्ना॒दी॑धीमः ॥ ५ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - श्रायन्तीयञ्च ॥ प्रजापति बृहतीन्द्रः ॥ (सूर्यः) ॥&lt;/summary&gt;&#xA;&lt;p&gt;श्रायन्तईवसू+++(षू)+++ओरा+++(ता)+++या+++(त)+++म्। विश्वा+++(टा)+++इदिन्द्रा+++(टि)+++स्यभा+++(टा)+++क्षाता+++(टा)+++। वासूनिजा+++(की)+++तोजनिमा+++(कीच्)+++नीयो+++(का)+++जा+++(य)+++सा+++(ट)+++। प्रातीभा+++(कि)+++गन्नादी+++(कि)+++धीमःप्रा+++(टि)+++ती+++(त)+++। भागान्ना+++(पि)+++दाहि+++(शा)+++म्। धिमा+++(ता)+++ओ+++(प)+++बा+++(प्ल)+++। हे+++(ख)+++ ॥ ६ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०६</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/3_bRhatipAThaH/4_R-10_sA-17/06/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/3_bRhatipAThaH/4_R-10_sA-17/06/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - पुरुहन्मा आंगिरसः इन्द्रः बृहती&lt;/summary&gt;&#xA;&lt;p&gt;ना॒सीमादे॑वआपाता॒त् । ईळन्दी॑र्घा॑योमर्क्त्याः । एता॑ग्वाचिद्या॒एता॑शोयूयो॒जाते । इन्द्रोहा॓रीयूयो॒जा॑ते ॥ ६ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - आक्षीलन्चबाभ्रंवा ॥ वाम्रो बृहतीन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;नसीमा+++(चि)+++दे+++(क)+++वा+++(फ)+++या+++(प्ल)+++हा+++(त)+++हा+++(त)+++इ+++(श)+++पा+++(प)+++तत्पतोवा+++(शी)+++। इषंहो+++(टि)+++इदीर्घाहो+++(भी)+++यो+++(च)+++मा+++(य)+++र्क्त्याः+++(ट)+++। आइतग्वा+++(टी)+++ची+++(त)+++द्याया+++(का)+++इताशो+++(कि)+++यूयोउवा+++(की)+++। ऊ+++(ख)+++पा+++(श)+++। जाता+++(टा)+++आइन्द्रो+++(टि)+++हारी+++(टाच्)+++यू+++(क)+++योजा+++(टा)+++जा+++(ट)+++ता+++(ख)+++औहोवा+++(शि)+++। उऊ+++(खा)+++पा+++(श)+++ ॥ ७ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०७</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/3_bRhatipAThaH/4_R-10_sA-17/07/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/3_bRhatipAThaH/4_R-10_sA-17/07/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - नृमेध- पुरुमेधाषांगिरसौ इन्द्रः बृहती&lt;/summary&gt;&#xA;&lt;p&gt;आ॒नोवि॓श्वासुहा॒व्यं॑ । इ॓न्द्रं॑सामात्सू॑भूषत । ऊ॒पाब्र॓ह्णा॑णीसा॒वा॑नानिवृत्रहन् । परमाज्यऋचीषमा ॥ ७ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - शौक्तानि त्रीणि शुक्लानिवा आश्वानिवा ॥ त्रयाणां वसिष्ठो बृहतीन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;आनएविश्वा+++(तु)+++। सुहा+++(टा)+++ओव्या+++(टा)+++म्। आइन्द्रंसमात्सू+++(कू)+++भूषाता+++(कि)+++ऊ+++(ख)+++पा+++(शप्ल्)+++हा+++(त)+++हा+++(त)+++इ+++(श)+++। ब्रह्मा+++(का)+++णीसवना+++(ची)+++नीवृत्रहा+++(ची)+++न्पा+++(क)+++रामा+++(टा)+++ज्याः+++(त)+++। आर्चा+++(टा)+++हा+++(त)+++इ+++(श)+++षा+++(क)+++माऔ+++(टा)+++हो+++(ख)+++बा+++(प्ल)+++। हो+++(प्ल)+++इळा+++(शा)+++ ॥ ८ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - शौक्तानि त्रीणि शुक्लानिवा आश्वानिवा ॥ त्रयाणां वसिष्ठो बृहतीन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;आनोविश्वासुहा+++(तू)+++हा+++(त)+++व्या+++(त)+++म्। इ+++(क)+++न्द्रंसमात्सू+++(की)+++भूषाता+++(कि)+++ऊपब्रा+++(टि)+++ह्मा+++(त)+++। णीसवना+++(ची)+++निवृत्रहा+++(ची)+++न्पा+++(क)+++रमा+++(टा)+++ज्याः+++(त)+++। आर्चा+++(टा)+++हा+++(त)+++इ+++(श)+++षा+++(क)+++माऔ+++(टा)+++हो+++(ख)+++बा+++(प्ल)+++। हो+++(प्ल)+++इळा+++(शा)+++ ॥ ९ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - शौक्तानि त्रीणि शुक्लानिवा आश्वानिवा ॥ त्रयाणां वसिष्ठो बृहतीन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;आनोविश्वासुहा+++(तू)+++व्या+++(त)+++म्। इन्द्रंसमात्सु+++(षु)+++भुषाता+++(चि)+++ऊपा+++(का)+++ब्रा+++(य)+++ह्मा+++(ट)+++। णीसवनानि+++(षु)+++वृत्रहा+++(चि)+++न्पारा+++(का)+++मा+++(य)+++ज्याः+++(ट)+++। ऋचिषा+++(टि)+++मा+++(खण्)+++। ओ+++(प)+++इळा+++(शा)+++ ॥ १० ॥&lt;/p&gt;</description>
    </item>
    <item>
      <title>०८</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/3_bRhatipAThaH/4_R-10_sA-17/08/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/3_bRhatipAThaH/4_R-10_sA-17/08/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - वसिष्ठो मैत्रावरुणिः इन्द्रः बृहती&lt;/summary&gt;&#xA;&lt;p&gt;त॓वेदि॑न्द्रावा॒मंवा॒सू । त्वंपू॑ष्यसिमाध्यामं । सत्रा॒विश्वास्यापारामास्या॑राजसि । ना॓कीष्ट्वा॓गोषू॑वृण्वते ॥ ८ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - प्रजापतेर्निधन कामम् ॥ प्रजापतिबृहतीन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;तवेदिन्द्रा+++(फी)+++वमंवसू+++(की)+++। त्वंपुष्यसिमा+++(कु)+++ध्यामंसात्रा+++(टी)+++वा+++(ख)+++इश्वा+++(णा)+++। स्या+++(क)+++परामस्यरा+++(षु)+++जसी+++(का)+++नकिष्ट्वा+++(खि)+++गो+++(ण)+++। षू+++(ट)+++वृण्वा+++(टा)+++ता+++(त)+++इ+++(श)+++। होवा+++(टा)+++हो+++(च)+++इहोवा+++(टिच्)+++हा+++(कच्)+++बु+++(श)+++। बा+++(ख)+++ ॥ ११ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
