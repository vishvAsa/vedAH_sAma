    <item>
      <title>०१</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/3_bRhatipAThaH/6_R-10_sA-17/01/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/3_bRhatipAThaH/6_R-10_sA-17/01/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - नृमेध आंगिरसः इन्द्रः बृहती&lt;/summary&gt;&#xA;&lt;p&gt;ई॒ताऊती॓वो॑आज॒रं॑ । प्रे॒हेता॒रामा॒प्रा॑हितं । आशू॓ञ्जे॓ता॑रंहोता॑रंराथी॒तामं । आ॒तूर्तन्तूग्रीयावृ॒धम् ॥ १ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - गौरीवितेःप्रहितौद्वौ ॥ द्वयोर्गौरीवितिर्वृहतीन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;इतऊती+++(ती)+++। वो+++(त)+++ओजा+++(टा)+++रामौ+++(टा)+++हो+++(त)+++वाऔ+++(टा)+++हो+++(त)+++वा+++(त)+++। प्रहेता+++(थिच्)+++रा+++(क)+++मप्राही+++(भि)+++तामौ+++(टा)+++हो+++(त)+++वाऔ+++(टा)+++हो+++(त)+++वा+++(त)+++। आशुञ्जे+++(कि)+++ता+++(थ)+++रंहाइता+++(टी)+++रामौ+++(टा)+++हो+++(त)+++वाऔ+++(टा)+++हो+++(त)+++वा+++(त)+++। राथाई+++(षि)+++तममतूर्ता+++(टू)+++न्तू+++(त)+++। ग्रीया+++(ता)+++वा+++(टट्)+++र्धा+++(ख)+++औहोवा+++(शि)+++। स्तुषे+++(ताच्)+++ ॥ १ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - गौरीवितेःप्रहितौद्वौ ॥ द्वयोर्गौरीवितिर्वृहतीन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;इतऊति+++(षी)+++वोआजा+++(ति)+++रा+++(त)+++म्। प्रहे+++(का)+++तारमप्राहिता+++(षू)+++मुहुवा+++(टि)+++होआ+++(का)+++शुन्जेतारं+++(षी)+++हेतारमुहुवा+++(टू)+++हो+++(च)+++इ+++(श)+++। रथि+++(का)+++तमा+++(टा)+++मतूर्क्ता+++(खि)+++न्तू+++(ण)+++। ग्रीया+++(ता)+++वा+++(टट्)+++र्धा+++(ख)+++औहोवा+++(शि)+++। स्तो+++(त)+++षा+++(ख)+++इ+++(श)+++ ॥ २ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०२</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/3_bRhatipAThaH/6_R-10_sA-17/02/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/3_bRhatipAThaH/6_R-10_sA-17/02/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - वसिष्ठो मैत्रावरुणिः इन्द्रः बृहती&lt;/summary&gt;&#xA;&lt;p&gt;मोषु॒त्वा॒वाघा॓ताः॑चाना । आ॒रे॒आस्मिन्नी॒री॑रमन् । आ॒रा॒त्ता॒द्वासाधा॑मा॓द॑न्नाआ॒गहि । ईहा॒वासन्नूपा॑श्रुधि ॥ २ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - आत्रेद्वे ॥ द्वयोरत्रिबृहतीन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;मोषुत्वावा+++(ती)+++। घाता+++(पाणफप्ल्)+++। श्चा+++(ख)+++ना+++(श)+++। आ+++(क)+++रेअस्मिन्निरीरम+++(क)+++न्ना+++(च)+++रा+++(य)+++क्ताद्वा+++(टा)+++। साधमादा+++(टी)+++न्नायग+++(कि)+++ह्याइहवासा+++(टु)+++न्। ऊपा+++(का)+++श्रूधी+++(का)+++इळा+++(टा)+++भा+++(खण्)+++। ओ+++(प)+++इळा+++(शा)+++ ॥ ३ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - आत्रेद्वे ॥ द्वयोरत्रिबृहतीन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;मोषुत्वावाघा+++(षु)+++ताचनाए+++(ती)+++। आरेअस्मि+++(षी)+++न्निरीरम+++(टी)+++न्हो+++(क)+++वा+++(थ)+++उउवा+++(टि)+++ऊ+++(ट)+++। आ+++(च)+++रा+++(य)+++क्ताद्वा+++(टा)+++साधमादां+++(टी)+++हो+++(क)+++वा+++(थ)+++उउवा+++(टि)+++ऊ+++(ट)+++। नायागा+++(खि)+++ही+++(ण)+++। आइहवास+++(कु)+++न्नाउवो+++(खि)+++वा+++(ण)+++। ऊपश्रू+++(टि)+++धी+++(खण्)+++। ओ+++(प)+++इळा+++(शा)+++ ॥ ४ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०३</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/3_bRhatipAThaH/6_R-10_sA-17/03/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/3_bRhatipAThaH/6_R-10_sA-17/03/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - वसिष्ठो मैत्रावरुणिः इन्द्रः बृहती&lt;/summary&gt;&#xA;&lt;p&gt;सू॒नोता॑सो॒मा॒पाव्ने । सो॒मामि॒न्द्रा॑यावज्रीणे । पा॒चा॒तापक्तिरावा॑सेकृ॑णुध्वमित् । पृ॓णन्नि॓त्पृणातेमायाः॑ ॥ ३ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - गौतमेद्वे ॥ द्वयोर्गौरीवितिर्वृहतीन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;सुनोतसोमपाव्ना+++(तु)+++ए+++(त)+++। सोममिन्द्रा+++(की)+++होवा+++(टा)+++हा+++(तच्)+++या+++(क)+++वज्रा+++(टा)+++इणा+++(ता)+++इ+++(श)+++। पचता+++(किच्)+++पक्ताइरवसे+++(कूच्)+++कृणू+++(का)+++ध्वा+++(य)+++मी+++(ट)+++द्धा+++(त)+++इ+++(श)+++। पृणा+++(चा)+++न्ना+++(य)+++इत्पृ+++(टा)+++हा+++(त)+++इ+++(श)+++। णाताइमा+++(टी)+++याः+++(खण्)+++। ओ+++(प)+++इळा+++(शा)+++ ॥ ५ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - गौतमेद्वे ॥ द्वयोर्गौरीवितिर्वृहतीन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;सुनोतसोमपा+++(फू)+++व्नाउवो+++(खि)+++वाइयाहाइ+++(शु)+++। सोममिन्द्रा+++(टी)+++हुवेहुवे+++(टी)+++होयावा+++(यि)+++ज्रिणा+++(टा)+++इ+++(श)+++। पचता+++(चि)+++पक्ताइरवसे+++(टू)+++कृणू+++(का)+++ध्वा+++(य)+++मी+++(ट)+++द्धा+++(त)+++इ+++(श)+++। पृणा+++(चा)+++न्ना+++(य)+++इत्पृ+++(टा)+++हा+++(त)+++इ+++(श)+++। णाताइमा+++(टी)+++याः+++(खण्)+++। ओ+++(प)+++इळा+++(शा)+++ ॥ ६ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०४</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/3_bRhatipAThaH/6_R-10_sA-17/04/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/3_bRhatipAThaH/6_R-10_sA-17/04/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - भरद्वाजः (शयुः) बार्हस्पत्यः इन्द्रः बृहती&lt;/summary&gt;&#xA;&lt;p&gt;य॒स्सा॑त्राहा॒वीच॒ऋषणिः । इ॒न्द्रन्तंहू॓माहेवायं॒ । सा॒हा॑स्रमन्योतुविनिर्म॑णसत्पते । भा॓वा॑सामात्सू॑नोवृधे॒ ॥ ४ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - वामदेव्यञ्च ॥ वामदेवो बृहतीन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;यस्सत्राहा+++(षी)+++विचर्षणिरिद्रं+++(फू)+++तांहू+++(खा)+++माहेवय+++(प्ली)+++म्। इन्द्रन्तंहू+++(की)+++माहेवा+++(टि)+++या+++(त)+++म्। साहस्रमन्यो+++(षु)+++तुविनृ+++(कि)+++म्णासत्पा+++(टि)+++ता+++(त)+++इ+++(श)+++। भावासा+++(टि)+++मा+++(त)+++त्सूनो+++(चा)+++वृधाइळा+++(टी)+++भा+++(खण्)+++। ओ+++(प)+++इळा+++(शा)+++ ॥ ७ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०५</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/3_bRhatipAThaH/6_R-10_sA-17/05/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/3_bRhatipAThaH/6_R-10_sA-17/05/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - पुरुच्छेपो देवोदासिः इन्द्रः (शिवनौ) बृहती&lt;/summary&gt;&#xA;&lt;p&gt;शा॒चिभिर्नश्शची॒वसू । दीवान॒क्तंदिशस्यतं । मा॓वां॑रातिरूपा॑द॒सात्कादा॒चा॒ना । अस्म॒द्रा॒तीःकादाचाना॒ ॥ ५ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - अश्विनोश्चसाम ॥ अश्विनौ बृहतीन्द्रः ॥ (अश्विनौ) ॥&lt;/summary&gt;&#xA;&lt;p&gt;शचीभिर्न्ना+++(फी)+++श्शचीवसू+++(की)+++। दिवानक्त+++(षी)+++न्दिशस्यतम्मा+++(टु)+++वां+++(क)+++रा+++(क)+++तिरुपदसा+++(चु)+++त्का+++(क)+++दाचनास्मा+++(शी)+++। द्रातीःकदो+++(पी)+++बा+++(प्ल)+++। चा+++(ख)+++ना+++(श)+++ ॥ ८ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०६</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/3_bRhatipAThaH/6_R-10_sA-17/06/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/3_bRhatipAThaH/6_R-10_sA-17/06/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - वामदेवो गौतमः इन्द्रः बृहती&lt;/summary&gt;&#xA;&lt;p&gt;यादाकादा॓चामीढूषे॑ । स्तोता॒जरेतमार्क्त्याः॑ । आदीद्व॒न्दे॒तावारुणंवीपा॒गीरा॑ । धक्ता॒रंवि॒प्रा॒तानाम् ॥ ६ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - वसिष्ठस्य वज्राणि त्रीणि ॥ त्रयाणां वसिष्ठो बृहतीन्द्रावरुणः ॥&lt;/summary&gt;&#xA;&lt;p&gt;यदाकदा+++(ती)+++। चा+++(टट्)+++मा+++(ख)+++औहोवा+++(शि)+++। ढू+++(ख)+++षे+++(श)+++। स्तोताजरे+++(की)+++तमार्क्त्या+++(कि)+++आदीद्वन्द+++(षी)+++तवारूणां+++(खी)+++विपा+++(खा)+++गिरा+++(ता)+++। धर्क्ता+++(टा)+++रंवि+++(टा)+++। व्रा+++(टट्)+++ता+++(ख)+++औहोवा+++(शि)+++। ना+++(ख)+++म् ॥ ९ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - वसिष्ठस्य वज्राणि त्रीणि ॥ त्रयाणां वसिष्ठो बृहतीन्द्रावरुणः ॥&lt;/summary&gt;&#xA;&lt;p&gt;यदाकदाचमा+++(तू)+++हा+++(त)+++बु+++(श)+++। ढूषा+++(टा)+++इस्तोता+++(टि)+++जरा+++(ता)+++इ+++(श)+++तमार्क्त्याः+++(चि)+++। आदीद्वन्दौहो+++(टु)+++हो+++(ट)+++हा+++(त)+++हा+++(त)+++इ+++(श)+++तवा+++(टा)+++रू+++(ख)+++ण+++(ण)+++म्। विपा+++(का)+++गिरा+++(का)+++धर्क्तारंवियौ+++(कु)+++हो+++(ट)+++हा+++(त)+++हा+++(त)+++इ+++(श)+++। व्रता+++(का)+++नामिळा+++(टि)+++भा+++(खण्)+++। ओ+++(प)+++इळा+++(शा)+++ ॥ १० ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - वसिष्ठस्य वज्राणि त्रीणि ॥ त्रयाणां वसिष्ठो बृहतीन्द्रावरुणः ॥&lt;/summary&gt;&#xA;&lt;p&gt;यादा+++(णा)+++कादा+++(णा)+++चामी+++(फा)+++ढूषाइस्तो+++(खी)+++ता+++(ण)+++। जरा+++(ता)+++इ+++(श)+++तामार्क्ता+++(यि)+++याः+++(ट)+++। आदीद्वन्दा+++(की)+++ईतवा+++(टि)+++रू+++(ख)+++ण+++(ण)+++म्। वीपा+++(फा)+++गिरौवाउवो+++(खु)+++वा+++(श)+++। धर्क्तारं+++(फि)+++वियौवाउवो+++(खु)+++वा+++(श)+++। व्रतानां+++(प्लि)+++। हो+++(प्ल)+++इळा+++(शा)+++ ॥ ११ ॥&lt;/p&gt;</description>
    </item>
    <item>
      <title>०७</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/3_bRhatipAThaH/6_R-10_sA-17/07/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/3_bRhatipAThaH/6_R-10_sA-17/07/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - मध्येआतिथिः काण्वः इन्द्रः बृहती&lt;/summary&gt;&#xA;&lt;p&gt;पाहि॒गाया॓न्धा॑सामा॑दे । इ॒न्द्रा॓यमेधियातिथे । य॓स॓म्मिश्लोहर्यो॑र्यो॑हीरण्या॒या । इन्द्रोवज्री॓हीरण्या॒या ॥ ७ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - सौबभ्रवेद्वे ॥ सौभरिर्वृहतीन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;पाहीगाया+++(ती)+++। न्धासामा+++(टि)+++दा+++(त)+++इ+++(श)+++। आइन्द्रायमे+++(कुच्)+++धी+++(क)+++याता+++(टा)+++इथा+++(ता)+++इ+++(श)+++। यस्सम्मिश्यो+++(टी)+++हर्योर्योहाइरा+++(यू)+++ण्यायाः+++(टा)+++। इन्द्रोवा+++(भि)+++ज्रि+++(तच्)+++ही+++(क)+++रो+++(प)+++बा+++(प्ल)+++ण्यायो+++(प्ला)+++। हाइ+++(शा)+++ ॥ १२ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - सौबभ्रवेद्वे ॥ सौभरिर्वृहतीन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;पाह्येपाही+++(ती)+++। गाया+++(था)+++न्धासा+++(ता)+++मा+++(ट)+++दा+++(त)+++इ+++(श)+++। इन्द्रायमे+++(कीच)+++धी+++(क)+++याता+++(टा)+++इथा+++(ता)+++इ+++(श)+++। यस्सम्मिश्यो+++(टी)+++हर्योर्योहाइरा+++(यू)+++ण्यायाः+++(टा)+++। आइन्द्रोवा+++(भी)+++ज्री+++(तच)+++। ही+++(क)+++रो+++(प)+++बा+++(प्ल)+++ण्यायो+++(प्ला)+++। हाइ+++(शा)+++ ॥ १३ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
