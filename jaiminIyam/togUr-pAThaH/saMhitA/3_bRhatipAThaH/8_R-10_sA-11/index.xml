    <item>
      <title>०१</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/3_bRhatipAThaH/8_R-10_sA-11/01/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/3_bRhatipAThaH/8_R-10_sA-11/01/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - वसिष्ठो मैत्रावरुणिः उषा बृहती&lt;/summary&gt;&#xA;&lt;p&gt;प्रा॒ती॑वोदृश्याया॒ती । उच्छन्ती॑दूहीता॒दीवः । आ॓पो॑माही॑वृणूतेचा॓क्षू॑षाता॒माः । ज्यो॒तीःकृ॑णोतीसूना॒री ॥ १ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - उषसश्चसाम ॥ उषा बृहतीन्द्रः ॥ उषा ॥&lt;/summary&gt;&#xA;&lt;p&gt;प्राताई+++(टिच्)+++हा+++(य)+++ई+++(ट)+++हावो+++(का)+++दर्शी+++(था)+++यायती+++(टि)+++यायती+++(टि)+++। उच्छाई+++(टिच्)+++हा+++(य)+++ई+++(ट)+++हान्ती+++(का)+++दू+++(थ)+++हीतादीवा+++(टी)+++आदीवाः+++(टि)+++। आपाई+++(टिच्)+++हा+++(य)+++ई+++(ट)+++हामाहिव्रणुते+++(चू)+++चा+++(च)+++क्षुषातमा+++(टी)+++आतमाः+++(टि)+++। ज्योता+++(का)+++ई+++(टच्)+++हा+++(य)+++ई+++(ट)+++हा+++(च)+++कृणो+++(का)+++तीसूनारी+++(टी)+++ओनारी+++(पिण्)+++। ओ+++(प)+++इळा+++(शा)+++ ॥ १ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०२</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/3_bRhatipAThaH/8_R-10_sA-11/02/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/3_bRhatipAThaH/8_R-10_sA-11/02/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - वसिष्ठो मैत्रावरुणिः अश्विनौ बृहती&lt;/summary&gt;&#xA;&lt;p&gt;इमा॓ऊ॑वा॒न्दिविष्टयः । उस्रा॒हा॒वन्तेअश्विना । आ॓यं॒वा॑मंह्वाया॒वा॑सेशचीवसू । वीशं॑वीशंही॒ग॒च्छा॑थः ॥ २ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - अश्विनोश्चसाम ॥ अश्विनौ बृहतीन्द्रः ॥ (अश्विनौ वा) ॥&lt;/summary&gt;&#xA;&lt;p&gt;इमाउवा+++(षी)+++न्दिविष्टया+++(खु)+++ऐही+++(प्ला)+++। उस्राहवन्ते+++(षु)+++अश्विना+++(खि)+++ऐही+++(प्ला)+++। अयंवामह्वय+++(षू)+++वसेशचीवसू+++(खू)+++ऐही+++(प्ला)+++। विशंविशं+++(षी)+++हीगच्छथा+++(खी)+++ऐही+++(प्ला)+++। हो+++(प्ल)+++इळा+++(शा)+++ ॥ २ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०३</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/3_bRhatipAThaH/8_R-10_sA-11/03/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/3_bRhatipAThaH/8_R-10_sA-11/03/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - अश्विनौ वैवस्वतौ अश्विनौ बृहती&lt;/summary&gt;&#xA;&lt;p&gt;कु॒ष्ठःकोवा॑मश्विना । तपानो॓दे॑वामार्क्त्याः॑ । घ्नाता॒वा॒मश्नायाक्षा॑पा॑माणोंशू॒ना । इ॒त्था॒मूवा॒द्वन्या॒था॑ ॥ ३ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - अश्विनोश्चसंयोजनम् ॥ अश्विनौ बृहतीन्द्रः ॥ (अश्विनौ वा) ॥&lt;/summary&gt;&#xA;&lt;p&gt;कुष्ठःकोवा+++(षी)+++मश्वीना+++(ति)+++। तापानोदे+++(की)+++वामर्क्ताया+++(टी)+++होवा+++(का)+++हा+++(ख)+++इघ्नता+++(खि)+++वामा+++(ता)+++। अश्नाया+++(टि)+++होवा+++(का)+++हा+++(ख)+++इक्षपा+++(खि)+++माणाः+++(ता)+++। अंशूना+++(टि)+++होवा+++(का)+++हा+++(ख)+++इत्था+++(खा)+++मुवा+++(ता)+++दुवा+++(टा)+++न्यथा+++(खा)+++औहोवा+++(शि)+++। ऊ+++(ख)+++पा+++(श)+++ ॥ ३ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०४</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/3_bRhatipAThaH/8_R-10_sA-11/04/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/3_bRhatipAThaH/8_R-10_sA-11/04/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - प्रस्कण्वः काण्वः इन्द्रः बृहती&lt;/summary&gt;&#xA;&lt;p&gt;आयं॒वामा॒धूमक्तमः । सू॒तस्सो॒मोदीवि॑ष्टिषु । तामा॑श्विनापीबतन्तीरो॒अन्हं । धक्तं॑र॒त्ना॑नीदाशू॑षे ॥ ४ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - अश्विनोश्चैवसाम ॥ अश्विनौ बृहतीन्द्रः ॥ (अश्विनौ वा) ॥&lt;/summary&gt;&#xA;&lt;p&gt;अया+++(खा)+++मयंवाम्मधू+++(प्ली)+++माक्ता+++(ङा)+++माः+++(श)+++। सूतस्सोमो+++(टी)+++दिवि+++(का)+++ष्टिषु+++(टा)+++ओ+++(ट)+++हा+++(ख)+++ओहा+++(ता)+++। तामाश्विना+++(षी)+++पिबतन्तीरोअ+++(कू)+++न्ह्यामो+++(टा)+++हा+++(ख)+++ओहा+++(ता)+++। धर्तां+++(चा)+++रा+++(य)+++त्ना+++(ट)+++ओ+++(ट)+++हा+++(ख)+++ओहा+++(ता)+++। नीदाशू+++(टिट्)+++षा+++(ख)+++औहोवा+++(शि)+++। ऊ+++(ख)+++पा+++(श)+++ ॥ ४ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०५</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/3_bRhatipAThaH/8_R-10_sA-11/05/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/3_bRhatipAThaH/8_R-10_sA-11/05/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - मेधातिथि-मध्येआतिथी काण्वौ इन्द्रः बृहती&lt;/summary&gt;&#xA;&lt;p&gt;आत्वासो॓मा॑स्याग॒ल्दा॑या । सा॒दाया॓चन्नाहं॒ज्या । भू॒र्णिं॒मृग॒न्नासा॒वा॑नेषुचुक्रुधं । कै॓शा॑नन्नयाचिषात् ॥ ५ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - सोमसामच ॥ सोमो बृहतीन्द्रः ॥ (सोमो वा) ॥&lt;/summary&gt;&#xA;&lt;p&gt;आत्वासोमा+++(ती)+++। स्यागाद्दा+++(टिट्)+++या+++(ख)+++औहोवा+++(शि)+++। सदा+++(टा)+++याच+++(का)+++न्नाहञ्ज्या+++(कि)+++भूर्णा+++(टा)+++उवो+++(खा)+++वा+++(श)+++। मृग+++(का)+++न्नसवने+++(ची)+++षुचुक्रूधं+++(कीच्)+++कईशा+++(टि)+++ना+++(त)+++न्नाया+++(चा)+++चिषादिळा+++(टी)+++भा+++(खण्)+++। ओ+++(प)+++इळा+++(शा)+++ ॥ ५ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०६</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/3_bRhatipAThaH/8_R-10_sA-11/06/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/3_bRhatipAThaH/8_R-10_sA-11/06/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - देवातिथिः काण्वः इन्द्रः बृहती&lt;/summary&gt;&#xA;&lt;p&gt;अध्वर्यो॓आ॑द्रावा॒यात्वं॒ । सो॒मामिन्द्राः॑पिपासति । ऊ॓पो॑नूनं॒यूयूजे॑वृ॓षाणाहा॒रि । आचा॒जगा॒मा॑वृत्राहा॒ ॥ ६ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - आजामायवञ्च ॥ अजमायुर्वृहतीन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;आध्वर्योअद्रा+++(फु)+++वयातुवा+++(की)+++म्। सोमा+++(चा)+++मिन्द्राः+++(था)+++पीबा+++(का)+++सा+++(य)+++ती+++(ट)+++। ऊपोनू+++(चि)+++नं+++(क)+++युयुजे+++(किच्)+++वृषा+++(का)+++णा+++(य)+++हारी+++(टा)+++। आ+++(क)+++चाजा+++(टा)+++गा+++(त)+++। मावृ+++(चा)+++त्रा+++(क)+++हाऔ+++(टा)+++हो+++(ख)+++बा+++(प्ल)+++। हो+++(प्ल)+++इळा+++(शा)+++ ॥ ६ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०७</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/3_bRhatipAThaH/8_R-10_sA-11/07/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/3_bRhatipAThaH/8_R-10_sA-11/07/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - वसिष्ठो मैत्रावरुणिः इन्द्रः बृहती&lt;/summary&gt;&#xA;&lt;p&gt;आ॒भीषादस्ता॒दा॑भा॑रा । इ॒न्द्रज्यायःकानी॑यसः । पुरोवा॒सूहिमाघावन्बभू॒वी॑था । भारेभरेचाहा॒व्याः॑ ॥ ७ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - समुद्रस्यच प्रैयमेधस्य साम ॥ प्रियमेधा बृहतीन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;आभीषतस्तदा+++(तू)+++हा+++(त)+++बु+++(श)+++। भाराइन्द्राज्या+++(कु)+++यःकानीया+++(टि)+++साः+++(त)+++। पूरो+++(का)+++वसुर्हिमघव+++(कू)+++न्बभूवा+++(टि)+++इथा+++(ता)+++। भाराइभा+++(टी)+++रे+++(त)+++। चाहा+++(चा)+++व्याइळा+++(टि)+++भा+++(खण्)+++। ओ+++(प)+++इळा+++(शा)+++ ॥ ७ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०८</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/3_bRhatipAThaH/8_R-10_sA-11/08/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/3_bRhatipAThaH/8_R-10_sA-11/08/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - वसिष्ठो मैत्रावरुणिः इन्द्रः बृहती&lt;/summary&gt;&#xA;&lt;p&gt;यादिन्द्राया॓वा॑तस्त्वं । एता॓वा॑दाह॒मीशी॒या । स्तोतारामी॒द्दधिषेरदावसो । ना॓पा॑पात्वा॒यारंसिषः ॥ ८ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - वैरूपेच ॥ द्वयोरिन्द्रो बृहतीन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;यादिन्द्रा+++(पि)+++यावतस्त्वा+++(क)+++म्। एतावद+++(षी)+++हमीशीयास्तोता+++(टू)+++रामी+++(त)+++त्। दाधिषे+++(किच्)+++रा+++(क)+++दावा+++(टा)+++सा+++(त)+++बु+++(श)+++। नापापा+++(टि)+++त्वा+++(त)+++। यारौ+++(का)+++वाउवो+++(खि)+++बां+++(प्ल)+++साइषो+++(प्लि)+++। हाइ+++(शा)+++ ॥ ८ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - वैरूपेच ॥ द्वयोरिन्द्रो बृहतीन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;यादिन्द्रा+++(फि)+++यावता+++(खि)+++स्त्व+++(श)+++म्। आइता+++(टि)+++वादा+++(टा)+++हमी+++(का)+++शीया+++(था)+++ओवा+++(का)+++। स्तोता+++(टा)+++रामी+++(टा)+++त्दधिषे+++(चि)+++रदा+++(का)+++वासा+++(का)+++ओवा+++(का)+++। नापा+++(टा)+++पात्वा+++(टाच्)+++या+++(क)+++रो+++(प)+++बां+++(प्ल)+++साइषो+++(प्लि)+++। हाइ+++(शा)+++ ॥ ९ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०९</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/3_bRhatipAThaH/8_R-10_sA-11/09/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/3_bRhatipAThaH/8_R-10_sA-11/09/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - नृमेध आंगिरसः इन्द्रः बृहती&lt;/summary&gt;&#xA;&lt;p&gt;त्वा॓मि॑न्द्राप्रातू॑र्तिषु । आ॒भीविश्वा॑आसिस्पृर्धाः॑ । आशस्ती॓हाज॑नीता॓वृ॑त्रातूरा॑सी । त्व॒न्तू॑र्यतरूष्यातः ॥ ९ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - वैश्वदेवञ्च ॥ विश्वेदेवा बृहतीन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;त्वमिन्द्रो+++(ति)+++हाइप्रतूर्क्तिष्वो+++(तू)+++वा+++(त)+++। आभिविश्वा+++(कीच्)+++आसा+++(का)+++इस्पा+++(या)+++र्धाः+++(ट)+++। आशस्तिहा+++(षी)+++जनिता+++(किच्)+++वृत्रा+++(का)+++तू+++(य)+++रासा+++(टा)+++इ+++(श)+++। तूवा+++(चा)+++न्तू+++(य)+++र्या+++(ट)+++। तारू+++(चा)+++ष्या+++(क)+++ताऔ+++(टा)+++हो+++(ख)+++बा+++(प्ल)+++। हो+++(प्ल)+++इळा+++(शा)+++ ॥ १० ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
