    <item>
      <title>०१</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/3_bRhatipAThaH/3_R-10_sA-25/01/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/3_bRhatipAThaH/3_R-10_sA-25/01/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - भर्गः प्रागाथः इन्द्रः बृहती&lt;/summary&gt;&#xA;&lt;p&gt;श॒ग्धू३षूशा॑चीपते । इन्द्रावि॑श्वा॒भीरू॓तीभिः । भा॒गन्न॓हित्वा॑याशा॒सं॑वासूवी॒दम् । आनू॑शूराचा॒रा॑मसि ॥ १ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - हारायणानि त्रीणि ॥ त्रयाणामिन्द्रो बृहतीन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;शग्ध्यूषू+++(ति)+++। शाचाइपा+++(ची)+++ता+++(क)+++ई+++(ख)+++न्द्रा+++(श)+++। विश्वा+++(थाच्)+++भीरूतीभा+++(की)+++इर्भा+++(खा)+++ग+++(श)+++म्। नहित्वाया+++(ची)+++शासं+++(चा)+++वासू+++(का)+++वा+++(ख)+++इद+++(शा)+++म्। आनूशू+++(टिट्)+++रा+++(ख)+++औहोवा+++(शि)+++। चरा+++(टा)+++मसी+++(खा)+++ ॥ १ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - हारायणानि त्रीणि ॥ त्रयाणामिन्द्रो बृहतीन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;शग्ध्यूषौहो+++(फी)+++शचीपता+++(की)+++इ+++(श)+++। आइन्द्रंविश्वाभीरू+++(षू)+++तीभीर्भगान्ना+++(टू)+++ही+++(त)+++। त्वाया+++(चा)+++शासं+++(का)+++वासू+++(टा)+++हा+++(त)+++इवाइदा+++(टी)+++म्। आनूशूरचरा+++(षू)+++उवा+++(का)+++ओ+++(प)+++बा+++(प्ल)+++मासो+++(प्ला)+++। हाइ+++(शा)+++ ॥ २ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - हारायणानि त्रीणि ॥ त्रयाणामिन्द्रो बृहतीन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;शग्ध्यूषुशाची+++(फु)+++पता+++(खा)+++इशग्ध्युषू+++(शी)+++। शाचाइपाता+++(टु)+++इहिमा+++(खि)+++हा+++(ण)+++इ+++(श)+++। आइन्द्रंविश्वा+++(कुच)+++भीरू+++(का)+++तीभीरा+++(टि)+++इहिमा+++(खि)+++हा+++(ण)+++इ+++(श)+++। भागन्नही+++(षी)+++त्वायाशासं+++(कीच्)+++वासू+++(का)+++वीदामा+++(टि)+++इहिमा+++(खि)+++हा+++(ण)+++इ+++(श)+++। आनू+++(चा)+++शू+++(य)+++रा+++(ट)+++इहिमा+++(खि)+++हा+++(ण)+++इ+++(श)+++। चारामा+++(टि)+++सा+++(खण्)+++इ+++(श)+++। ओ+++(प)+++इळा+++(शा)+++ ॥ ३ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०२</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/3_bRhatipAThaH/3_R-10_sA-25/02/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/3_bRhatipAThaH/3_R-10_sA-25/02/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - रेभः कश्यपः इन्द्रः बृहती&lt;/summary&gt;&#xA;&lt;p&gt;या॓इ॑न्द्राभू॒जआ॒भा॑रा । स्व१र्वंआसू॑रेभ्यः । स्तोता॒रामिन्मा॑घवन्नस्यावा॑र्धया । ये॒चत्वे॑वृक्ता॒ब॑र्हीषः ॥ २ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - वाम्राणित्रीणि ॥ त्रयाणां वम्रो बृहतीन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;याया+++(ता)+++होइ+++(खा)+++न्द्रा+++(श)+++। भू+++(च)+++जाआ+++(का)+++भा+++(य)+++रा+++(ट)+++। सुवा+++(ता)+++हार्वंया+++(चि)+++सूरा+++(का)+++इभा+++(या)+++याः+++(ट)+++। स्तोता+++(टा)+++हा+++(तच्)+++रा+++(क)+++मिन्मघवन्नस्या+++(चू)+++वा+++(य)+++र्धाया+++(टा)+++। याइचा+++(टि)+++हा+++(त)+++इ+++(श)+++। त्वेवृ+++(चा)+++क्ताबर्हा+++(टि)+++इषाः+++(खाण)+++। ओ+++(प)+++इळा+++(शा)+++ ॥ ४ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - वाम्राणित्रीणि ॥ त्रयाणां वम्रो बृहतीन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;याइन्द्रभुजाआ+++(टू)+++भा+++(त)+++राः+++(त)+++। स्वर्वं+++(थाच्)+++आ+++(ट)+++सूरे+++(टा)+++भा+++(ख)+++या+++(श)+++हाहो+++(खा)+++हा+++(ण)+++इ+++(श)+++। स्तोता+++(थाच्)+++रामाइन्मा+++(ची)+++घव+++(का)+++न्नास्यवा+++(टि)+++र्धा+++(ख)+++या+++(श)+++हाहो+++(खा)+++हा+++(ण)+++इ+++(श)+++। ये+++(क)+++चत्वा+++(का)+++इवृ+++(ता)+++हाहो+++(खा)+++हा+++(ण)+++इ+++(श)+++। क्ताबर्हा+++(टि)+++इषाः+++(खाण्)+++। ओ+++(प)+++इळा+++(शा)+++ ॥ ५ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - वाम्राणित्रीणि ॥ त्रयाणां वम्रो बृहतीन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;याइन्द्रभुज+++(षु)+++आभरउहुवा+++(तू)+++हा+++(त)+++इ+++(श)+++। स्वर्वं+++(थाच्)+++आ+++(ट)+++सुरे+++(टा)+++भ्या+++(च)+++उहुवा+++(टि)+++हा+++(त)+++इ+++(श)+++। स्तो+++(क)+++तारमिन्मघव+++(षू)+++न्नस्यवा+++(यि)+++र्धाया+++(टाच्)+++उहुवा+++(टि)+++हा+++(त)+++इ+++(श)+++। ये+++(च)+++चत्वा+++(टा)+++इवृ+++(ताच्)+++उहुवा+++(टि)+++हा+++(त)+++इ+++(श)+++। क्ता+++(च)+++बर्हा+++(टा)+++इषाः+++(खाण्)+++। ओ+++(प)+++इळा+++(शा)+++ ॥ ६ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०३</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/3_bRhatipAThaH/3_R-10_sA-25/03/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/3_bRhatipAThaH/3_R-10_sA-25/03/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - जमदग्निभागर्वः मित्रावरुणादित्याः बृहती&lt;/summary&gt;&#xA;&lt;p&gt;प्रा॒मित्रा॒यप्रार्यम्णे॑ । सा॒चात्थ्या१मृतावसो । वरु॒त्थ्ये३॒वा॓रूणेछन्द्यंवा॒चाः॑ । स्तोत्रं॑रा॒ज॑सुगायता ॥ ३ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - वरुणसामानित्रीणि ॥ त्रयाणां वरुणो बृहती विश्वेदेवाः ॥&lt;/summary&gt;&#xA;&lt;p&gt;प्रमित्रायप्रा+++(तु)+++हा+++(त)+++बु+++(श)+++। आ+++(ट)+++र्यम्ना+++(चा)+++इसचा+++(टि)+++हो+++(कथ्)+++धियौ+++(टा)+++हुवार्ता+++(टि)+++वसा+++(चा)+++बु+++(श)+++। वरौ+++(टा)+++हो+++(कथ्)+++धीयौ+++(टा)+++हूवाइ+++(षि)+++वरूणेछान्दी+++(कु)+++यंवचाः+++(चि)+++। स्तोत्रां+++(टा)+++होइरा+++(टि)+++जौ+++(ट)+++हूवासू+++(कि)+++गायाता+++(टि)+++आउवा+++(टि)+++। ऊ+++(ख)+++पा+++(श)+++ ॥ ७ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - वरुणसामानित्रीणि ॥ त्रयाणां वरुणो बृहती विश्वेदेवाः ॥&lt;/summary&gt;&#xA;&lt;p&gt;प्रमित्रायप्रौहो+++(तू)+++वा+++(त)+++। अर्यम्णाबुहो+++(कुच्)+++औ+++(क)+++होवा+++(का)+++। साचाथ्यमृ+++(की)+++तावा+++(चा)+++साबुहो+++(किच्)+++औ+++(क)+++होवा+++(का)+++। वारूथ्येवरूणे+++(चू)+++छ+++(क)+++न्दीयंवा+++(कि)+++चाबुहो+++(किच्)+++औ+++(क)+++होवा+++(का)+++। स्तो+++(क)+++त्रंरा+++(का)+++जाबुहो+++(किच्)+++औहोवा। सू+++(क)+++गाया+++(का)+++ताबुहो+++(किच्)+++औ+++(क)+++होवाः+++(पाण्)+++। ओ+++(प)+++इळा+++(शा)+++ ॥ ८ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - वरुणसामानित्रीणि ॥ त्रयाणां वरुणो बृहती विश्वेदेवाः ॥&lt;/summary&gt;&#xA;&lt;p&gt;प्रमित्राय+++(षी)+++प्रार्यम्नो+++(ति)+++वाओ+++(ता)+++वा+++(त)+++। साचा+++(चा)+++थ्यमृ+++(चा)+++तावा+++(या)+++सा+++(ट)+++बु+++(श)+++। वा+++(ट)+++रू+++(त)+++था+++(ट)+++या+++(त)+++इवरूणे+++(कीच्)+++छ+++(क)+++न्दायां+++(टा)+++हा+++(त)+++इवचो+++(टि)+++आ+++(त)+++। स्तो+++(क)+++त्रंरा+++(का)+++जसुगा+++(चि)+++यतस्तो+++(टि)+++त्रा+++(त)+++म्। रा+++(क)+++ज+++(च)+++सू+++(क)+++गौ+++(ट)+++हो+++(त)+++ओ+++(प)+++बायातो+++(प्ल)+++। हाइ+++(शा)+++ ॥ ९ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०४</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/3_bRhatipAThaH/3_R-10_sA-25/04/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/3_bRhatipAThaH/3_R-10_sA-25/04/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - मेधातिथिः काण्वः (मध्येआतिथिः काण्वः) इन्द्रः बृहती&lt;/summary&gt;&#xA;&lt;p&gt;आ॒भी॓त्वा॑पूर्वापी॑तये । इ॒न्द्रास्तो॑मेभीरायावाः । समी॒चीना॓साऋभा॒वस्सा॒मा॒स्वरन् । रुद्रागृ॑णन्तापूर्व्यम् ॥ ४ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - वषट्कारनिधनञ्च साकमश्वम् ॥ प्रजापतिबृहतीन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;अभित्वापूर्व+++(षु)+++पीतयेआभी+++(फु)+++त्वापू+++(खा)+++र्वापीतया+++(प्ली)+++इ+++(श)+++। इन्द्रास्तोमै+++(थीच्)+++भिरा+++(का)+++यवो+++(चा)+++भीरा+++(का)+++या+++(य)+++वा+++(ट)+++ओमोवा+++(कि)+++। समीचीना+++(षी)+++साॠभावा+++(ची)+++समा+++(का)+++स्वरा+++(टा)+++न्सामा+++(चा)+++स्वा+++(य)+++रा+++(ट)+++नोमोवा+++(कि)+++। रुद्रा+++(चा)+++गृण+++(काच्)+++न्तापू+++(का)+++र्वाया+++(टाच्)+++न्तापू+++(चा)+++र्वा+++(य)+++या+++(ट)+++मोमो+++(का)+++वा+++(ख)+++औहोवा+++(शि)+++। ऊ+++(ख)+++पा+++(श)+++ ॥ १० ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०५</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/3_bRhatipAThaH/3_R-10_sA-25/05/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/3_bRhatipAThaH/3_R-10_sA-25/05/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - नृमेध पुरुमेधावांगिरसौ इन्द्रः बृहती&lt;/summary&gt;&#xA;&lt;p&gt;प्रा॒वाइ॒न्द्रा॑यबृहा॑ते । मारूतोब्र॒ह्मा॑र्च्चता । वृत्रंहा॒नातिवृत्रा॒हाशाता॒क्रा॑तुः॑ । व॒ज्ज्रे॑णाशाता॒पा॑र्वणा ॥ ५ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - बृहतश्चमारूतस्यसाम ॥ मारुतो बृहतीन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;प्रवइन्द्राय+++(षु)+++ब्रहतेप्रवाः+++(तु)+++। इन्द्रा+++(थाच्)+++याबृ+++(चा)+++हा+++(य)+++ते+++(ट)+++ओमोवा+++(कि)+++। मरूतोब्र+++(ची)+++ह्माआ+++(का)+++र्चा+++(य)+++ता+++(ट)+++ओमोवा+++(कि)+++। वृत्रंहाना+++(टी)+++तीवृत्र+++(चि)+++हा+++(ट)+++ओमोवा+++(कि)+++। शाताक्रातु+++(की)+++र्वा+++(ख)+++ज्रे+++(ण)+++। णशा+++(ता)+++हा+++(त)+++हा+++(त)+++। तपार्वणा+++(प्ली)+++। हो+++(प्ल)+++इळा+++(शा)+++ ॥ ११ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०६</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/3_bRhatipAThaH/3_R-10_sA-25/06/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
