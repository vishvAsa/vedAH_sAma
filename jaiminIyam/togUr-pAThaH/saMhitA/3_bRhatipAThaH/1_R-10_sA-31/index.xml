    <item>
      <title>०१</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/3_bRhatipAThaH/1_R-10_sA-31/01/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/3_bRhatipAThaH/1_R-10_sA-31/01/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - वसिष्ठो मैत्रावरुणिः इन्द्रः बृहती&lt;/summary&gt;&#xA;&lt;p&gt;आभित्वा॒शू॒र॑नोनुमः । आदू॓ग्धाइवाधेना॒वाः । ई॒शा॑ना॒मा॑स्याजग॑तःस्वदृशं । ईशा॑नमिन्द्रातस्थू॒षाः॑ ॥ १ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - इन्द्रस्यार्कौद्वौ ॥ द्वयोर्भरद्वाजो बृहतीन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;अभित्वाशू+++(ती)+++। रानोनू+++(टि)+++मा+++(त)+++ओनू+++(टा)+++माः+++(त)+++। आदुग्धा+++(कि)+++इवा+++(चा)+++धाइना+++(टि)+++वा+++(ख)+++ओइना+++(टि)+++वाः+++(त)+++। आइशा+++(किच्)+++नमस्यजगता+++(चू)+++स्सूवा+++(चा)+++द्रशा+++(का)+++मोदृ+++(टा)+++शा+++(त)+++म्। आइशा+++(कि)+++नमि+++(का)+++न्द्रातस्थू+++(चि)+++षाः+++(क)+++ओस्थू+++(टाट्)+++षा+++(ख)+++औहोवा+++(शि)+++। स्थुषा+++(ता)+++स्थूषाः+++(टाख्)+++ ॥ १ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - इन्द्रस्यार्कौद्वौ ॥ ईशानेन्द्रौ वा ॥&lt;/summary&gt;&#xA;&lt;p&gt;आभित्वाशू+++(खी)+++रानोनूमाः+++(प्ली)+++। आदुग्धा+++(चि)+++इवा+++(का)+++धा+++(ट)+++ईना+++(टा)+++वाः+++(त)+++। आइशा+++(कि)+++नमस्यजगता+++(चू)+++स्सुवा+++(टा)+++द्र+++(ख)+++शा+++(ण)+++म्। ई+++(क)+++शाना+++(टा)+++मी+++(त)+++द्राता+++(चा)+++स्थुषाइळा+++(टी)+++भा+++(खण्)+++। ओ+++(प)+++इळा+++(प्ला)+++ ॥ २ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०२</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/3_bRhatipAThaH/1_R-10_sA-31/02/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/3_bRhatipAThaH/1_R-10_sA-31/02/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - भरद्वाजः (शयुः) बार्हस्पत्यः इन्द्रः बृहती&lt;/summary&gt;&#xA;&lt;p&gt;त्वा॒मि॒द्धि॒हा॒वा॑महे॑ । सा॒तौवा॒ज॑स्याकारा॒वाः॑ । त्वांवृ॑त्रे॒ष्विन्द्रा॑सात्पातिन्ना॒राः॑ । त्वांकाष्ठास्व॑र्वातः ॥ २ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - भारद्वाजेद्वे ॥ द्वयोर्भरद्वाजो बृहतीन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;त्वामिद्धी+++(ति)+++। हवा+++(टा)+++माहा+++(चा)+++आ+++(च)+++औ+++(क)+++होवाहाउवा+++(शु)+++। ऊ+++(ख)+++पा+++(श)+++। सातौवा+++(चि)+++ज+++(क)+++स्याका+++(टा)+++रावा+++(टा)+++आ+++(च)+++औ+++(क)+++होवाहाउवा+++(शु)+++। ऊ+++(ख)+++पा+++(श)+++। त्वांव्रत्राइषू+++(टु)+++इ+++(थ)+++न्द्रा+++(ट)+++सा+++(ट)+++त्पाती+++(का)+++मा+++(च)+++औ+++(क)+++होवाहाउवा+++(शु)+++। ऊ+++(ख)+++पा+++(श)+++। णरस्त्वा+++(कि)+++ङ्का+++(कथ्)+++ष्ठासुवा+++(टि)+++र्वाता+++(का)+++आ+++(च)+++औ+++(क)+++होवाहाउवा+++(शु)+++। उऊ+++(खा)+++पा+++(श)+++ ॥ ३ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - भारद्वाजेद्वे ॥ द्वयोर्भरद्वाजो बृहतीन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;त्वामिद्धिहवाम+++(षू)+++हेसातौवाजो+++(तु)+++वा+++(त)+++। स्या+++(च)+++का+++(य)+++रावाः+++(टा)+++। त्वांव्रत्राइषू+++(षु)+++इन्द्रासात+++(की)+++त्पा+++(च)+++ती+++(य)+++न्नाराः+++(टा)+++। तूवाङ्का+++(टि)+++ष्ठा+++(त)+++। सूवर्वा+++(टि)+++ताः+++(खण)+++। ओ+++(प)+++इळा+++(प्ला)+++ ॥ ४ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०३</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/3_bRhatipAThaH/1_R-10_sA-31/03/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/3_bRhatipAThaH/1_R-10_sA-31/03/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - प्रस्कण्वः इन्द्रः बृहती&lt;/summary&gt;&#xA;&lt;p&gt;आभी॓प्रा॓वास्सूरा॒धा॑सम् । इन्द्रा॑मर्चाया॓था॑वीदे । योज॑रितृ॓भ्यो॑माघा॒वा॑पूरो॓वासूः॓ । सा॒हा॑स्रेणेवाशी॒क्षा॑ति ॥ ३ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - सन्नतेद्वे ॥ द्वयोः सन्नतिः बृहतीन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;अभिप्रवाः+++(ती)+++। सूराधा+++(टि)+++सा+++(त)+++म्। इन्द्रमर्चयाथा+++(यू)+++विदा+++(पा)+++इयोजा+++(खि)+++रितृ+++(ता)+++। भ्योमघवापूरो+++(यू)+++वासूः+++(टा)+++। साहस्रा+++(टिट्)+++इणा+++(खा)+++औहोवा+++(शि)+++। वाशीक्षा+++(टि)+++ती+++(ख)+++ ॥ ५ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - सन्नतेद्वे ॥ द्वयोः सन्नतिः बृहतीन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;आभाइप्रवा+++(टु)+++स्सुराधा+++(खि)+++स+++(ण)+++म्। इन्द्रमर्चाया+++(टुट्)+++था+++(ख)+++औहोवा+++(शि)+++। वी+++(ख)+++दे+++(श)+++। योजरितृभ्यो+++(कुच्)+++माघवा+++(टि)+++पुरो+++(ता)+++वासूः+++(टाख्)+++। सहा+++(ता)+++श्रे+++(क)+++णेवा+++(का)+++शाइक्षा+++(टिट्)+++ता+++(ख)+++औहोवा+++(शि)+++। सुभू+++(का)+++तये+++(टाख्)+++ ॥ ६ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - शैतन्त्रृतीयम् ॥ प्रजापतिर्वृहतीन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;अभिप्रवस्सुरा+++(फू)+++धसा+++(खा)+++औ+++(ण)+++हो+++(फ)+++वा+++(प्ल)+++। आइन्द्रामा+++(टी)+++र्चायाथा+++(चि)+++विदा+++(टा)+++ओ+++(ख)+++हा+++(ण)+++इ+++(श)+++। यो+++(च)+++जरी+++(का)+++तृभ्यो+++(चा)+++माघा+++(पा)+++वा+++(श)+++पुरो+++(टा)+++वा+++(ख)+++सूः+++(ण)+++। साहस्रे+++(फि)+++णा+++(त)+++इवा+++(पा)+++शा+++(श)+++हिम्माइक्षा+++(टीट्)+++ता+++(ख)+++औहोवा+++(शि)+++। वा+++(ख)+++सू+++(श)+++ ॥ ७ ॥&lt;/p&gt;&#xA;&lt;/details&gt;</description>
    </item>
    <item>
      <title>०४</title>
      <link>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/3_bRhatipAThaH/1_R-10_sA-31/04/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>https://vishvAsa.github.io/vedAH_sAma/jaiminIyam/togUr-pAThaH/saMhitA/3_bRhatipAThaH/1_R-10_sA-31/04/</guid>
      <description>&lt;details open&gt;&lt;summary&gt;ऋक् - नोधा गौतमः इन्द्रः बृहती&lt;/summary&gt;&#xA;&lt;p&gt;तंवो॑दस्मा॓मृ॑तीषाहम् । वा॒सो॑र्मन्दानमन्धा॑सा । आ॒भी॒वत्स॒न्नस्वा॒सारेषुधेना॒वाः॑ । इ॓न्द्रं॑गीर्भि॑र्ना॑वामहे ॥ ४ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - नाविकञ्च ॥ प्रजापतिबृहतीन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;तंवएदास्मा+++(तु)+++म्। ऋती+++(का)+++षाहां+++(चा)+++होवा+++(का)+++ओऔ+++(का)+++हो+++(त)+++इहा+++(ता)+++। वासोर्मन्दा+++(कीच्)+++नमन्धसा+++(की)+++ओऔ+++(का)+++हो+++(त)+++इहा+++(ता)+++। आभीवत्स+++(की)+++न्नस्वासरे+++(टी)+++षुधे+++(चा)+++नवा+++(टा)+++ओऔ+++(का)+++हो+++(त)+++इहा+++(ता)+++। । इन्द्रं+++(का)+++ओऔ+++(का)+++हो+++(त)+++इहा+++(ता)+++। गीर्भाइर्न्ना+++(खी)+++औहोवा+++(शि)+++। वामा+++(टा)+++हे+++(ख)+++ ॥ ८ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - प्रजापतेश्चाभीवर्तः ॥ प्रजापतिबृहतीन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;तंवो+++(णा)+++दा+++(फ)+++स्मा+++(ख)+++मृतीषा+++(प्लि)+++होवा+++(ङा)+++। वासोर्मन्दा+++(कीच्)+++नामा+++(क्य)+++न्धा+++(य)+++सा+++(ट)+++आभीवत्सा+++(की)+++ओ+++(प)+++नास्वा+++(फ)+++सरे+++(फाप्ल्)+++षूधा+++(चा)+++इना+++(या)+++वाः+++(ट)+++। इन्द्रा+++(का)+++ङ्गा+++(य)+++इर्भि+++(टा)+++र्न्नवा+++(ता)+++मा+++(खणफप्ल्)+++। हा+++(ख)+++इ+++(श)+++ ॥ ९ ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - भागञ्च ॥ भगो बृहतीन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;तंवोदस्ममृती+++(फू)+++षहाउवो+++(खी)+++वा+++(श)+++। वासोर्मन्दा+++(की)+++नम+++(चा)+++न्धासा+++(का)+++आभीवत्सन्नस्व+++(षू)+++सराइषूधा+++(यु)+++इना+++(प)+++वाः+++(श)+++। ओवाइ+++(कि)+++न्द्रङ्गा+++(टा)+++इर्भी+++(ताच्)+++न्नवा+++(ता)+++मा+++(प)+++हा+++(त्र)+++इ+++(श)+++। भगा+++(ता)+++या+++(टख्)+++ ॥ १० ॥&lt;/p&gt;&#xA;&lt;/details&gt;&#xA;&lt;details open&gt;&lt;summary&gt;साम - इन्द्रस्याभीवर्तः ॥ इन्द्रो बृहतीन्द्रः ॥&lt;/summary&gt;&#xA;&lt;p&gt;तंवोदस्मामृती+++(फू)+++षहां+++(ता)+++वा+++(प)+++सोर्मन्दानम+++(प्लु)+++न्धा+++(ङ)+++सा+++(श)+++। आभीवत्स+++(षी)+++न्नास्वासारे+++(कीच्)+++षूधा+++(का)+++इना+++(पा)+++वाः+++(श)+++। इन्द्रङ्गीर्भा+++(यी)+++इर्न्ना+++(पा)+++वा+++(श)+++। हिं+++(ट)+++हिं+++(त)+++हिं+++(ट)+++हिं+++(ख)+++। नवानवो+++(प्ली)+++वा+++(प्ल)+++मामो+++(प्ला)+++। हाइ+++(शा)+++ ॥ ११ ॥&lt;/p&gt;</description>
    </item>
